<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
    {% include 'order_email_headers' %}
    <title>
        Order #{{ order.order_id }}
    </title>
</head>

<body>
<table id="background">
    <tr>
        <td>
            <table id="main">
                <tr>
                    <td width="300">
                        <div style="
                                width: {% if settings.logo_width != empty %}{{ settings.logo_width }}{% else %}auto{% endif %};
                                height: auto;
                                display:block;
                                float: left;">
                                {% if settings.confirmation_emails_logo %}
                                  <img src="{{ 'email_logo_custom_bg_image.png' | asset_url }}" style="max-height: {{ settings.header_height }};">
                                {% elsif settings.show_logo %}
                                  <img src="{{ 'logo_custom_bg_image.jpg' | asset_url }}" style="max-height: {{ settings.header_height }};">
                                {% endif %}
                        </div>
                    </td>
                    <td width="300" class="service">
                        {% if shop.primary_phone %}
                            Questions? {{ shop.primary_phone | number_to_phone }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <h1 class="email-title">
                            Thank you for your order!
                        </h1>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="welcome-message">
                        <h3>
                            Hi, {{ user_name }}!
                        </h3>
                        <p>
                            Your order from {{ shop.name }} has been shipped, click <a href="{{ login_url }}">here</a>
                            to login and review your order.
                        </p>
                    </td>
                </tr>
            </table>
            <table id="order-information">
                <tr class="section-header">
                    <td bgcolor="{{ settings.order_confirm_heading_bars_color }}" colspan="2">
                        <p>
                            Shipping Information
                        </p>
                    </td>
                </tr>
                <tr>
                    <td colspan="1">
                        <p>
                            <strong>Order Number:</strong> {{ order.order_id }}
                        </p>
                        <p>
                            <strong>Ship Date:</strong> {{ shipment.ship_date | date: "%a, %b %d, %Y" }}
                        </p>

                        <p>
                            <strong>Order Status:</strong> {{ order.status }}
                        </p>
                    </td>
                    <td colspan="1" style="vertical-align:middle;">
                        <p>
                            <strong>Ordered By:</strong>
                            {{ order.best_customer_name }}
                        </p>
                        <p>
                            <strong>Shipping method:</strong> {{ shipment.shipment_friendly_name }}
                        </p>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        {% if shipment.tracking_number and shipment.tracking_number != empty %}
                            <p>
                                <strong>Tracking number:</strong> {{ shipment | tracking_link }}
                            </p>
                        {% endif %}

                        {% if shipment.note and shipment.note != empty %}
                            <p>
                                <strong>Shipping Notes:</strong> {{ shipment.note }}
                            </p>
                        {% endif %}
                    </td>
                </tr>
            </table>

            <br>

            <table id="order-summary">
                <tr class="section-header">
                    <td bgcolor="{{ settings.order_confirm_heading_bars_color }}" width=120>
                        <p style="margin: 3px 0px;">
                            Image
                        </p>
                    </td>
                    <td bgcolor="{{ settings.order_confirm_heading_bars_color }}" width=380>
                        <p style="margin: 3px 0px;">
                            Details
                        </p>
                    </td>
                    <td bgcolor="{{ settings.order_confirm_heading_bars_color }}" width=100>
                        <p style="margin: 3px 0px;">
                            Qty
                        </p>
                    </td>
                </tr>
                {% for line_item in shipment.line_items %}
                    <tr class="line-item">
                        <td>
                            <table class="basic-info">
                                <tbody>
                                <tr>
                                    <td class="image-cell">
                                        <img width=100 alt="{{ line_item.name }} image"
                                             src="{% if line_item.image %}{{ line_item.image.small_url }}{% else %}{{ 'no-image.jpg' | asset_url }}{% endif %}"/>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </td>

                        <td class="product-info">
                            <p class="sub-option product-title">
                                {{ line_item.name }}
                            </p>

                            {% if settings.show_sku %}
                                <p class="sub-option">
                                    <span class="sub-option-name">SKU#</span> <span
                                            class="sub-option-value">{{ line_item.final_sku }}</span>
                                </p>
                            {% endif %}

                            {% for choice in line_item.choices %}
                                {% if choice.sub_option %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">{{ choice.option.friendly_name }}{% if choice.has_group? %} ({{ choice.group.name }}) {% endif %}:</span>
                                        <span class="sub-option-value">{% include 'modifier', title: choice.sub_option.name, amount: choice.amount %}</span>
                                    </p>
                                {% endif %}
                            {% endfor %}

                            {% if line_item.logos.size > 0 %}
                                <div class="sub-options">
                                    {% for logo in line_item.logos %}
                                        <p class="sub-option logo">
                                            <span class="sub-option-name logo-location">{{ logo.location_name | default: "logo" }}:</span>
                                            <span class="sub-option-name logo-name">{{ logo.name }}{% if logo.charge %} ({{ logo.charge | points_or_currency }}){% endif %}</span>
                                        </p>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if line_item.has_setup_charge? %}
                                <p class="sub-option">
                                    Setup Charge: {{ line_item.setup_charge | points_or_currency }}
                                </p>
                            {% endif %}

                            {% for personalization in line_item.product_personalizations %}
                                <div class="product-personalization">
                                    <p class="title" style="font-weight: bold;">
                                        {% include 'modifier', title: personalization.title, amount: personalization.amount %}
                                    </p>
                                    {% for attribute in personalization.attributes %}
                                        <p class="row">
                                            <label>{{ attribute.key }}:</label>
                                            {% if attribute.value != empty %}
                                                <span class="attribute-value">{{ attribute.value | join: ', ' }}</span>
                                            {% else %}
                                                <span class="attribute-value not-specified">&lt;not specified&gt;</span>
                                            {% endif %}
                                        </p>
                                    {% endfor %}
                                </div>
                            {% endfor %}

                            {% if line_item.gift_certificate? %}
                                {% assign cert_details = line_item.gift_certificate_details %}
                                {% assign first_name = cert_details.first_name %}
                                {% assign last_name = cert_details.last_name %}
                                {% assign email = cert_details.email %}
                                {% assign message = cert_details.message %}
                                {% assign code = line_item.gift_certificate_code %}

                                <p class="sub-option mt-10">
                                    <strong>Recipient Information</strong>
                                </p>

                                {% if first_name != blank %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">First name:</span>
                                        <span class="sub-option-value">{{ first_name }}</span>
                                    </p>
                                {% endif %}

                                {% if last_name != blank %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">Last name:</span>
                                        <span class="sub-option-value">{{ last_name }}</span>
                                    </p>
                                {% endif %}

                                {% if email != blank %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">Email:</span>
                                        <span class="sub-option-value">
                      <a href="mailto:{{ email }}">{{ email }}</a>
                    </span>
                                    </p>
                                {% endif %}

                                {% if message != blank %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">Message:</span>
                                        <span class="sub-option-value">{{ message }}</span>
                                    </p>
                                {% endif %}

                                {% if code != blank %}
                                    <p class="sub-option">
                                        <span class="sub-option-name">Code:</span>
                                        <span class="sub-option-value">{{ code }}</span>
                                    </p>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="order-quantity">
                            <p class="line-item-quantity">
                                {{ line_item.quantity }}
                            </p>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </td>
    </tr>
</table>
</body>
</html>
