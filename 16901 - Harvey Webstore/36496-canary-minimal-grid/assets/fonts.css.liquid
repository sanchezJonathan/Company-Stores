{% if settings.sitewide_font_family and settings.sitewide_font_family != "native" %}
  body {
    font-family: {{ settings.sitewide_font_family }};
  }
{% endif %}

{% if settings.sitewide_header_font_family %}
  h1, h2, h3, h4 {
    font-family: {{ settings.sitewide_header_font_family }};
  }
{% endif %}

{% if settings.sitewide_font_size %}
  html {
    font-size: {{ settings.sitewide_font_size }};
  }
{% endif %}
