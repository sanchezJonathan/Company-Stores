/*-------------------*/
/* PRODUCT THUMBS */
/*-------------------*/
/* Product lists are CSS grids: 3 per row on desktop, 2 on tablet, 1 on phone (see media queries).
   The header search dropdown is excluded from display here because header.liquid shows/hides it inline. */
.product-list:not(.search-results), .related-products-thumbnails, .recently-viewed-products-thumbnails {
  display: grid !important;
}
.product-list, .related-products-thumbnails, .recently-viewed-products-thumbnails {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 48px 20px;
  margin: 0 !important;
}
/* Tile: rounded image box filled edge to edge, details underneath on the page background. */
.product-thumbnail {
  position: relative;
  width: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 0;
  background-color: transparent !important;
}
.product-thumbnail .thumbnail-img-container {
  aspect-ratio: 7 / 8;
  min-height: 0 !important;
  padding: 0;
  border-radius: 8px;
  overflow: hidden;
  background-color: #E5E4E2;
}
.product-thumbnail .thumbnail-img-container a {
  display: block;
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0 !important;
}
.product-thumbnail .thumbnail-img-container img {
  display: block;
  width: 100%;
  height: 100% !important;
  max-height: none !important;
  /* Whole image always visible: whichever side reaches the box edge first fills it, the other scales proportionally. */
  object-fit: contain;
  object-position: center;
  transition: opacity 0.3s ease;
}
.product-thumbnail .thumbnail-img-container img.hover-img {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}
.product-thumbnail.multiple-images:hover .thumbnail-img-container img.primary-img {
  opacity: 0;
}
.product-thumbnail.multiple-images:hover .thumbnail-img-container img.hover-img {
  opacity: 1;
}
/* Details: name followed by the price in grey on one line; vendor (if shown) drops to its own line. */
.thumbnail-description-container {
  border-top: none;
  padding: 12px 0 0 !important;
}
.thumbnail-description-container a {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: baseline;
  column-gap: 8px;
}
.product-thumbnail .thumbnail-description-container a h5, .product-thumbnail .thumbnail-description-container a p {
  font-size: 20px;
  font-weight: normal !important;
  margin: 0;
}
.product-thumbnail .thumbnail-description-container a p {
  color: #6F6C66;
}
.product-thumbnail .thumbnail-description-container a h6 {
  order: 3;
  flex-basis: 100%;
  margin: 4px 0 0;
}
.available-sizes-container {
  opacity: 0.5;
  display: none;
}
.product-thumbnail.has-sizes:hover .product-name {
  display: none;
}
.product-thumbnail.has-sizes:hover .available-sizes-container {
  display: block;
}

body.search-open .header-container {
  position: sticky;
  top: 0;
  z-index: 10000;
  background: #fff;
}
body.search-open .custom-searchbox-container {
  position: sticky;
}
.search-results.product-list {
  background-color: #FFF;
  position: fixed;
  left: 0;
