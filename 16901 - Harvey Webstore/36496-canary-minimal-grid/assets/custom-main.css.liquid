}
.category-title-nav a:hover, .category-title-nav a.active {
  color: #0F0E0D;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 0.12em;
}
.category-title-item::after, .category-title-nav ul.level-0 > li:not(:last-child)::after {
  content: ", ";
}
