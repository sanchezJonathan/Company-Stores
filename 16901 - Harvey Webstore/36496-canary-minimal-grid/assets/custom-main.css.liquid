/*-------------------*/
/* HOMEPAGE FEATURED PRODUCTS GRID */
/*-------------------*/
/* 6-column grid: the first 2 tiles span 3 columns (2 per row), every tile after spans 2 (3 per row).
   Tile styling comes from PRODUCT THUMBS; the wide first-row images use the mockup's near-square ratio. */
.product-list.featured-products-grid {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}
.featured-products-grid .product-thumbnail {
  grid-column: span 2;
}
.featured-products-grid .product-thumbnail:nth-child(-n+2) {
  grid-column: span 3;
}
.featured-products-grid .product-thumbnail:nth-child(-n+2) .thumbnail-img-container {
  aspect-ratio: 574 / 547;
}
@media screen and (max-width: 991.99px){
  .featured-products-grid .product-thumbnail,
  .featured-products-grid .product-thumbnail:nth-child(-n+2) {
    grid-column: span 3;
  }
  .featured-products-grid .product-thumbnail:nth-child(-n+2) .thumbnail-img-container {
    aspect-ratio: 7 / 8;
  }
}
@media screen and (max-width: 660px){
  .featured-products-grid .product-thumbnail,
  .featured-products-grid .product-thumbnail:nth-child(-n+2) {
    grid-column: 1 / -1;
  }
}

/*-------------------*/
/* SITE WIDTH */
/*-------------------*/
.footer-container .wrapper {
  box-sizing: content-box; /* 1rem side padding outside the max-width, matching the header */
  max-width: {{ settings.site_width }};
  padding: 0 40px;
}
.content-container, .homepage-categories-outer-container {
  box-sizing: content-box;
  max-width: {{ settings.site_width }};
  margin-left: auto !important;
  margin-right: auto !important;
  padding: 0 40px;
}
/* Full-width search dropdown: background spans the screen, results stay within site_width. */
.search-results.product-list {
  padding-left: max(20px, calc((100% - {{ settings.site_width }}) / 2)) !important;
  padding-right: max(20px, calc((100% - {{ settings.site_width }}) / 2)) !important;
}

/*-------------------*/
/* ANIMATIONS */
/*-------------------*/
/* Subtle motion modelled on harvey.ai: same easing curves, short durations, hover-driven.
   Everything here is switched off for visitors with "reduce motion" enabled (bottom of this section). */
:root {
  --ease-out: cubic-bezier(0, .7, .3, 1);     /* harvey.ai --ease-out: things arriving */
  --ease-in-out: cubic-bezier(.7, 0, .3, 1);  /* harvey.ai --ease-in-out: things changing state */
}

/* Image zoom on hover (102% over 500ms) inside the rounded boxes; product tiles keep their hover-image fade. */
.product-thumbnail .thumbnail-img-container img,
.category-box-img img,
.product-page-main .images-wrapper ul li .small-thumb {
  transition: opacity .3s var(--ease-in-out), transform .5s var(--ease-out);
}
.product-thumbnail:hover .thumbnail-img-container img,
.category-box:hover .category-box-img img,
.product-page-main .images-wrapper ul li:hover .small-thumb {
  transform: scale(1.02);
}

/* Homepage featured categories: hovering one card fades the others to 40%. */
.homepage-categories-container .category-box {
  transition: opacity .4s var(--ease-in-out);
}
.homepage-categories-container:has(.category-box:hover) .category-box:not(:hover) {
  opacity: .4;
}

/* Header dropdowns (Shop, Account) fade and drop in instead of popping open.
   Uses the separate translate property so it doesn't fight Bootstrap/Popper's inline transform. */
@keyframes dropdown-in {
  from { opacity: 0; translate: 0 -6px; }
  to { opacity: 1; translate: 0 0; }
}
.site-header-nav .dropdown-menu.show {
  animation: dropdown-in .2s var(--ease-out);
}
.site-header-nav .shop-link.dropdown-toggle::after {
  transition: transform .2s var(--ease-in-out);
}

/* Underline that grows left to right (header links, category title line) instead of appearing instantly. */
.site-header-nav .header-center-links .nav-link,
.category-title-nav a {
  text-decoration: none !important;
  background-image: linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-position: 0 100%;
  background-size: 0% 1px;
  transition: background-size .3s var(--ease-out), color .3s var(--ease-in-out);
}
.site-header-nav .header-center-links .nav-link {
  background-origin: content-box; /* underline spans the text, not the link padding */
}
.category-title-nav a {
  background-position: 0 92%;
  background-size: 0% 2px;
}
.site-header-nav .header-center-links .nav-link:hover,
.site-header-nav .header-center-links .nav-link.active {
  background-size: 100% 1px;
}
.category-title-nav a:hover,
.category-title-nav a.active {
  background-size: 100% 2px;
}

/* Product tiles fade up as they scroll into view, 90ms apart (classes added by header.js.liquid). */
.reveal {
  opacity: 0;
  translate: 0 16px;
  transition: opacity .5s var(--ease-out), translate .5s var(--ease-out);
}
.reveal.is-visible {
  opacity: 1;
  translate: 0 0;
}
.homepage-categories-container .category-box.reveal {
  transition: opacity .5s var(--ease-out), translate .5s var(--ease-out); /* also drives the hover fade above */
}

@media (prefers-reduced-motion: reduce) {
  .product-thumbnail .thumbnail-img-container img,
  .category-box-img img,
  .product-page-main .images-wrapper ul li .small-thumb,
  .homepage-categories-container .category-box,
  .site-header-nav .header-center-links .nav-link,
  .category-title-nav a,
  .reveal {
    transition: none;
  }
  .site-header-nav .dropdown-menu.show {
    animation: none;
  }
  .product-thumbnail:hover .thumbnail-img-container img,
  .category-box:hover .category-box-img img,
  .product-page-main .images-wrapper ul li:hover .small-thumb {
    transform: none;
  }
  .reveal {
    opacity: 1;
    translate: 0 0;
  }
}
