}
/* Category page title nav (snippets/category_title_nav.liquid): "Shop All, Apparel, …" in large serif,
   grey links, active one black + underlined, black commas between. */
.category-title-nav, .category-title-nav * {
  font-family: 'Harvey Serif', serif; /* overrides the sitewide * { sans } rule */
}
.category-title-nav {
  margin: 64px 0 56px;
