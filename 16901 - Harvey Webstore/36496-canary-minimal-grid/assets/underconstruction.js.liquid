(function () {
  "use strict";
  var setCookie = function (name, value, options) {
    options = options || {};
    var expires = options.expires;
    if (typeof expires == "number" && expires) {
      var d = new Date();
      d.setTime(d.getTime() + expires * 1000 * 60 * 60);
      expires = options.expires = d;
    }
    if (expires && expires.toUTCString) {
      options.expires = expires.toUTCString();
    }
    value = encodeURIComponent(value);
    var updatedCookie = name + "=" + value;
    for (var propName in options) {
      updatedCookie += "; " + propName;
      var propValue = options[propName];
      if (propValue !== true) {
        updatedCookie += "=" + propValue;
      }
    }
    document.cookie = updatedCookie;
  };

  function getCookie(name) {
    var matches = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, "\\$1") + "=([^;]*)"));
    return matches ? decodeURIComponent(matches[1]) : undefined;
  }

  var html = function () {
    return document.getElementById("splash").innerHTML;
  };

  var bindSubmit = function (cookieKey) {
    // Set cookie on click
    $('#group-login-form-submit').click(function() {
      if ($('#password').val() == '{{ settings.under_construction_password }}') {
        setCookie(cookieKey, "true", {
          expires: 1,
          path: '/',
        });
        location.reload();
      } else {
        $('#login-error-msg').fadeIn('slow', function() {
          $(this).delay(3000).fadeOut("slow");
        });
        $('#password').val('').focus();
      } 
    });
  };

  // Entry point
  document.addEventListener("DOMContentLoaded", function () {
    var cookieKey = "cookie_ucpage";
    bindSubmit(cookieKey);
    if (getCookie(cookieKey)) {
      $('#splash').hide();
      return;
    }

    // Insert html and bind submit
    $('#homecontent').remove();
    $('#splash').show();
  }, false);

  $(document).on('keypress',function(e) {
    if(e.which == 13) {
      $('#group-login-form-submit').trigger('click');
    }
  });
})();