@font-face {
    font-family: 'HarveySans Diatype Variable';
    src: url('{{ "fonts/HarveySansDiatypeVariable-Regular.woff2" | asset_url }}') format('woff2'),
        url('{{ "fonts/HarveySansDiatypeVariable-Regular.woff" | asset_url }}') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Harvey Serif';
    src: url('{{ "fonts/HarveySerif-Regular.woff2" | asset_url }}') format('woff2'),
        url('{{ "fonts/HarveySerif-Regular.woff" | asset_url }}') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

