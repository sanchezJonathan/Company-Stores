{% if settings.nav_links_position == "bottom_bar" or settings.category_links_position == "bottom_bar" %}
if ($(".category-container ul.header-links li").length < 1) {
  $(".category-container").remove();
}

{% if settings.current_theme == "stylistic" %}
    var ccLinksOffset = [];
    $(".category-container ul.navbar-nav > li > a").each(function() {
      if (!ccLinksOffset.includes($(this).offset().top)) {
        ccLinksOffset.push($(this).offset().top);
      }
    });

    ccLinksOffset.pop();
    $(".category-container ul.navbar-nav > li > a").each(function() {
      var isNotInLastRow = ccLinksOffset.includes($(this).offset().top) || ccLinksOffset.includes($(this).offset().top - 1);
      if (isNotInLastRow) {
        $(this).css("border-bottom", "1px solid #dee2e6");
      }
    });
  {% endif %}
{% endif %}

// fade product and category tiles up as they scroll into view, 90ms apart within each batch (styles: ANIMATIONS in custom-main.css)
// skips the hidden search product pool and the search dropdown, which copies tiles from that pool
$(function() {
  if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  var revealObserver = new IntersectionObserver(function(entries) {
    entries.filter(function(entry) { return entry.isIntersecting; }).forEach(function(entry, index) {
      entry.target.style.transitionDelay = (index * 90) + "ms";
      entry.target.addEventListener("transitionend", function() { this.style.transitionDelay = ""; }, { once: true });
      entry.target.classList.add("is-visible");
      revealObserver.unobserve(entry.target);
    });
  }, { rootMargin: "0px 0px -40px 0px" });

  function watchTiles(root) {
    $(root).find(".product-thumbnail, .category-box").addBack(".product-thumbnail, .category-box")
      .not("#search-product-pool *, .search-results *, .reveal")
      .each(function() {
        this.classList.add("reveal");
        revealObserver.observe(this);
      });
  }

  watchTiles(document.body);

  // tiles added later (e.g. Recently Viewed, loaded by AJAX)
  new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      mutation.addedNodes.forEach(function(node) {
        if (node.nodeType === 1) watchTiles(node);
      });
    });
  }).observe(document.body, { childList: true, subtree: true });
});
