<div class="product-page-right recently-viewed-products" style="display: none">
  <h2 class="section-label">
    Recently Viewed
  </h2>
  <div class="recently-viewed-products-thumbnails">
    <script>
      $(function () {
        function load_recently_viewed_products(container) {
          $.ajax({
            url: '/recently_viewed_products',
            cache: false,
            dataType: 'html',
            success: function (response, status) {
              var jContainer = $(container);
              if (status == "success" && jContainer.length > 0) {
                jContainer.append(response);
                jContainer.show();

                setup_carousels(jContainer.find('.product .image-carousel'));
                bind_product_body_clicker(jContainer, '.product');
                $('.product-page-right.recently-viewed-products').show();
              }
            }
          });
        }
        load_recently_viewed_products('.recently-viewed-products-thumbnails');
      });
    </script>
  </div>
</div>
