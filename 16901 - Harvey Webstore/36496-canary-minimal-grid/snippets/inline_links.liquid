<ul class="navbar-nav header-links header-center-links pages {% if settings.category_links_position == "inline_with_logo" %}categories{% endif %} d-none d-lg-flex">
  <li class="nav-item dropdown shop-dropdown">
    <a class="nav-link dropdown-toggle shop-link" href="/products" data-bs-toggle="dropdown" role="button" aria-expanded="false">Shop</a>
    <ul class="dropdown-menu shop-dropdown-menu">
      <li class="shop-all-item"><a class="dropdown-item" href="/products">Shop All</a></li>
    </ul>
  </li>
</ul>

<div class="header-icons d-none d-lg-flex">
  {% if shop.catalog_enabled? %}
    <button class="btn" type="button" id="custom-search-btn">Search</button>
  {% endif %}
  {% if shop.primary_phone != blank and settings.show_phone %}<a href="tel:{{ shop.primary_phone }}">{% include 'icons/phone' %}</a>{% endif %}

  {% if authentication_enabled %}
    {% if current_user or shop.show_login? or shop.show_registration? %}
      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" id="inline-link-profile" data-bs-toggle="dropdown" aria-expanded="false">
          Account
        </button>

        <div class="dropdown-menu dropdown-menu-lg-end" aria-labelledby="inline-link-profile">
          {% if current_user %}
            <a class="dropdown-item" href="{{ account_dashboard_url }}">Dashboard</a>
            {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ order_history_url }}">Order History</a>{% endif %}
            <a class="dropdown-item" href="{{ edit_account_url }}">Account Settings</a>
            {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ address_book_url }}">Address Book</a>{% endif %}
            {% if shop.store_enabled? and shop.show_account_balance? %}<a class="dropdown-item" href="{{ account_balance_url }}">{% if shop.points_store? %}Points{% else %}Account{% endif %} Balance: <span>{{ current_user.balance | points_or_currency }}</span></a>{% endif %}
            {% if shop.catalog_enabled? %}{% if shop.custom_logos_upload_enabled? or current_user.logos.size != 0  %}<a class="dropdown-item" href="{{ logos_url }}">Logo</a>{% endif %}{% endif %}
            {% if shop.budget_enabled? and current_user.has_budgets? %}<a class="dropdown-item" href="{{ budget_info_url }}">Budget</a>{% endif %}
            {% if shop.wishlist_enabled? %}<a class="dropdown-item" href="{{ wishlist_url }}">Wishlist</a>{% endif %}
            <a class="dropdown-item mt-2 border-top" href="{{ logout_url }}">Log Out</a>
          {% else %}
            {% if shop.show_login? %}<a class="dropdown-item" href="{{ login_url }}">Log In</a>{% endif %}
            {% if shop.show_registration? %}<a class="dropdown-item" href="{{ signup_url }}">Register</a>{% endif %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endif %}

  {% if shop.store_enabled? %}<a class="view-hide-cart" href="{{ cart_url }}">Cart ({{ order.cart_items_count | pluralize: 'item', 'items' }})</a>{% endif %}
</div>
