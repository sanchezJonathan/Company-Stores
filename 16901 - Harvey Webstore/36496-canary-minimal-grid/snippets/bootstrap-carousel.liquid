{% assign carousel_count = 0 %}
{% assign captionposition = "flex-column" %}
{% if settings.caption_position != "center" %}
  {% assign captionposition = settings.caption_position | append: "-align-captions" %}
{% endif %}
<div class="homepage-carousel-container mx-auto">
  <div id="homepage-carousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      {% if settings.show_carousel_item_1 %}
        <div class="carousel-item car-item-1">
          <a class="d-block w-100" href="{{ settings.carousel_item_1_link }}">
            <img src="{{ 'carousel-item-01.jpg' | asset_url }}" class="d-block w-100" alt="{{ settings.carousel_item_1_alt }}" title="{{ settings.carousel_item_1_alt }}">
            {% if settings.show_carousel_item_mobile_img_1 %}
              <script>
                var imgSrcMobile = "{{ 'mobile-carousel-item-01.jpg' | asset_url }}";
                if (imgSrcMobile !=  "") {
                  var siteWidth = window.matchMedia("(max-width: 768px)");
                  myFunction(siteWidth);
                  siteWidth.addListener(myFunction);

                  function myFunction(siteWidth) {
                    if (siteWidth.matches) { // If media query matches
                      var imgSrc = "{{ 'mobile-carousel-item-01.jpg' | asset_url }}";
                      $(".carousel-item.car-item-1 img").attr("src", imgSrc);
                    }
                    else {
                      var imgSrc = "{{ 'carousel-item-01.jpg' | asset_url }}";
                      $(".carousel-item.car-item-1 img").attr("src", imgSrc);
                    }
                  }
                }
              </script>
            {% endif %}
          </a>
          {% if settings.show_carousel_item_caption_1 %}
            <div class="carousel-caption d-flex align-items-center justify-content-center {{ captionposition }}">
              {% if settings.carousel_item_1_title != blank %}<div class="carousel-caption-header" style="color: {{ settings.carousel_item_1_title_color }}">{{ settings.carousel_item_1_title }}</div>{% endif %}
              {% if settings.carousel_item_1_caption != blank %}<p style="color: {{ settings.carousel_item_1_caption_color }}">{{ settings.carousel_item_1_caption }}</p>{% endif %}
              {% if settings.carousel_item_1_button_text != blank %}<p class="mb-0"><a href="{{ settings.carousel_item_1_link }}" class="btn primary py-2 px-4 fs-5">{{ settings.carousel_item_1_button_text }}</a></p>{% endif %}
            </div>
          {% endif %}
        </div>
