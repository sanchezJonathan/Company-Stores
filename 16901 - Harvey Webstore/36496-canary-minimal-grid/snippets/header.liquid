{% include 'top_notification_bar' %}
{% endif %}

{% include 'passcode_modal' %}
{% include 'remove_passcode_modal' %}

{% if shop.catalog_enabled? %}
  <div class="modal fade" id="search-modal" tabindex="-1" aria-labelledby="search-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-body text-center">
          {% form 'search' %}
            <div class="input-group input-group-lg">
              <input class="form-control border border-right-0 popup-search" type="search" name="s[keyword]" id="s_keyword" placeholder="Search" aria-label="Search">
              <button class="btn btn-outline border border-left-0 search-btn" type="submit"><i class="fa fa-search"></i></button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div class="mobile-slider d-lg-none d-xl-none" style="display: none">
  <ul class="nav flex-column links pages categories"></ul>
</div>
<div class="mobile-slider-overlay" style="display: none"></div>



<div class="cart-drawer-overlay"></div>
<div class="cart-drawer-container hidden">
  <a class="close-cart-drawer">
    <img src="{{ 'close-icon.svg' | asset_url }}"/>
  </a>
  <div class="cart-update-success">
    <div class="message">Cart update message.</div>
    <div class="close-success-notif">+</div>
  </div>
  {% form 'cart' %}
    <div class="shopping-cart" id="shopping-cart">
      {% if order.line_items_count > 0 %}
        <div class="table table-borderless">
          <div class="mb-3">
            <h4>Your Cart - {{ order.cart_items_count | pluralize: 'item', 'items' }}</h4>
            <div class="mt-2">
              <div class="cart-headings-container pb-3 border-bottom d-flex justify-content-between">
                <h1 class="mb-0">Your cart</h1>
                {% comment %}
                <small class="p-0">PRODUCT</small>
                <small class="p-0">TOTAL</small>
                {% endcomment %}
              </div>
              {% for bundle in order.bundle_line_items %}
                {% include 'drawer_bundle_line_item_fields', bundle: bundle %}
              {% endfor %}
              {% for line_item in order.line_items %}
                {% include 'drawer_line_item_fields', line_item: line_item %}
              {% endfor %}
            </div>
          </div>
          <div>
            <div class="cart-drawer-subtotal pt-3">
              <h4 class="fw-bold px-0 py-2 mb-0">Estimated total</h4>
              <div class="text-end py-2 pe-0">{{ order.cart_total | points_or_currency }}</div>
              <div class="loader" style="display: none;"></div>
            </div>
          </div>
        </div>
      {% else %}
        <div class="empty_cart_container">
          <h4 class="empty_cart fw-bold mb-4">
            Your cart is empty
          </h4>
          <a href="/products" class="btn secondary continue-shopping py-2 px-3">Continue shopping</a>
        </div>
      {% endif %}
    </div>
    {% if order.line_items_count > 0 %}
      <div class="cart-checkout-container">
        <div class="cart-more-info mb-3">
          Taxes, discounts and shipping calculated at checkout 
        </div>
        <div class="proceed-to-checkout-btn">
          <div class="mt-2 py-0 px-0">
            <a href="{{ cart_url }}" class="btn fw-bold primary px-lg-5">Go to Cart page</a>
          </div>
          <div class="mt-3 py-0 px-0">
            <button type="submit" name="checkout" class="btn fw-bold secondary px-lg-5 w-100">Check out</button>
          </div>
        </div>
      </div>
    {% endif %}
  {% endform %}
</div>


