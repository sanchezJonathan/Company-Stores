<!-- Start search functions -->
<script>
  const searchInput = document.querySelector(".search-box-container input");
  const resultsContainer = document.querySelector(".search-results");

  const MAX_RESULTS = 8;

  function generateSearchProducts() {
    const term = searchInput.value.toLowerCase().trim();
    resultsContainer.innerHTML = "";

    if (!term) {
      resultsContainer.style.display = "none";
      setSearchState(false);
      return;
    }

    let matches = [];
    const allProducts = document.querySelectorAll(".search-product");

    allProducts.forEach(function (product) {
      const name = (product.getAttribute("data-name") || "").toLowerCase().trim();
      const sku = (product.getAttribute("data-sku") || "").toLowerCase().trim();

      if (name.includes(term) || sku.includes(term)) {
        matches.push(product.innerHTML);
      }
    });

    if (matches.length > 0) {
  	  setSearchState(true);
      // Limit to 8 results
      const limitedResults = matches.slice(0, MAX_RESULTS);

      // Build "View All" link
      const encodedTerm = encodeURIComponent(searchInput.value.trim());
      const viewAllLink = `
        <div class="view-all-results" style="width:100%; text-align:center;border-bottom: 1px solid #000;border-top: 1px solid #000;margin-top: -1px;">
          <a href="/products?s%5Bkeyword%5D=${encodedTerm}" 
             style="display:inline-block; padding:20px 12px;  text-decoration:none;width: 100%;font-size: 18px;color: #000;">
            View all results
          </a>
        </div>
      `;

      // Inject results + button
      resultsContainer.innerHTML = limitedResults.join("") + viewAllLink;

      resultsContainer.style.display = "flex";
      resultsContainer.style.flexWrap = "wrap";

      // Only scroll if more than 8 results exist
      resultsContainer.style.maxHeight = matches.length > MAX_RESULTS ? "100%" : "none";
      resultsContainer.style.overflowY = matches.length > MAX_RESULTS ? "scroll" : "visible";

    } else {
      setSearchState(false);
      resultsContainer.style.display = "none";
    }
  }

  function setSearchState(isOpen) {
    document.body.classList.toggle("search-open", isOpen);
  }
  // Show results on focus
  searchInput.addEventListener("focus", function () {
    if (searchInput.value.trim()) {
      resultsContainer.style.display = "flex";
    }
  });

  // Hide when clicking outside
  document.addEventListener("click", function (event) {
    const searchBox = document.querySelector(".search-box-container");

    if (!event.target.closest(".search-box-container")) {
      searchInput.value = "";
      resultsContainer.innerHTML = "";
      resultsContainer.style.display = "none"; 
      setSearchState(false);
    }
  });

  // Events
  searchInput.addEventListener("input", generateSearchProducts);

  searchInput.addEventListener("keydown", function (event) {
    if (event.key === "Escape") {
      searchInput.value = "";
      resultsContainer.innerHTML = "";
      resultsContainer.style.display = "none";
      setSearchState(false);
    }

    if (event.key === "Enter") {
      event.preventDefault();
    }
  });
  
  //Toggle the visibility of the custom search box
  $('#custom-search-btn, .close-search').on('click', function () {
    const searchBox = $('.custom-searchbox-container');
    const searchInput = $('.search-box-container input');
    const resultsContainer = $('.search-results');

    searchBox.fadeToggle(300, function () {
      if (!searchBox.is(':visible')) {
        searchInput.val('');
        resultsContainer.empty();
        resultsContainer.hide();
        $('body').removeClass('search-open');
      }
    });
  });
</script>
<!-- End search functions -->

<!-- Start cart functions -->
<script>
  $(function() {
    function openCartDrawer() {
      $('.cart-drawer-overlay').show();
      $('.cart-drawer-container').show().removeClass('hidden');
    }
    function closeCartDrawer() {
      $('.cart-drawer-overlay').hide();
      $('.cart-drawer-container').hide().addClass('hidden');
    }
    function updateCart(form) {
      $('.cart-drawer-subtotal .text-end').hide();
      $('.cart-drawer-subtotal .loader').show();
      
      return $.ajax({
        type: form.attr('method'),
        url: form.attr('action'),
        data: form.serialize()
      }).then(() => {
        return fetch('/cart')
          .then(res => res.text())
          .then(html => {
            const doc = new DOMParser().parseFromString(html, 'text/html');

            $('#shopping-cart').replaceWith(doc.querySelector('#shopping-cart').outerHTML);
            $('#shopping-cart-page').replaceWith(doc.querySelector('#shopping-cart-page').outerHTML);

            $('.loader').hide();
            $('.item-total-price-value, .cart-drawer-subtotal .text-end').show();
          });
      });
    }
    
    function handleQuantityChange(button, type) {
      const item = button.closest('.cart-item');
      const input = button.siblings('input');

      const currentQty = parseInt(input.val());
      const increment = parseInt(item.data('product-internalid')) || 1;
      const min = parseInt(item.data('product-minoq')) || 1;
      const max = parseInt(item.data('product-maxoq')) || null;

      let newQty = currentQty;

      if (type === 'plus') {
        newQty += increment;
        if (max && newQty > max) {
          showError(item, `Item "${item.data('product-name')}" allows a maximum order of ${max}`);
          return;
        }
      }

      if (type === 'minus') {
        newQty -= increment;
        if (newQty < min) {
          showError(item, `Item "${item.data('product-name')}" allows a minimum order of ${min}`);
          return;
        }
      }

      input.val(newQty);

      // Show loaders
      //item.find('.item-total-price-value').hide();
      $('.cart-drawer-subtotal .text-end').hide();
      //item.find('.loader').show();
      $('.cart-drawer-subtotal .loader').show();

      $('.cart-drawer-container').addClass('update-cart');
      item.find('button[type="submit"]').prop('disabled', false);

      $('.cart-quantity-container button').click();
    }
    
    function showError(item, message) {
      const errorBox = item.find('.custom-moq-error');
      errorBox.find('span').text(message);
      errorBox.show();

      $('.cart-quantity-container button').prop('disabled', true);
    }
    
    
    $('.view-hide-cart').on('click', function (e) {
      e.preventDefault();
      $('.cart-drawer-container').attr('class');
      if ($('.cart-drawer-container').hasClass('hidden')) {
        openCartDrawer();
      } else {
        closeCartDrawer();
      }
    });

    $('.cart-drawer-overlay, .close-cart-drawer').on('click', closeCartDrawer);

    // Quantity buttons
    $(document).on('click', '#shopping-cart .plus', function () {
      handleQuantityChange($(this), 'plus');
    });

    $(document).on('click', '#shopping-cart .minus', function () {
      handleQuantityChange($(this), 'minus');
    });

    // Remove / empty
    $(document).on('click', '#shopping-cart .remove-cart-item, #shopping-cart .empty-cart', function () {
      const container = $(this).closest('.cart-item, #shopping-cart');

      container.find('.cart-quantity-input').val(0);

      $('.cart-drawer-container').addClass('update-cart');
      $('.cart-quantity-container button').prop('disabled', false).click();
    });

    // Form submit
    $(document).on('submit', '.cart-drawer-container form', function (e) {
      if ($('.cart-drawer-container').hasClass('update-cart')) {
        e.preventDefault();

        updateCart($(this)).then(() => {
          $('.cart-quantity-container button')
            .prop('disabled', true)
            .addClass('btn-dark')
            .removeClass('secondary');
        });
      }
    });
    
    $('.proceed-to-checkout-btn button').on('click', function () {
      $('.cart-drawer-container').removeClass('update-cart');
    });
  });
</script>
<!-- End cart functions -->