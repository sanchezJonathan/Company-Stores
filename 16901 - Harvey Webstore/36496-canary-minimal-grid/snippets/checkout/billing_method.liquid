<div class="content-item payment billing-method-container">
  <h2 class="mb-4">Billing method</h2>


  <div class="row pb-3">
    {% if current_user %}
      <div class="col-12 col-md-6">

          {% if shop.show_account_balance? %}
            <p class="fw-bold balance-info">
              You have {{ current_user.balance | points_or_currency }}{% if shop.points_store? %} points{% endif %} in your balance
            </p>

            {% if current_user.balance > 0 %}
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" value="true" role="switch" name="checkout[use_balance]" id="switch">
                <label class="form-check-label" for="switch">
                  Use my Account Balance
                </label>
              </div>
            {% endif %}

            {% if order.grand_total > current_user.balance %}
              <p class="form-item shcompany">
                Remaining account balance is <span style="color: red;">{% if shop.points_store? %}0 points{% else %}{{ 0 | points_or_currency }}{% endif %}</span>
              </p>
            {% else %}
              <p class="form-item shcompany">
                Remaining account balance is <span {% if current_user.balance > 0 %}style="color: green;" {% else %}style="color: red;"{% endif %}>{{ current_user.balance | minus: order.grand_total | points_or_currency }} {% if shop.points_store? %}points{% endif %}</span>
              </p>
            {% endif %}
          {% endif %}
      </div>
    {% endif %}
    {% if current_user and order.grand_total > current_user.balance %}
      <div class="col-12 col-md-6">
        <div class="border shcompany rounded p-3 mb-3">
          <h4>Account Balance Used</h4>
          <div>Order amount due is <span style="color: red;">{{ order.grand_total | minus: current_user.balance | abs | money_with_currency }}</span></div>
        </div>
      </div>
    {% endif %}
    <div class="col-12">
      {% if current_user and shop.show_gift_certificate? %}
        <div class="mb-3">
          <label class="form-label" for="website_order_gift_certificate">Gift certificate</label>
          <div class="input-group">
            <input class="form-control gift-certificate" id="website_order_gift_certificate" name="checkout[gift_certificate]" placeholder="Gift Certificate" size="30" type="text"/>
            <input class="btn secondary outline btn-apply button" name="apply_gift_certificate" type="submit" value="Apply">
          </div>
        </div>
      {% endif %}

      {% if shop.show_coupon? %}
        <div class="mb-3">
          <label class="form-label" for="website_order_coupon_code">Coupon code</label>
          <div class="input-group">
            <input class="form-control promo-code" id="website_order_coupon_code" name="checkout[coupon_code]" placeholder="Promotional code" size="30" type="text"/>
            <input class="btn secondary outline btn-apply button" name="apply_coupon_code" type="submit" value="Apply">
          </div>
        </div>
        <div class="mb-3 promotions">
          {% for coupon in order.coupons %}
            <div class="fields">
              <input type="hidden" class="delete-coupon" name="checkout[coupons][{{ coupon.id }}][delete]" value="false"/>
              <a href="javascript:void(0)" class="btn secondary remove-promotion remove_nested_fields" data-association="coupons">
                <span title="{{ coupon.note }}" class="coupon-note">{{ coupon.note }}</span> ({{ coupon.amount | points_or_currency }}) &times;
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  {% if current_user and shop.show_gift_certificate? %}
  <hr class="mt-1 mb-4" >
  {% endif %}

  {% if shop.show_coupon? and shop.show_gift_certificate? == false %}
  <hr class="mt-1 mb-4" >
  {% endif %}

  <div class="napr d-none">
    No additional payment required.
  </div>

  {% for payment_method in form.available_payment_methods %}
    <div class="pm payment-radio-input form-radio my-2 p-0">
      {% render_payment_method_checkbox payment_method %}
    </div>
  {% endfor %}

  <div class="pm">
    {% for payment_method in form.available_payment_methods %}
      {% render_payment_method_template payment_method %}
    {% endfor %}
  </div>

  <div class="mt-3">
    <input type="submit" value="Continue" class="btn secondary"/>
  </div>
</div>

<script>
  $(".payment-radio-input label input").addClass("form-check-input");
  $(".payment-method").each(function() {
    $(this).find("p.field label").addClass("form-label text-capitalize");
    $(this).find("p.field input").addClass("form-control");

    if ($(this).find("div.spreedly-input").length > 0) {
      $(this).find("div.spreedly-input").addClass("border rounded pt-1 ps-2 mb-3 w-100");
      return;
    }

    if ($(this).find("div.stripe-connect-input").length > 0) {
      $(this).addClass("row w-50");
      $(this).find(".credit-card-number").addClass("col-12");
      $(this).find(".credit-card-exp").addClass("col-md-6 col-sm-12");
      $(this).find(".credit-card-cvv").addClass("col-md-6 col-sm-12");
      $(this).find("div.stripe-connect-input").addClass("border rounded pt-2 ps-2 mb-3 w-100");
      return;
    }

    if ($(this).find('.authnet-btn').length > 0) {
      $(this).find(".authnet-btn").addClass("btn primary d-block w-25");
    }

    $(this).find("p.field").addClass("mb-3");
  });

  setTimeout(function() {
    $("div.select-wrapper").addClass("border rounded py-2");
  }, 200);
</script>
