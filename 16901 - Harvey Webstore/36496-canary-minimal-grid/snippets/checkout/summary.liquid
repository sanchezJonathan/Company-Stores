<div class="summary-container">
  <h2>Summary</h2>
  {% if custom_data_collections != empty %}
  <div>
    <h4 class="mt-3">{{ shop.custom_data_collections_name }}</h4>
    {% include 'custom_data_attributes' order: order %}
  </div>
  {% endif %}

  {% if shop.show_shipping_address? or shop.show_ship_method? %}
    <div>
      <h4 class="mt-3">Shipping</h4>
      <div class="row">
        {% if shop.show_shipping_address? %}
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Personal Information</div>
            <div>{{ order.shipping_contact.name }}</div>
            <div>{{ order.shipping_contact.phone }}</div>
            <div>{{ order.shipping_contact.email }}</div>	
            <div>{{ order.shipping_address.company }}</div>
          </div>
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Shipping Address</div>
            <div>{{ order.shipping_address.first_address }}</div>
            <div>{{ order.shipping_address.second_address }}</div>
            <div>{{ order.shipping_address.country }}</div>
            <div>{{ order.shipping_address.city }}</div>
            {% if order.shipping_address.state != empty %}<div>{{ order.shipping_address.state }}</div>{% endif %}
            <div>{{ order.shipping_address.zip }}</div>
          </div>
        {% endif %}
        {% if shop.show_ship_method? %}
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Shipping Method</div>
            <div>
              <div>
                {{ order.shipment.shipment_friendly_name }}:
                {% if site.show_shipping_base_rate? %}
                  {{ order.shipment_total_without_base_rate | points_or_currency }}
                {% else %}
                  {{ order.shipment_total | points_or_currency }}
                {% endif %}
              </div>

              {% if order.shipment.in_hands_date %}
                <div>In Hands Date: {{ order.shipment.in_hands_date }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
  
  {% if shop.show_billing_address? or shop.payment_required? %}
    <div>
      <h4 class="mt-3">Payment</h4>
      <div class="row">
        {% if shop.show_billing_address? %}
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Personal Information</div>
            <div>{{ order.billing_contact.name }}</div>
            <div>{{ order.billing_contact.phone }}</div>
            <div>{{ order.billing_contact.email }}</div>	
            <div>{{ order.billing_address.company }}</div>
          </div>
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Billing Address</div>
            <div>{{ order.billing_address.first_address }}</div>
            <div>{{ order.billing_address.second_address }}</div>
            <div>{{ order.billing_address.country }}</div>
            <div>{{ order.billing_address.city }}</div>
            {% if order.billing_address.state != empty %}<div>{{ order.billing_address.state }}</div>{% endif %}
            <div>{{ order.billing_address.zip }}</div>
          </div>
        {% endif %}
        {% if shop.payment_required? %}
          <div class="col-12 col-md-4 mt-2 mt-md-0">
            <div class="fw-bold">Billing Method</div>
            <div>
              {% if order.coupons != empty %}
                <div class="field payment-preview" style="vertical-align: top;">
                  {% for coupon in order.coupons %}
                    <div class="adjustment promotion coupon-row">{{ coupon.note }}: {{ coupon.amount | points_or_currency }}</div>
                  {% endfor %}
                </div>
              {% endif %}
              {% render_payment_template order.payments %}
            </div>
          </div>
        
          <script>
            $(".payment-preview").each(function() {
              var hasImg = $(this).find("img").length;
              var hasAch = $(this).find("span.ach-payment-details").length;
              var hasCoupon = !!$(".coupon-row").length;
              var hasAccountBal = !!$(".custom-payment-details:contains(Balance Used)").length;
              
              if (hasImg) {
                var borderTop = "";
                
                $(this).css("display", "flex");
                
                $(this).find("img").wrap("<div style='padding-right: 10px; padding-top: 5px; display: flex; align-items: center;'></div>");
                
                if ($(this).find("span").length) {
                  $(this).find("span").wrap("<div class='payment-val'></div>");
                  $(".payment-val").append("<span><br>Amount Charged: {{ order.grand_total | minus: order.balance_total | money_with_currency }}</span>");
                } else {
                  $(this).append("<div style='padding-top: 5px; display: flex; align-items:center;'><span>Amount Charged: {{ order.grand_total | minus: order.balance_total | money_with_currency }}</span></div>")
                }
              }
              
              if (hasAch) {
                $(this).append("<div style='padding-top: 5px; display: flex; align-items:center;'><span>Amount Charged:<br>{{ order.grand_total | minus: current_user.balance | abs | money_with_currency }}</span></div>")
              }
            });
          </script>
        {% endif %}
      </div>
    </div>
  {% endif %}


  {% if shop.budget_enabled? and current_user.has_budgets? and order.budget_order? %}
    <div>
      <h4 class="mt-3">Budget</h4>
      <p class="truncated">
        {% if order.budget %}
          {{ order.budget.name }} ({{ order.budget.code }})
        {% else %}
          No Budget
        {% endif %}
      </p>
    </div>
  {% endif %}
</div>
