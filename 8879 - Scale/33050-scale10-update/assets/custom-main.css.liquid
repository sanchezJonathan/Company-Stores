  /* footer (category page mockup): big logo + tagline, category accordions, social, links, then copyright */
  .site-footer-top {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0;
    padding: 56px 0 0;
  }
  .site-footer-logo img {
    max-width: 170px;
  }
  .site-footer-tagline {
    max-width: none;
    margin-top: 24px;
    font-size: var(--fs-h4);
  }
  .site-footer-categories {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.6);
  }
  .site-footer-col {
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  }
  .site-footer-heading {
    display: none;
  }
  .site-footer-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 0;
    border: 0;
    background: transparent;
    color: {{ settings.footer_header_color }};
    font-size: var(--fs-h5);
    font-weight: 700;
    text-align: left;
  }
  .site-footer-toggle svg {
    width: 22px;
    height: 22px;
    transition: transform 0.2s ease;
  }
  .site-footer-col.is-open .site-footer-toggle svg {
    transform: rotate(180deg);
  }
  .site-footer-list, .site-footer-list.is-two-col {
    display: none;
    grid-template-columns: max-content;
    gap: 14px;
    padding: 2px 0 20px;
  }
  .site-footer-col.is-open .site-footer-list {
    display: grid;
  }
  .site-footer-list.is-two-col li {
    margin-bottom: 0;
  }
  .footer-container .site-footer-social {
    justify-self: start;
    margin-top: 64px;
  }
  .site-footer-bottom {
    border-top: 0;
  }
  .site-footer-bottom .wrapper {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding-top: 24px;
    padding-bottom: 40px;
  }
  /* links first, then a divider, then the copyright */
  .site-footer-legal {
    order: 1;
    gap: 12px 22px;
    padding-bottom: 36px;
  }
  .site-footer-legal a {
    font-size: var(--fs-body);
  }
  /* category / products page (phone mockup): layout and spacing follow the mockup, text uses the sitewide phone sizes */
  .content-container:has(.products-page) > .container-fluid {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }
  .cl-header {
    grid-template-columns: minmax(0, 1fr);
    padding-top: 17px;
  }
  .cl-banner {
    display: none;
  }
  .cl-heading .breadcrumb {
    margin-bottom: 14px;
  }
  .cl-heading ol.breadcrumb li:not(.active), .cl-heading ol.breadcrumb li:not(.active) a {
    color: #7E7F81;
  }
  /* toolbar stays on one line: the count keeps its width, the sort dropdown shrinks (clipping long option text) */
  .cl-toolbar {
    flex-wrap: nowrap;
    margin: 11px 0 35px;
  }
  .cl-count {
    flex: none;
    font-size: var(--fs-h6);
    white-space: nowrap;
  }
  .cl-tools, .cl-tools .sort-form, .cl-tools .sort {
    min-width: 0;
  }
  .cl-tools .sort {
    gap: 10px;
  }
  .cl-tools .sort-label {
    font-size: var(--fs-h6);
  }
  .cl-tools .sort-select-pill {
    min-width: 0;
    height: 30px;
    padding: 0 26px 0 10px;
    border-radius: 6px !important;
    background-position: right 8px center;
    background-size: 10px 8px;
    font-size: var(--fs-h6);
    text-overflow: ellipsis;
  }
  .site-footer-copyright {
    order: 2;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    font-size: var(--fs-body);
  }
  /* product page (phone mockup): one column, breadcrumbs at the top, text at the sitewide phone sizes */
  .content-container:has(.product-page) > .container-fluid {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }
  .pp-crumbs-top {
    padding-top: 17px;
  }
  .pp-crumbs-top .breadcrumb {
    margin-bottom: 30px;
  }
  .pp-crumbs ol.breadcrumb li:not(.active), .pp-crumbs ol.breadcrumb li:not(.active) a {
    color: #7E7F81;
  }
  .product-page .product-page-main {
    padding-top: 0;
  }
  .product-page .product-wrapper {
    grid-template-columns: minmax(0, 1fr);
  }
  /* the carousel shows the images on phones; the main image stays in the page (hidden) for the platform scripts */
  .product-page-main .main-img {
    visibility: hidden;
  }
  /* the image zoom layer sits over the hidden main image and would block carousel swipes */
  .zoomContainer {
    display: none !important;
  }
  .product-page-main .main-img-container {
    border-radius: 18px !important;
  }
  .product-page-main .images-wrapper {
    margin-top: 17px;
  }
  .product-page-main .images-wrapper ul {
    gap: 17px;
  }
  .product-page-main .images-wrapper ul li {
    width: 97px;
    border-radius: 13px !important;
  }
  .product-page .product-right-section {
    margin-top: 22px;
  }
  .product-categories {
    display: none;
  }
  .product-page .product-title h2 {
    font-size: var(--fs-h1);
    line-height: 1.1;
  }
  .product-page .product-header .product-price {
    margin-top: 16px !important;
  }
  .product-page .product-description {
    margin-top: 25px;
    font-size: var(--fs-h6);
    line-height: 1.2;
  }
  .product-page-main .line-items-reflective-view > .prod_option_block {
    margin-top: 8px;
    padding-top: 22px;
  }
  .product-page-main .prod_option_block h4 {
    margin-bottom: 10px;
    font-size: var(--fs-h6);
  }
  .product-page.container-fluid > .row .col {
    padding: 0;
  }
  .product-page-main .prod_option_block .product-options .product-option-wrapper {
    padding-bottom: 47px;
  }
  .product-page-main .prod_option_block .product-options .product-option-wrapper + .product-option-wrapper {
    padding-top: 22px;
  }
  .product-page-main .prod_option_block .product-option-wrapper > label {
    margin-bottom: 12px !important;
    font-size: var(--fs-h4);
  }
  .product-page-main .select-area.thumbnail > div {
    gap: 12px 7px;
  }
  .product-page-main .product-option-wrapper .product-option-thumb {
    height: 38px;
    padding: 0 15px !important;
    border-width: 1px !important;
    border-radius: 7px !important;
    font-size: var(--fs-h6);
  }
  .product-page-main .product-info .total-info {
    gap: 13px;
    margin-top: 33px;
  }
  .product-page-main .total-info .product-quantity #quantity.pp-qty {
    width: 95px;
    height: 40px;
    padding: 0 4px;
    border-radius: 6px;
  }
  .pp-qty .pp-qty-btn, .pp-qty input.amount {
    font-size: var(--fs-h5);
  }
  .product-page-main .add-to-cart-area {
    flex: 1 1 0;
    min-width: 0;
  }
  .product-page-main .add-to-cart-area .btn.primary.add-to-cart {
    height: 40px;
    border-radius: 6px !important;
    font-size: var(--fs-h4);
    padding-bottom: 2px;
  }
  .related-products {
    margin-top: 90px;
  }
  .related-products > h2 {
    margin-bottom: 14px;
    font-size: var(--fs-h3);
  }
}

@media screen and (max-width: 480px){
  .product-thumbnail {
    width: 100% !important;
  }
  .product-page-main .images-wrapper ul li {
    width: 70px;
    border-radius: 8px !important;
  }
  .product-page-main .images-wrapper ul {
    gap: 10px;
  }
  .product-page-main .images-wrapper ul li {
    padding: 4px;
  }
}