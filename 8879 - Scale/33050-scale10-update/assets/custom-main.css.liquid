}
/* the basket icon sits just after the "Add to Cart" text (text 4.91em wide, icon 0.65em, 0.41em apart) */
.product-page-main .add-to-cart-area .btn.primary.add-to-cart {
  width: 100%;
  height: max(40px, calc(64 * var(--pp-u, 1px)));
