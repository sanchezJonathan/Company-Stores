/*-------------------*/
/* MOTION (script: snippets/site_motion.liquid); all of it is off for visitors who prefer reduced motion */
/*-------------------*/
/* header: soft shadow once the page is scrolled */
.header-container {
  transition: box-shadow 0.3s ease;
}
.header-container.is-scrolled {
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
}

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  :is(.featured-products-grid .product-list, .category-listing .product-list, .related-products-thumbnails, .recently-viewed-products-thumbnails) .product-thumbnail .thumbnail-img-container {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  :is(.featured-products-grid .product-list, .category-listing .product-list, .related-products-thumbnails, .recently-viewed-products-thumbnails) .product-thumbnail .thumbnail-img-container img {
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
  :is(.featured-products-grid .product-list, .category-listing .product-list, .related-products-thumbnails, .recently-viewed-products-thumbnails) .product-thumbnail:is(:hover, :focus-within) .thumbnail-img-container {
    transform: translateY(-4px);
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.06);
  }
  :is(.featured-products-grid .product-list, .category-listing .product-list, .related-products-thumbnails, .recently-viewed-products-thumbnails) .product-thumbnail:is(:hover, :focus-within) .thumbnail-img-container img {
    transform: scale(1.03);
  }
}
/* product card images fade in once loaded ("motion-ready" is set by the script, so nothing stays hidden without it) */
.motion-ready img.img-fade {
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.motion-ready img.img-fade.is-loaded {
  opacity: 1;
}
/* sections and product cards fade up once as they scroll into view */
.motion-ready [data-reveal] {
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.motion-ready [data-reveal]:not(.is-revealed) {
  opacity: 0;
  transform: translateY(16px);
}
@media (prefers-reduced-motion: reduce) {
  .header-container {
    transition: none;
  }
}
