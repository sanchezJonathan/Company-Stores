  width: max(24px, calc(36 * var(--pp-u, 1px)));
  height: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: #231F20;
  font-size: var(--fs-h4);
  line-height: 1;
}
.pp-qty input.amount {
