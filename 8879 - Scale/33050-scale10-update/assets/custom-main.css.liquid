/*-------------------
This theme uses Bootstrap v5.1.

It is highly recommended to check out Bootstrap's guiding principles,
strategies, and techniques at https://getbootstrap.com/docs/5.1/extend/approach/
before adding custom styling.

To learn more about Bootstrap v5.1, please check
out https://getbootstrap.com/docs/5.1/getting-started/introduction/.
/*-------------------*/

/*-------------------*/
/* GENERAL */
/*-------------------*/
* {
  font-family: 'Aeonik TRIAL' !important;
}
.fa, .fab, .fas {
  font-family: 'Font Awesome 5 Free' !important;
}
/* TYPE SCALE: every text size comes from these (desktop values; phone values are in the max-width: 767px block).
   Desktop minimum is 16px, phone minimum 14px */
:root {
  --fs-h1: 64px;
  --fs-h2: 48px;
  --fs-h3: 32px;
  --fs-h4: 24px;
  --fs-h5: 20px;
  --fs-h6: 18px;
  --fs-body: 16px;
  /* product page unit: 1 mockup px (1920 frame = admin container width) */
  --pp-u: calc(min(100vw, {{ settings.site_width }}) / 1920);
  /* category page and product card units, same idea (1920 mockup frame = admin container width) */
  --cl-u: calc(min(100vw, {{ settings.site_width }}) / 1920);
  --pt-u: calc(min(100vw, {{ settings.site_width }}) / 1920);
  /* COMPONENT TOKENS: buttons, inputs, selects, dropdowns, pagination and pickers sitewide all use these */
  --c-ink: #231F20;        /* text, dark buttons, borders on focus */
  --c-ink-hover: #595959;  /* primary button hover */
  --c-line: #D9D9DB;       /* input / select borders */
  --c-field: #FFFFFF;      /* input / select background */
  --c-soft: #EFEFF0;       /* light hover background */
  --c-disabled-bg: #F2F2F4;
  --c-disabled-text: #7E7F81;
  --radius: 10px;          /* one corner radius for buttons, inputs, selects, dropdowns */
}
body {
  font-size: var(--fs-body);
}
h1, .h1 { font-size: var(--fs-h1); }
h2, .h2 { font-size: var(--fs-h2); }
h3, .h3 { font-size: var(--fs-h3); }
h4, .h4 { font-size: var(--fs-h4); }
h5, .h5 { font-size: var(--fs-h6); }
h6, .h6 { font-size: var(--fs-h6); }
/* theme small text brought up to the minimum */
body span.required-label {
  font-size: var(--fs-body);
}
/*-------------------*/
.btn:not(.btn.rounded-pill), .dropdown-menu, .form-control, .product-thumbnail, .form-select, .accordion-item:first-of-type, .accordion-item:last-of-type, .nav-tabs .nav-link, #account-main > .content-area, .account-nav-menu ul, .recent-orders-wrapper, .rounded, .product-thumbnail .thumbnail-img-container, .product-page-main .images-wrapper ul li, .product-sub-option .ui-widget.ui-widget-content {
  border-radius: var(--radius, 10px) !important;
}
.account-nav-menu ul {
  border-radius: 10px 0 0 10px !important;
}
.account-nav-menu ul li:first-of-type, .account-nav-menu ul li:first-of-type a {
  border-radius: 10px 0 0 0 !important;
}
.account-nav-menu ul li:last-of-type, .account-nav-menu ul li:last-of-type a {
  border-radius: 0 0 0 10px !important;
}
#account-main > .content-area {
  border-radius: 0 10px 10px 10px !important;
}
.discount-container {
  top: 14px;
  left: 14px;
  border-radius: 0;
}
/* buttons */
.btn.secondary, .btn.primary {
  padding: 12px 24px;
  border-width: 1px;
  border-style: solid;
  font-size: var(--fs-body);
  line-height: 1.25;
}
.btn.secondary.rounded-pill {
  padding: 0;
  background-color: #231F20;
  color: #FFF;
  display: flex;
  justify-content: center;
  align-items: center;
}
.btn.primary:focus-visible, .btn.secondary:focus-visible {
  outline: 2px solid var(--c-ink, #231F20);
  outline-offset: 2px;
  box-shadow: none;
}
.btn.secondary.float-end {
  padding: 5px 14px;
}
/* text inputs and textareas */
.form-control {
  border: 1px solid var(--c-line, #D9D9DB);
  background-color: var(--c-field, #FFF);
  color: var(--c-ink, #231F20);
}
.form-control:focus {
  border-color: var(--c-ink, #231F20);
  background-color: var(--c-field, #FFF);
  box-shadow: none;
  color: var(--c-ink, #231F20);
}
.form-control::placeholder {
  color: var(--c-disabled-text, #7E7F81);
}
.form-control:disabled, .form-control[readonly] {
  background-color: var(--c-disabled-bg, #F2F2F4);
  color: var(--c-disabled-text, #7E7F81);
}
/* native selects */
.form-select {
  border: 1px solid var(--c-line, #D9D9DB);
  background-color: var(--c-field, #FFF);
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23231F20' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 14px center;
  background-size: 14px 11px;
  padding-right: 40px;
  color: var(--c-ink, #231F20);
}
.form-select:focus {
  border-color: var(--c-ink, #231F20);
  box-shadow: none;
}
.form-select:disabled {
  background-color: var(--c-disabled-bg, #F2F2F4);
  color: var(--c-disabled-text, #7E7F81);
}
/* select2 dropdowns */
.select2-container {
  width: 100% !important;
}
.select2-container .select2-selection--single .select2-selection__clear, .select2-container--bootstrap4 .select2-selection {
  margin-top: 6px;
  border-color: var(--c-line, #D9D9DB);
  border-radius: var(--radius, 10px);
  background-color: var(--c-field, #FFF);
}
.select2-container--bootstrap4.select2-container--focus .select2-selection, .select2-container--bootstrap4.select2-container--open .select2-selection {
  border-color: var(--c-ink, #231F20);
  box-shadow: none;
  border-bottom: 1px solid #231F20 !important;
  border-radius: 10px !important;
}
.select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered {
  border-radius: var(--radius, 10px);
  background-color: var(--c-field, #FFF);
  color: var(--c-ink, #231F20);
}
.select2-container--bootstrap4 .select2-selection--single .select2-selection__placeholder {
  color: var(--c-disabled-text, #7E7F81);
}
.select2-container--bootstrap4 .select2-dropdown.select2-dropdown--below {
  margin-top: 1px;
  border-color: var(--c-ink, #231F20);
  border-radius: 0;
}
/* locked country / state on checkout */
.select2-container--bootstrap4 .select2-selection--single.select2-selection--locked, .select2-container--bootstrap4 .select2-selection--locked .select2-selection__rendered {
  background-color: var(--c-disabled-bg, #F2F2F4);
  color: var(--c-disabled-text, #7E7F81);
}
.select2-container--bootstrap4 .select2-selection--locked .select2-selection__arrow b {
  border-top-color: var(--c-disabled-text, #7E7F81);
}
.select2-container--bootstrap4 .select2-dropdown.select2-dropdown--above {
  border-radius: 0;
  border: 1px solid #231f20;
}
.select2-container--bootstrap4 .select2-results > .select2-results__options {
  background-color: var(--c-field, #FFF);
  border-radius: 0;
}
.select2-container--bootstrap4 .select2-selection--single .select2-selection__arrow b {
  border-color: var(--c-ink, #231F20) transparent transparent transparent;
  border-width: 5px 5px 0;
  margin-left: -8px;
}
.select2-container--bootstrap4 .select2-results__option--highlighted, .select2-container--bootstrap4 .select2-results__option--highlighted.select2-results__option[aria-selected="true"] {
  background-color: var(--c-ink, #231F20);
  color: #FFF;
}
/* dropdown menus (account menu, header dropdowns) */
.dropdown-menu {
  border: 1px solid var(--c-line, #D9D9DB);
}
.dropdown-item:hover, .dropdown-item:focus {
  background-color: var(--c-soft, #EFEFF0);
  color: var(--c-ink, #231F20);
}
.dropdown-item.active, .dropdown-item:active {
  background-color: var(--c-ink, #231F20);
  color: #FFF;
}
/* checkboxes and radios */
.form-check-input {
  border-color: var(--c-ink, #231F20);
}
.form-check-input:checked {
  border-color: var(--c-ink, #231F20);
  background-color: var(--c-ink, #231F20);
}
.form-check-input:focus {
  border-color: var(--c-ink, #231F20);
  box-shadow: 0 0 0 2px rgba(35, 31, 32, 0.2);
}
/* spots where the theme uses the secondary button's background color as an accent */
.btn.secondary.outline {
  border-color: var(--c-ink, #231F20);
  color: var(--c-ink, #231F20);
}
.quantity-discount > button, .quantity-discount > button:hover, .quantity-discount > button:focus,
.size-chart > button, .size-chart > button:hover, .size-chart > button:focus {
  color: var(--c-ink, #231F20);
}
.product-option-wrapper .product-option-thumb.selected-prod-option, .product-option-wrapper .logo-location-thumb.selected-logo {
  border-color: var(--c-ink, #231F20) !important;
}
.out-of-stock-notification button, .out-of-stock-notification button:hover {
  border: 1px solid var(--c-ink, #231F20);
  border-radius: var(--radius, 10px);
}
::selection {
  background: #373737;
  color: #fff;
}
::-moz-selection {
  background: #373737;
  color: #fff;
}
/*-------------------*/
/* TOP NAV */
/*-------------------*/
.top-navbar-notification-container {
  padding: 5px 10px 9px;
}
.top-navbar-notification-container p {
  font-weight: 600;
}
/*-------------------*/
/* HEADER */
/*-------------------*/
.header-icons > a.btn.primary {
  border-radius: 20px !important;
	/* GRADIENT CART BUTTON BORDER */
  /*background: linear-gradient(#231F20, #231F20) padding-box, linear-gradient(to right, #E2A4CA, #CF88BA, #888BC4, #5AB6E7, #96D0F2) border-box;*/
  /*border: 1px solid transparent;*/
  padding: 6px 16px 4px;
}
.header-container .dropdown-menu > li > a {
  padding: 6px 16px !important;
}
.header-icons > a.btn-cart {
  margin-left: 25px;
}
.header-icons button svg {
  stroke: none;
}
/* Split header: categories left, logo centered, account/search/cart right */
.header-container .navbar.header-split {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  column-gap: 24px;
}
.header-container .navbar.header-split > #mobile-slider-button {
  justify-self: start;
}
.header-split-left {
  justify-self: start;
  align-items: center;
  margin-left: -16px; /* lines the first link's text up with the page edge (links have 16px side padding) */
}
.header-split-left .navbar-nav {
  flex-direction: row;
}
.header-container .header-split-logo {
  justify-self: center;
  margin-right: 0;
  margin-left: 0;
  padding: 0;
}
.header-split-right {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 28px;
}
.header-split-right .dropdown {
  height: 20px;
}
.header-split-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: var(--fs-h6);
  line-height: 1;
  color: {{ settings.header_link_color }};
  text-decoration: none;
  cursor: pointer;
  transition: opacity 0.2s ease;
}
.header-split-link:hover, .header-split-link:focus {
  color: {{ settings.header_hover_link_color }};
  text-decoration: none;
  opacity: 0.75;
}
/* All header icons share one height so they read as a set (the SVGs have slightly different proportions) */
.header-split-link .header-split-svg {
  display: block;
  width: auto;
  height: 20px;
  flex: 0 0 auto;
}
.header-split-link svg {
  width: 20px;
  height: 20px;
  flex: 0 0 auto;
}
/* phone + wishlist icons are filled shapes, the outline icons set fill="none" themselves */
.header-split-link.header-split-filled svg {
  fill: currentColor;
}
.header-split-divider {
  width: 1px;
  height: 22px;
  background-color: {{ settings.header_link_color }};
  opacity: 0.5;
}
.header-split-cart {
  gap: 8px;
}
.header-split-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 24px;
  padding: 0 6px;
  border-radius: 12px;
  background-color: {{ settings.header_link_color }};
  color: {{ settings.header_bg_color }};
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1;
}
.header-logo-mobile {
  display: none;
}
.mobile-slider {
  background-color: #231F20;
  width: 100%;
  padding-right: 1.25rem;
  margin-top: 5px;
}
.mobile-slider::before {
  display: none;
}
.mobile-slider-overlay {
  background-color: #231F20;
}
#s_keyword {
  border-top-right-radius: 0 !important;
  border-bottom-right-radius: 0 !important;
}
.simple_form.new_search.search-form .btn.btn-outline {
  border-top-left-radius: 0 !important;
  border-bottom-left-radius: 0 !important;
  border: 1px solid #231F20 !important;
}
/*-------------------*/
/* CATEGORY NAV */
/*-------------------*/

/*-------------------*/
/* CONTENT */
/*-------------------*/
.content-container .container-fluid > nav {
  margin-top: 1rem;
}
.homepage-welcome {
  text-align: center;
  padding: 8rem 2rem;
  margin: auto;
}
.homepage-welcome h1 {
  font-size: var(--fs-h1);
  font-weight: bold;
  margin-bottom: 1.1rem;
}
.homepage-welcome p {
  font-size: var(--fs-h6);
  max-width: 700px;
  margin: auto;
  line-height: 1.3;
}
.homepage-ctas {
  display: flex;
  justify-content: center;
  padding: 1.5rem;
  gap: 1rem;
}
.homepage-ctas .btn.primary {
  font-size: var(--fs-h6);
  font-weight: 500;
  padding: 12px 30px 14px;
  border-radius: 16px !important;
}
.homepage-ctas .btn.secondary {
  display: flex;
  flex-shrink: initial;
  font-size: var(--fs-h6);
  font-weight: 500;
  align-items: center;
  padding: 12px 30px 14px;
  border-radius: 16px !important;
  border: none;
}
.homepage-ctas .btn.secondary svg path {
  fill: currentColor;
}
.homepage-ctas .btn.secondary svg {
  width: 13px;
  height: 13px;
  margin-left: 8px;
}


.product-list {
  width: 100%;
  gap: 30px;
}
/* FEATURED PRODUCTS INFINITE CAROUSEL */
/* Full window width; JS sets the exact width/offset, this is the no-JS fallback */
.featured-products .fp-carousel {
  position: relative;
  display: block;
  width: 100vw;
  max-width: none;
  margin-top: 0rem;
  margin-bottom: 1rem;
  margin-left: calc(50% - 50vw);
}
.featured-products .fp-viewport {
  overflow: hidden;
  touch-action: pan-y; /* browser keeps vertical page scroll, JS handles horizontal swipe */
  cursor: grab;
  -webkit-user-select: none;
  user-select: none;
}
.featured-products .fp-carousel.fp-dragging .fp-viewport {
  cursor: grabbing;
}
.featured-products .fp-track.product-list {
  position: relative;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  --fp-u: calc(min(100vw, 1920px) / 1920);
  gap: max(10px, calc(14 * var(--fp-u)));
  width: max-content;
  margin: 0 !important;
  will-change: transform;
}
.featured-products .fp-track .product-thumbnail {
  --fp-w: calc(549 * var(--fp-u));
  --fp-h: calc(588 * var(--fp-u));
  flex: 0 0 auto;
  width: auto !important;
  margin: 0 !important;
  padding: 0;
  border: none;
  background: transparent;
}
.featured-products .fp-track .product-thumbnail.shape-square {
  --fp-w: calc(549 * var(--fp-u));
  --fp-h: calc(588 * var(--fp-u));
  align-self: flex-start;
  margin-top: calc(20 * var(--fp-u)) !important;
}
.featured-products .fp-track .product-thumbnail.shape-wide {
  --fp-w: calc(798 * var(--fp-u));
  --fp-h: calc(588 * var(--fp-u));
}
.featured-products .fp-track .product-thumbnail.shape-tall {
  --fp-w: calc(520 * var(--fp-u));
  --fp-h: calc(869 * var(--fp-u));
}
.featured-products .fp-track .product-thumbnail .thumbnail-img-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--fp-w);
  height: var(--fp-h);
  min-height: 0;
  padding: 0;
  overflow: hidden;
  border: none;
  border-radius: calc(58 * var(--fp-u)) !important;
  background: #EFEFF0 !important;
}
.featured-products .fp-track .product-thumbnail .thumbnail-img-container a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-height: 0;
}
.featured-products .fp-track .product-thumbnail .thumbnail-img-container img {
  -webkit-user-drag: none;
  width: auto;
  height: 100%;
  min-height: 0;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.featured-products .fp-track .thumbnail-description-container,
.featured-products .fp-track .product-thumbnail > .btn,
.featured-products .fp-track .new-item-label {
  display: none !important;
}
.featured-products .fp-arrow {
  position: absolute;
  top: 50%;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: none;
  background: transparent;
  color: #231F20;
  transform: translateY(-50%);
  cursor: pointer;
}
.featured-products .fp-arrow svg {
  width: 32px;
  height: 32px;
}
.featured-products .fp-prev {
  left: 40px;
}
.featured-products .fp-next {
  right: 40px;
}
/* HOME SECTION HEADER (eyebrow / title / intro), shared by featured categories + featured products grid */
.hs-eyebrow {
  margin-bottom: 1.25rem;
  font-size: var(--fs-h6);
  font-weight: 700;
  color: #1a1a1a;
}
.hs-title {
  margin-bottom: 1.5rem;
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1.1;
  color: #1a1a1a;
}
.hs-intro {
  max-width: 740px;
  margin-bottom: 3rem;
  font-size: 18px;
  line-height: 1.4;
  color: #1a1a1a;
}
/* FEATURED CATEGORIES */
.featured-categories {
  margin: 5rem 0;
}
.featured-categories .merch-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 50px 50px;
}
.featured-categories .merch-card {
  position: relative;
  display: block;
  aspect-ratio: 1118 / 800;
  overflow: hidden;
  border-radius: 30px;
  background-color: #ececec;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.featured-categories .merch-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  text-decoration: none;
}
.featured-categories .merch-card--hero,
.featured-categories .merch-card--wide {
  grid-column: 1 / -1;
}
.featured-categories .merch-card--hero {
  aspect-ratio: 2336 / 1150;
}
.featured-categories .merch-card--wide {
  aspect-ratio: 2336 / 790;
}
.featured-categories .merch-card-title {
  position: absolute;
  top: 28px;
  left: 32px;
  font-size: var(--fs-h2);
  font-weight: 400;
  line-height: 1.1;
  color: #1a1a1a;
}
.featured-products-grid {
  margin: 5rem 0 4rem;
}
.home-banner {
  margin-top: 10rem;
  margin-bottom: 4.5rem;
}
.home-banner img {
  display: block;
  width: 100%;
  height: auto;
}
body:has(.home-banner) .footer-container {
  margin-top: 0 !important;
}
.content-block:has(.homepage-accordions) {
  margin-top: 10rem;
}
.homepage-accordions {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 84px;
  align-items: start;
}
.homepage-accordions #homePageAccordion, .homepage-accordions #homePageAccordion2 {
  width: auto !important;
  max-width: none !important;
  margin: 0;
  padding: 0;
}
.homepage-accordions .accordion-item {
  width: 100%;
  float: none;
  border: 0;
  border-top: 1px solid #E6E7E8;
  border-radius: 0 !important;
  background-color: transparent;
}
.homepage-accordions .accordion > .accordion-item:last-child {
  border-bottom: 1px solid #E6E7E8;
}
.homepage-accordions .accordion-header {
  margin: 0;
}
.homepage-accordions .accordion-button,
.homepage-accordions .accordion-button:focus,
.homepage-accordions .accordion-button:not(.collapsed) {
  gap: 24px;
  padding: 28px 0;
  border: 0;
  background-color: transparent;
  box-shadow: none;
  color: #231F20;
  font-size: var(--fs-h6);
  font-weight: 500;
  line-height: 1.3;
}
.homepage-accordions .accordion-button:focus-visible {
  outline: 2px solid #231F20;
  outline-offset: 4px;
}
.homepage-accordions .accordion-button::after {
  width: 20px;
  height: 20px;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='%23231F20' stroke-width='2' stroke-linecap='round'%3e%3cpath d='M10 3v14M3 10h14'/%3e%3c/svg%3e");
  background-size: 20px 20px;
  transform: none;
}
.homepage-accordions .accordion-button:not(.collapsed)::after {
