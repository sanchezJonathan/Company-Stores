<div class="row">
  <div class="col col-md-12 col-sm-12 col-xs-12">
    {% include 'product_recently_viewed_products' %}
  </div>
</div>

<div class="row">
  <div class="col col-md-12 col-sm-12 col-xs-12">
    {% include 'product_related_products' %}
  </div>
</div>

<div id="fb-root">
</div>

{% if product.size_charts.size > 0 %}
<div class="modal fade" id="modal-sizeChart" tabindex="-1" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true" style="display: none;">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Size Charts</h5>
        <button type="button" class="close btn-close" data-bs-dismiss="modal" aria-label="Close">
          <!-- <span aria-hidden="true">&times;</span> -->
        </button>
      </div>
      <div class="modal-body">
        <div class="product-tabs">
          <div class="tabs-body">
            <div class="product-size-charts visible text-center">
              {% for chart in product.size_charts %}
                {% if chart.url contains 'PNG' or chart.url contains 'png' %}
                  <a target="_blank" class="size-chart-item border rounded text-center d-inline-flex flex-column m-2" href="{{chart.url}}">
              		<div class="d-block py-3 px-5">{% include 'icons/download-png' %}</div>
                    <span class="border-top py-2">{{ chart.name | replace: " PNG", "" }}</span>
                  </a>
                {% endif %}
              	{% if chart.url contains 'PDF' or chart.url contains 'pdf' %}
                  <a target="_blank" class="size-chart-item border rounded text-center d-inline-flex flex-column m-2" href="{{chart.url}}">
              		<div class="d-block py-3 px-5">{% include 'icons/download-pdf' %}</div>
                    <span class="border-top py-2">{{ chart.name | replace: " PDF", "" }}</span>
                  </a>
                {% endif %}
              	{% if chart.url contains 'JPG' or chart.url contains 'JPEG' or chart.url contains 'jpg' or chart.url contains 'jpeg' %}
                  <a target="_blank" class="size-chart-item border rounded text-center d-inline-flex flex-column m-2" href="{{chart.url}}">
              		<div class="d-block py-3 px-5">{% include 'icons/download-jpg' %}</div>
                    <span class="border-top py-2">{{ chart.name | replace: " JPG", "" }}</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}

<div class="modal fade" id="modal-quantity-discount" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Quantity Discounts</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="product-tabs">
          <div class="tabs-body">
            <div class="product-quantity-discounts powered-with-ckeditor visible">
              <table class="table tab_2 table-bordered">
                <thead class="thead-light">
                  <tr>
                    <th>Quantity</th>
                    <th>Base Price</th>
                  </tr>
                </thead>
                <tbody>
                {% for quantity_discount_group in product.quantity_discount_groups %}
                  <tr class='discount-group-name'>
                    <!-- <td colspan="2">{{ quantity_discount_group.name }}</td> -->
                    <td>{{ quantity_discount_group.name }}</td>
                    <td></td>
                  </tr>
                  {% for quantity_discount in quantity_discount_group.quantity_discounts %}
                    <tr>
                      <td>{{ quantity_discount.quantity }}</td>
                      <td>{{ quantity_discount.price | points_or_currency }}</td>
                    </tr>
                  {% endfor %}
                {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% include 'in_stock_modal' %}
{% include 'product_javascript' %}
{% include 'product_js' %}