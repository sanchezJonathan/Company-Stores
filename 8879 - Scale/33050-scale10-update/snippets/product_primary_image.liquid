{% if product.primary_image %}
  <a id="primary_image_link" href="{{ product.primary_image.large_url }}" data-toggle="lightbox">
    <img alt="{{ product.name }} primary image" title="{{ product.name }} primary image" id="primary_image" src="{{ product.primary_image.large_url }}" />
  </a>
{% else %}
  <img src="{{ "no-image.jpg" | asset_url }}"/>
{% endif %}
