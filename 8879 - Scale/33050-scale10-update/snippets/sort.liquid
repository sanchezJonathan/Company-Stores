<div class="sort-form {% if caller != "mobile" %}d-inline-block{% endif %}">
  {% sort products_search %}
    {% form 'search', products_search %}
      <div class="sort">
        {% if caller == "listing" %}
          <label class="sort-label" for="listing-sort-select">Sort By</label>
        {% elsif caller != "mobile" %}
          <span>Sort By: </span>
        {% endif %}
        <select {% if caller == "listing" %}id="listing-sort-select" {% endif %}class="form-select {% if caller == "listing" %}sort-select-pill{% elsif caller != "mobile" %}sort-select d-inline-block ms-2{% endif %}" name="s[sort]" onchange="$(this).parents('form').submit();">
          {% for sort_option in sort_options %}
            <option {% if sort_option.selected %} selected {% endif %} value="{{ sort_option.value }}">{{ sort_option.title }}</option>
          {% endfor %}
        </select>
      </div>
    {% endform %}
  {% endsort %}
</div>
