<h2>Shipping Address</h2>
<p style="margin-bottom: 40px;"><em>If your home address in Bamboo HR is near a Scale office, you MUST pick up your swag from that Scale office (this applies to SFHQ, NYC, DC, STL, CDMX, Budapest). If you are located near SFHQ or a Scale hub, your ONLY option will be to ship to SFHQ or a Scale Hub. You will NOT be able to change to a different address. Scaliens who do not live near SFHQ, NYC, DC, STL, CDMX or Budapest may ship to the address of their choice.</em></p>
{% if isSFHQ == 1 or isMexicoCityOffice == 1 or isWashingtonDCOffice == 1 or isNewYorkCityOffice == 1 or isStLouisOffice ==1 %}
{% else %}
  {% include 'shipping_addresses_drop_down', form: form %}
{% endif %}
{% include 'shipping_address_fields', form: form %}

{% comment %} {% if current_user %}
  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" value="true" id="checkout[save_to_address]" name="checkout[save_to_address]" {% if form.save_to_address %}checked{% endif %}>
    <label class="form-check-label" for="checkout[save_to_address]">
      Save my Address Information
    </label>
  </div>
{% endif %} {% endcomment %}

<input type="submit" value="Continue" class="btn secondary"/>
{% if isSFHQ == 1 %}
<script>
  // $('#website_order_shipping_contact_attributes_first_name').prop('readonly', true);
  // $('#website_order_shipping_contact_attributes_last_name').prop('readonly', true);
  // $('#website_order_shipping_contact_attributes_email').prop('readonly', true);
  $('#website_order_shipping_address_attributes_company').val('Scale AI').prop('readonly', true);
  $('#website_order_shipping_address_attributes_first_address').val('650 Townsend Street').prop('readonly', true);
  $('#website_order_shipping_address_attributes_second_address').val('Lily Mireles').prop('readonly', true);
  $('#website_order_shipping_address_attributes_city').val('San Francisco').prop('readonly', true);
  $('#website_order_shipping_address_attributes_country').val('United States').trigger('change');
  setTimeout(function() {
    $('#website_order_shipping_address_attributes_state').val('California').trigger('change');
  }, 500);
  $('#website_order_shipping_address_attributes_zip').val('94103').prop('readonly', true);
  setTimeout(function() {
    $('#website_order_shipping_address_attributes_country').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').addClass('select2-selection--locked');
    $('#website_order_shipping_address_attributes_state').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').addClass('select2-selection--locked');
    $('.select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered').css('background-color', 'unset');
  }, 500);
  $('.address-dropdown').on('change', function() {
    setTimeout(function() {
      $('#website_order_shipping_address_attributes_country').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').addClass('select2-selection--locked');
      $('#website_order_shipping_address_attributes_state').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').addClass('select2-selection--locked');
    }, 500);
  });
</script>
