<script type="text/javascript">
  $(document).ready(function() {
    var stickyHeaderHeight = $(".sticky-header").height() + 10;
    $(".product-left-section .product-info").css("top", stickyHeaderHeight + "px");
    
    function adjustThumbnailWidth() {
      var gutter = 15;
      var containerWidth = $(".product-page-right.recently-viewed-products").width() + gutter;
      var products_per_row = {{ settings.product_thumbnails_per_row }};
      var thumbnail_division = containerWidth / products_per_row;
      var thumbnail_width = thumbnail_division - gutter;
      var thumbnail_margin = gutter / 2;
      
      if (window.innerWidth > 992) {
        $(".recently-viewed-products-thumbnails").attr("style", "margin: 0; margin-right: -20px !important;");
        $(".related-products-thumbnails").attr("style", "margin: 0; margin-right: -20px !important;");
        $(".product-thumbnail").attr("style", "width:" + thumbnail_width + "px; margin: 10px "+ gutter +"px 10px 0");
        
        return;
      }
      
      if (window.innerWidth > 768 && {{ settings.product_thumbnails_per_row }} >= 4) {
        products_per_row = 4;
        thumbnail_division = containerWidth / products_per_row;
        thumbnail_width = thumbnail_division - gutter;
        thumbnail_margin = gutter / 2;

        $(".product-list").attr("style", "margin: 0 !important; margin-right: -20px !important;");
        $(".recently-viewed-products-thumbnails").attr("style", "margin: 0; margin-right: -20px !important;");
        $(".related-products-thumbnails").attr("style", "margin: 0; margin-right: -20px !important;");
        $(".product-thumbnail").attr("style", "width:" + thumbnail_width + "px; margin: 10px "+ gutter +"px 10px 0");

        return;
      }
      
      $(".product-list").removeAttr("style");
      $(".recently-viewed-products-thumbnails").removeAttr("style");
      $(".related-products-thumbnails").removeAttr("style");
      $(".product-thumbnail").removeAttr("style");
    }
    
    // The Related / Recently Viewed product cards are laid out in CSS now (PRODUCT CARDS in custom-main.css),
    // so the old inline thumbnail widths are no longer applied
    // adjustThumbnailWidth();
    // $(window).resize(function() {
    //   adjustThumbnailWidth();
    // });
    $(".accordion-body a").attr("target", "_blank");

    // Quantity stepper (- 1 +): changes the real product[quantity] input and fires "change" so prices recalculate
    $(".pp-qty-btn").on("click", function() {
      var $input = $(this).siblings("input[data-type='quantity']");
      var min = parseInt($input.attr("min"), 10) || 0;
      var value = (parseInt($input.val(), 10) || 0) + parseInt($(this).data("step"), 10);
      $input.val(Math.max(min, value)).trigger("change");
    });

    // Breadcrumbs: link the product's categories using the store's category list
    var $allCrumbCategories = $(".pp-crumbs .pp-crumb-categories");
    if ($allCrumbCategories.length && typeof categories !== "undefined") {
      // every category with its path from the top level
      var categoryTrails = [];
      (function walk(list, trail) {
        $.each(list || [], function(i, category) {
          var path = trail.concat([category]);
          categoryTrails.push(path);
          walk(category.children, path);
        });
      })(categories, []);

      var crumbLink = function(category) {
        return category.link ? $("<a>").attr("href", category.link).text(category.name) : $("<span>").text(category.name);
      };

      $allCrumbCategories.each(function() {
        var $crumbCategories = $(this);
        var matched = [];
        $crumbCategories.find("span[data-category-name]").each(function() {
          var id = String($(this).data("category-id"));
          var name = String($(this).data("category-name"));
          var trail = categoryTrails.filter(function(path) { return String(path[path.length - 1].id) === id; })[0]
            || categoryTrails.filter(function(path) { return path[path.length - 1].name === name; })[0];
          matched.push(trail || [{ name: name }]);
        });
        // drop a category when another one of the product's categories sits under it (Collections + 10 Years -> 10 Years)
        matched = matched.filter(function(trail) {
          var category = trail[trail.length - 1];
          return !matched.some(function(other) { return other !== trail && other.indexOf(category) > -1 && other[other.length - 1] !== category; });
        });

        if (matched.length === 1) {
          // one category: its full path, one crumb per level (Home > Collections > 10 Years > product)
          $crumbCategories.replaceWith($.map(matched[0], function(category) {
            return $("<li class='breadcrumb-item'>").append(crumbLink(category))[0];
          }));
        } else {
          // several categories: one crumb, the categories comma-separated
          $crumbCategories.empty();
          $.each(matched, function(i, trail) {
            if (i) $crumbCategories.append(", ");
            $crumbCategories.append(crumbLink(trail[trail.length - 1]));
          });
        }
      });
    }

    // Phone gallery carousel, kept in sync with the hidden main image
    var carouselEl = document.getElementById("pp-carousel");
    var primaryImg = document.getElementById("primary_image");
    if (carouselEl && primaryImg && window.bootstrap) {
      var carousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, { interval: false, touch: true, wrap: true });
      var $slides = $(carouselEl).find(".carousel-item");

      // Swipe / arrow / dot: show that image in the main image too, so options and logo previews use it
      carouselEl.addEventListener("slid.bs.carousel", function(e) {
        var $slide = $slides.eq(e.to);
        if (primaryImg.getAttribute("src") !== $slide.find("img").attr("src")) {
          changePrimaryImage($slide.find("a").attr("href"));
        }
        $(".gallery-main .main-img").data("id", $slide.data("id"));
        storeMainImage();
      });

      // Main image changed elsewhere (color option, thumbnail tap, logo preview): move the carousel to it
      new MutationObserver(function() {
        var src = primaryImg.getAttribute("src");
        var $slide = $slides.filter(function() { return $(this).data("src") === src; }).first();
        if (!$slide.length) {
          // a generated logo preview: show it on the slide for the current image
          $slide = $slides.filter("[data-id='" + $(".gallery-main .main-img").data("id") + "']").first();
          if (!$slide.length) return;
          $slide.find("img").attr("src", src);
          $slide.find("a").attr("href", src);
        }
        var index = $slides.index($slide);
        if (index !== $slides.index($slides.filter(".active"))) {
          carousel.to(index);
        }
      }).observe(primaryImg, { attributes: true, attributeFilter: ["src"] });
    }
  });
</script>