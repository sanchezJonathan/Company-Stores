{% assign option_name = product_option.friendly_name | downcase %}
{% if option_name == 'color' or option_name == 'size' or option_name == 'size guide' %}
  {% assign has_buttons = true %}
{% else %}
  {% assign has_buttons = false %}
{% endif %}

{% comment %}Size and color are picked with the buttons in templates/product.liquid, which set these selects.{% endcomment %}
<div class="product-option{% if has_buttons %} d-none{% endif %}">
  <label class="product-option-label" for="product-option-{{ product_option.id }}">{{ product_option.friendly_name }}</label>
  <select id="product-option-{{ product_option.id }}"
    data-type="product-option"
    data-name="{{ product_option.friendly_name }}"
    data-option-type="{{ product_option.option_type }}"
    name="product[options][{{ product_option.id }}][sub_option]"
    class="form-select{% if form.options[product_option.id].errors %} is-invalid{% endif %}">
    <option></option>
    {% for sub_option in product_option.sub_options %}
      <option value="{{ sub_option.id }}" data-name="{{ sub_option.name }}"
        {% if form.options[product_option.id].sub_option == sub_option.id %}selected{% endif %}>
        {% include 'modifier', title: sub_option.name, amount: sub_option.amount %}
      </option>
    {% endfor %}
  </select>
</div>

{% if form.options[product_option.id].errors %}
  <div class="error invalid-feedback d-block" data-type="product-option-error">
    {{ form.options[product_option.id].errors | default_errors }}
  </div>
{% endif %}
