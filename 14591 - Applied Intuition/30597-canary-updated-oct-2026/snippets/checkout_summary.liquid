{% comment %}
<div class="border p-3 checkout-order-summary">
  <h5>Order Summary</h5>
  <div>
    Subtotal ({{ order.cart_items_count | pluralize: 'item', 'items' }})
    <span class="value float-end">{{ order.item_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
  </div>
  {% if order.total_setup_charge > 0 %}
    <div>
      Total Setup Charge
      <span class="value float-end">{{ order.total_setup_charge | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% endif %}

  {% if site.show_shipping_base_rate? %}
    <div>
      Shipping
      <span class="value float-end">{{ order.shipment_total_without_base_rate | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
    <div>
      {{ site.shipping_base_rate_name }}
      <span class="value float-end">{{ order.shipment_base_rate | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% else %}
    <div>
      Shipping
      <span class="value float-end">{{ order.shipment_rate | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% endif %}

  {% if order.tax_enabled? %}
    <hr class="my-1">
    <div>
      Total before tax
      <span class="value float-end">{{ order.before_tax_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
    <div>
      Sales tax
      <span class="value float-end">{{ order.total_tax | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% endif %}

  {% if order.coupons != empty %}
    <hr class="my-1">
    {% for coupon in order.coupons %}
      <div>
        <span style="text-transform: lowercase;" title="{{ coupon.note }}">{{ coupon.note | truncate: 15 }}</span>
        <span class="value float-end">{{ coupon.amount | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
      </div>
    {% endfor %}
    <div>
      Total Discount
      <span class="value float-end">{{ order.promo_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% endif %}

  {% if order.custom_data_collections != empty %}
    <div>
      {{ shop.custom_data_collections_name }}
      <span class="value float-end">{{ order.custom_data_collections_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
    </div>
  {% endif %}

  <hr class="my-1">
  <div>
    Grand Total
    <span class="value float-end">{{ order.grand_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
  </div>
  </div>
  {% endcomment %}

  <div class="p-3 mt-4 checkout-item-summary">
  {% comment %}
  <div class="mb-3">
    <h5 class="d-inline-block">Item Summary</h5>
    <a href="{{ cart_url }}" class="btn secondary float-end btn-item-summary">Edit</a>
  </div>
  {% endcomment %}

  {% for line_item in order.line_items %}
    <div class="border-bottom">
      <div class="checkout-item-image">
         <img alt="{{ line_item.name }} image" title="{{ line_item.name }} image" class="cart-product-img" src="{% if line_item.image %}{{ line_item.image.medium_url }}{% else %}{{ 'no-image.jpg' | asset_url }}{% endif %}" />
      </div>
      <div class="checkout-item-details">
        <p class="checkout-product-label" style="font-weight: 600;">{{ line_item.name }}</p>
        {% comment %}
        <p class="value float-end">{{ line_item.total_price | points_or_currency }}{% if shop.points_store? %} points{% endif %}</p>
        {% endcomment %}
        {% for choice in line_item.choices %}
          {% if choice.option.friendly_name == 'COLOR' %}
            <p class="sub-option-value"><span style="font-weight: 600;">COLOR: </span>{{ choice.sub_option.name }}</p>
          {% endif %}
          {% if choice.option.friendly_name == 'SIZE' %}
            <p class="sub-option-value"><span style="font-weight: 600;">SIZE: </span>{{ choice.sub_option.name }}</p>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}
    
  {% comment %}
  <hr class="my-1">
  <div>
    Subtotal
    <span class="value float-end">{{ order.item_total | points_or_currency }}{% if shop.points_store? %} points{% endif %}</span>
  </div>
  {% endcomment %}
  </div>