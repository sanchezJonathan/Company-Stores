<script>
  $(function () {
    var $page = $('.product-detail');
    var $form = $page.find('form');
    var $addButton = $page.find('.product-add');
    var buttonLabels = { select: 'Select size', add: 'Add to bag', added: 'Added to bag', 'sold-out': 'Sold out' };
    var addedTimer;

    // Options: the size and color buttons set the platform's hidden selects

    function choose($button) {
      $button.addClass('is-selected').attr('aria-pressed', 'true')
        .siblings().removeClass('is-selected').attr('aria-pressed', 'false');
      $form.find('select[name="product[options][' + $button.data('option') + '][sub_option]"]')
        .val($button.data('value'))
        .trigger('change');
    }

    $page.on('click', '.product-size', function () {
      choose($(this));
      clearTimeout(addedTimer);
      updateAddButton();
    });

    $page.on('click', '.product-color', function () {
      choose($(this));
      showColorPhotos($(this).data('value'));

      var url = new URL(location.href);
      url.searchParams.set('color', $(this).data('value'));
      history.replaceState(null, '', url);
    });

    // Photos

    function setCurrentPhoto($photo) {
      $page.find('.product-photo, .product-rail-thumb').removeClass('is-current');
      $photo.addClass('is-current');
      $page.find('.product-rail-thumb[data-photo="' + $photo.data('photo') + '"]').addClass('is-current');
    }

    function showColorPhotos(colorId) {
      $page.find('.product-photo, .product-rail-thumb').each(function () {
        var photoColor = $(this).attr('data-color');
        $(this).toggleClass('d-none', photoColor !== '' && photoColor !== String(colorId));
      });
      setCurrentPhoto($page.find('.product-photo:not(.d-none)').first());
    }

    function stepPhoto(by) {
      var $photos = $page.find('.product-photo:not(.d-none)');
      var index = $photos.index($photos.filter('.is-current'));
      setCurrentPhoto($photos.eq((index + by + $photos.length) % $photos.length));
    }

    // Desktop: a rail thumbnail moves its photo to the top of the gallery
    $page.on('click', '.product-rail-thumb', function () {
      var $photo = $page.find('.product-photo[data-photo="' + $(this).data('photo') + '"]');
      $photo.prependTo($photo.parent()).hide().fadeIn(200);
      setCurrentPhoto($photo);
    });

    // Phones: arrows and sideways swipes step through the photos, looping
    $page.on('click', '.product-gallery-arrow', function () {
      stepPhoto($(this).hasClass('next') ? 1 : -1);
    });

    var touchStart = null;
    $page.on('touchstart', '.product-photos', function (e) {
      var touch = e.originalEvent.touches[0];
      touchStart = { x: touch.clientX, y: touch.clientY };
    });
    $page.on('touchend', '.product-photos', function (e) {
      if (!touchStart) return;
      var touch = e.originalEvent.changedTouches[0];
      var dx = touch.clientX - touchStart.x;
      var dy = touch.clientY - touchStart.y;
      touchStart = null;
      if (Math.abs(dx) > 30 && Math.abs(dx) > Math.abs(dy)) stepPhoto(dx < 0 ? 1 : -1);
    });

    // Add to bag button

    function setButton(state) {
      $addButton.attr('data-state', state).text(buttonLabels[state]).prop('disabled', state === 'sold-out');
    }

    function updateAddButton() {
      var needsSize = $page.find('.product-size').length > 0 && $page.find('.product-size.is-selected').length === 0;
      var soldOut = $('#stock').hasClass('text-danger');
      setButton(needsSize ? 'select' : soldOut ? 'sold-out' : 'add');
    }

    // The platform reports stock for the chosen options in #stock after each price update
    $(document).ajaxComplete(function () {
      if ($addButton.attr('data-state') !== 'added') updateAddButton();
    });

    $form.on('submit', function (e) {
      e.preventDefault();
      if ($addButton.attr('data-state') !== 'add') return;

      var countBefore = parseInt($('#bag-count').text(), 10) || 0;
      $addButton.prop('disabled', true);
      $.post($form.attr('action'), $form.serialize() + '&add_to_cart=ADD+TO+CART').always(function () {
        refreshBag().then(function (count) {
          if (count > countBefore) {
            setButton('added');
            addedTimer = setTimeout(updateAddButton, 2000);
          } else {
            // Nothing was added, so submit normally and let the platform show its error
            $form.append('<input type="hidden" name="add_to_cart" value="ADD TO CART">');
            $form[0].submit();
          }
        });
      });
    });

    // Size guide: closes with its X (a dialog form), Esc, or a click outside the panel
    var sizeGuide = document.getElementById('size-guide');
    $page.on('click', '.product-size-guide-link', function () {
      sizeGuide.showModal();
    });
    $(sizeGuide).on('click', function (e) {
      if (e.target === sizeGuide) sizeGuide.close();
    });

    // Start on the color from ?color=, then a color kept after a form error, then the first color
    var $colors = $page.find('.product-color');
    var colorParam = new URLSearchParams(location.search).get('color');
    var $startColor = $colors.filter(function () { return String($(this).data('value')) === colorParam; });
    if (!$startColor.length) $startColor = $colors.filter('.is-selected');
    if (!$startColor.length) $startColor = $colors.first();

    if ($startColor.length) {
      choose($startColor.first());
      showColorPhotos($startColor.first().data('value'));
    } else {
      setCurrentPhoto($page.find('.product-photo').first());
    }
    updateAddButton();
  });
</script>
