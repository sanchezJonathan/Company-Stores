<dialog class="size-guide" id="size-guide" aria-label="Size guide">
  <div class="size-guide-panel">
    <form method="dialog" class="size-guide-close">
      <button type="submit" aria-label="Close size guide">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13"/></svg>
      </button>
    </form>
    <table>
      <thead>
        <tr><th>Shirt Size</th><th>Chest</th><th>Arm Length</th></tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>31.5″–34.5″</td><td>32</td></tr>
        <tr><td>S</td><td>34.5″–37.5″</td><td>33</td></tr>
        <tr><td>M</td><td>37.5″–40.5″</td><td>34</td></tr>
        <tr><td>L</td><td>40.5″–43.5″</td><td>35</td></tr>
        <tr><td>XL</td><td>43.5″–46.5″</td><td>36</td></tr>
      </tbody>
    </table>
  </div>
</dialog>
