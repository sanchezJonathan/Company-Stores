{% include 'top_notification_bar' %}

{% comment %} About only shows once a CMS page titled "About" exists {% endcomment %}
{% assign about_page = pages | where: 'title', 'About' | first %}

<header class="header-container site-header top-0">
  <nav class="site-header-bar" aria-label="Main">
    <div class="site-header-left">
      <button type="button" class="site-header-menu-toggle" aria-controls="header-menu" aria-expanded="false" aria-label="Menu">
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M0 .75h18M0 6h18M0 11.25h18" stroke="#000" stroke-width="1.5"/></svg>
      </button>
      <a href="/products">Shop</a>
      {% if about_page %}<a href="{{ about_page.url }}">About</a>{% endif %}
    </div>

    <a class="site-header-logo" href="/">
      <img src="{{ 'main-logo.svg' | asset_url }}" alt="{{ shop.name }} Design Shop">
    </a>

    <div class="site-header-right">
      {% if authentication_enabled and current_user %}
        <div class="dropdown site-header-account">
          <button class="dropdown-toggle" type="button" id="header-account" data-bs-toggle="dropdown" aria-expanded="false">Account</button>
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="header-account">
            <a class="dropdown-item" href="{{ account_dashboard_url }}">Dashboard</a>
            {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ order_history_url }}">Order History</a>{% endif %}
            <a class="dropdown-item" href="{{ edit_account_url }}">Account Settings</a>
            {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ address_book_url }}">Address Book</a>{% endif %}
            {% if shop.store_enabled? and shop.show_account_balance? %}<a class="dropdown-item" href="{{ account_balance_url }}">{% if shop.points_store? %}Points{% else %}Account{% endif %} Balance: <span>{{ current_user.balance | points_or_currency }}</span></a>{% endif %}
            {% if shop.catalog_enabled? %}{% if shop.custom_logos_upload_enabled? or current_user.logos.size != 0 %}<a class="dropdown-item" href="{{ logos_url }}">Logo</a>{% endif %}{% endif %}
            {% if shop.budget_enabled? and current_user.has_budgets? %}<a class="dropdown-item" href="{{ budget_info_url }}">Budget</a>{% endif %}
            {% if shop.wishlist_enabled? %}<a class="dropdown-item" href="{{ wishlist_url }}">Wishlist ({{ wishlist.line_items_count }})</a>{% endif %}
            <a class="dropdown-item mt-2 border-top" href="{{ logout_url }}">Log Out</a>
          </div>
        </div>
      {% elsif authentication_enabled and shop.show_login? %}
        <a href="{{ login_url }}" class="site-header-account">Log In</a>
      {% endif %}
      {% if shop.catalog_enabled? %}
        <button type="button" class="site-header-search-toggle" aria-controls="header-search" aria-expanded="false">Search</button>
      {% endif %}
      {% if shop.store_enabled? %}
        <a href="{{ cart_url }}" class="view-hide-cart">Bag ( <span id="bag-count">{{ order.cart_items_count | default: 0 }}</span> )</a>
      {% endif %}
    </div>
  </nav>

  {% comment %} Phone menu, opened by the ≡ button {% endcomment %}
  <div class="header-menu" id="header-menu">
    <a href="/products">Shop</a>
    {% if about_page %}<a href="{{ about_page.url }}">About</a>{% endif %}
    {% if shop.catalog_enabled? %}<button type="button" class="site-header-search-toggle">Search</button>{% endif %}
    {% if authentication_enabled and current_user %}
      <a href="{{ account_dashboard_url }}">Account</a>
    {% elsif authentication_enabled and shop.show_login? %}
      <a href="{{ login_url }}">Log In</a>
    {% endif %}
  </div>

  {% if shop.catalog_enabled? %}
    <div class="header-search border-top" id="header-search">
      {% form 'search' %}
        <button type="submit" aria-label="Search">{% include 'icons/search' %}</button>
        <input type="search" name="s[keyword]" id="header-search-input" placeholder="Search product" aria-label="Search product">
        <button type="button" class="header-search-close" aria-label="Close search">{% include 'icons/close' %}</button>
      {% endform %}
    </div>
  {% endif %}
</header>
<div class="cart-drawer-overlay"></div>
<div class="cart-drawer-container hidden">
  <a class="close-cart-drawer">
    <img src="{{ 'close-icon.svg' | asset_url }}"/>
  </a>
  <div class="cart-update-success">
    <div class="message">Cart update message.</div>
    <div class="close-success-notif">+</div>
  </div>
  {% form 'cart' %}
    <div class="shopping-cart" id="shopping-cart">
      {% if order.line_items_count > 0 %}
        <div class="table table-borderless">
          <div class="mb-3">
            <h3 class="fw-bold">YOUR CART</h3>
            <div class="clear-continue-btns mt-3" style="display: none;">
              {% if order.line_items_count > 0 %}
                <button type="button" class="btn primary empty-cart py-2 px-3">Clear Cart</button>
                <span class="px-1">or</span>
              {% endif %}
              {% if order.line_items_count > 0 %}
                <a href="/products" class="btn primary continue-shopping py-2 px-3">Continue shopping</a>
              {% else %}
                <a href="/products" class="btn primary continue-shopping py-2 px-3">Begin shopping</a>
              {% endif %}
            </div>
            <div class="mt-0">
              <div class="cart-headings-container pb-3 border-bottom d-flex justify-content-between" style="display: none !important;">
                <small class="p-0">PRODUCT</small>
                <small class="p-0">TOTAL</small>
              </div>
              {% for line_item in order.line_items %}
                {% include 'drawer_line_item_fields', line_item: line_item %}
              {% endfor %}
            </div>
          </div>
          <div>
            <div class="cart-drawer-subtotal pt-3" style="display: none !important;">
              <h4 class="fw-bold px-0 py-2 mb-0" style="display: none !important;">Estimated total</h4>
              <div class="text-end py-2 pe-0">{{ order.cart_total | points_or_currency }}</div>
              <div class="loader" style="display: none;"></div>
            </div>
          </div>
        </div>
      {% else %}
        <div class="empty_cart_container">
          <h4 class="empty_cart fw-bold mb-4">
            Your Cart is empty
          </h4>
          <a href="/products" class="btn secondary continue-shopping py-2 px-3">Continue shopping</a>
        </div>
      {% endif %}
    </div>
    {% if order.line_items_count > 0 %}
      <div class="cart-checkout-container">
        <div class="cart-more-info mb-3" style="display: none !important;">
          Taxes, discounts and shipping calculated at checkout 
        </div>
        
        
        {% assign cartCount = 0 %}
        {% for line_item in order.line_items %}
          {% assign cartCount = cartCount | plus: line_item.quantity %}
        {% endfor %}

        {% if cartCount == 1 %} 
          <div class="proceed-to-checkout-btn">
            <div class="mt-2 py-0 px-0" style="display: none !important;">
              <a href="{{ cart_url }}" class="btn fw-bold primary px-lg-5">Go to Cart page</a>
            </div>
            <div class="mt-3 py-0 px-0">
              <button type="submit" name="checkout" class="btn fw-bold primary px-lg-5 w-100">CHECK OUT</button>
            </div>
          </div>
    	{% endif %}
        
      </div>
    {% endif %}
  {% endform %}
  <script>
    // Reloads the bag drawer and the Bag ( n ) count from the cart page. Resolves with the new count.
    window.refreshBag = function() {
      return fetch('/cart')
        .then(response => response.text())
        .then(data => {
          const doc = new DOMParser().parseFromString(data, 'text/html');
          const count = doc.querySelector('#bag-count').textContent;
          $('#shopping-cart').replaceWith(doc.querySelector('#shopping-cart').outerHTML);
          $('#shopping-cart-page').replaceWith(doc.querySelector('#shopping-cart-page').outerHTML);
          $('#bag-count').text(count);

          $('.cart-item').find('.item-total-price .loader').hide();
          $('.cart-drawer-subtotal div.loader').hide();
          $('.cart-item').find('.item-total-price-value').show();
          $('.cart-drawer-subtotal div.text-end').show();
          return parseInt(count, 10) || 0;
        });
    };

    $(document).ready(function() {
      function sendData($form) {
        let dataString = $form.serialize();
        return $.ajax({
          type: $form.attr('method'),
          url: $form.attr('action'),
          data: dataString,
          success: function() {
            refreshBag();
          },
          error: function(XMLHttpRequest, textStatus, errorThrown) {   
          } 
        });
      }
      $(".cart-drawer-container form").on( "submit", function(e) {
        if ($('.cart-drawer-container').hasClass('update-cart')) {
          e.preventDefault();
          sendData($(this)).done(function() {
            $('.cart-quantity-container').find('button[type="submit"]').attr('disabled', 'disabled');
            $('.cart-quantity-container').find('button[type="submit"]').addClass('btn-dark');
            $('.cart-quantity-container').find('button[type="submit"]').removeClass('secondary');

          });
          return false;
        }
      });
    });
  </script>
</div>
{% include 'passcode_modal' %}
{% include 'remove_passcode_modal' %}

<script>
  {% if shop.active_multi_storefront? and session_passcode == blank %}
    var groupPasscodeModal = new bootstrap.Modal('#group-passcode-modal');
    $(".site-header-left").append("<a class='group-passcode-button' href='#!' data-bs-toggle='modal' data-bs-target='#group-passcode-modal'>Enter Group Passcode</a>");

    {% if settings.require_user_passcode and session_passcode == blank %}
      groupPasscodeModal.show();
      $("#group-passcode-modal button.btn-close").remove();
    {% endif %}
  {% endif %}

  {% if shop.active_multi_storefront? and session_passcode != blank %}
    var removeGroupPasscodeModal = new bootstrap.Modal('#remove-group-passcode-modal');
    $(".site-header-left").append("<a class='clear-group-passcode-button' href='#!'>{{ settings.clear_button_text }}</a>");
    $(".clear-group-passcode-button").click(function() {
      removeGroupPasscodeModal.show();
    });
  {% endif %}
</script>

<script>
  $('.view-hide-cart').click( function(e) {
    // Phones go straight to the Bag page, no drawer
    if (window.matchMedia('(max-width: 767px)').matches) return;
    e.preventDefault();
    if ($('.cart-drawer-container').is(":hidden")) {
      $('.cart-drawer-overlay').show();
      $('.cart-drawer-container').show();
      $('.cart-drawer-container').removeClass('hidden');
    } else {
      $('.close-cart-drawer').click();
    }
  });
  
  $('.cart-drawer-overlay').click( function() {
    $('.close-cart-drawer').click();
  });
                                  
  $('.close-cart-drawer').click( function() {
    $('.cart-drawer-overlay').hide();
    $('.cart-drawer-container').hide();
    $('.cart-drawer-container').addClass('hidden');
  });

  function toggleHeaderSearch(open) {
    $('#header-search').toggleClass('open', open);
    $('.site-header-search-toggle').attr('aria-expanded', open);
    if (open) $('#header-search-input').focus();
  }

  $('.site-header-search-toggle').click(function() {
    toggleHeaderSearch(!$('#header-search').hasClass('open'));
  });

  $('.header-search-close').click(function() {
    toggleHeaderSearch(false);
  });

  function toggleHeaderMenu(open) {
    $('#header-menu').toggleClass('open', open);
    $('.site-header-menu-toggle').attr('aria-expanded', open);
  }

  $('.site-header-menu-toggle').click(function() {
    toggleHeaderMenu(!$('#header-menu').hasClass('open'));
  });

  $('#header-menu .site-header-search-toggle').click(function() {
    toggleHeaderMenu(false);
  });

  $(document).on('keydown', function(e) {
    if (e.key !== 'Escape') return;
    toggleHeaderMenu(false);
    toggleHeaderSearch(false);
    if (!$('.cart-drawer-container').is(':hidden')) $('.close-cart-drawer').click();
  });
</script>

<!-- Start cart functions -->
<script>
    $(document).on('click', '#shopping-cart .empty-cart', function(e){
      $('.cart-drawer-container').removeClass('update-cart');
      $('.cart-drawer-container').addClass('update-cart');
      $('.cart-item').find('.cart-quantity-container').find('.cart-quantity-input').val(0);
      
      $('.cart-quantity-container button').removeAttr('disabled');
      $('.cart-quantity-container button').click();
    });
    
    $(document).on('mouseover', '#shopping-cart .cart-quantity-container a.plus', function(e){
      var maxoq = $(this).parents('.cart-item').data('product-maxoq');
      const quantityVal = $(this).parent().find('.cart-quantity-input').val();
      if (quantityVal == maxoq) {
        $(this).css('cursor', 'not-allowed');
      }
    });
    
    $(document).on('mouseover', '#shopping-cart .cart-quantity-container a.minus', function(e){
      var minoq = $(this).parents('.cart-item').data('product-minoq');
      const quantityVal = $(this).parent().find('.cart-quantity-input').val();
      if (quantityVal == 1 || quantityVal == minoq) {
        $(this).css('cursor', 'not-allowed');
      }
    });
    
    $(document).on('click', '#shopping-cart .cart-quantity-container a', function(e){
      $('.cart-drawer-container').removeClass('update-cart');
      $('.cart-drawer-container').addClass('update-cart');
      
      var quantityIncrement = $(this).parents('.cart-item').data('product-internalid');
      var minoq = $(this).parents('.cart-item').data('product-minoq');
      var maxoq = $(this).parents('.cart-item').data('product-maxoq');
      var id = $(this).parents('.cart-quantity-container').find('input').attr("id");
      var newQuantity = $(this).siblings('input').val();
      
      if ($(this).hasClass('plus')) {
        if (maxoq == "") {
          if ((quantityIncrement != 0) && (quantityIncrement > 1)) {
            $(this).siblings('input').val(parseInt(newQuantity) + quantityIncrement);
          } else {
            $(this).siblings('input').val(parseInt(newQuantity) + 1);
          }
          
          $(this).parents('.cart-item').find('.item-total-price-value').hide();
          $('.cart-drawer-subtotal div.text-end').hide();
          $(this).parents('.cart-item').find('.item-total-price .loader').show();
          $('.cart-drawer-subtotal div.loader').show();

          $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
          $('.cart-quantity-container button').click();
        } else if (newQuantity < maxoq) {
           if ((quantityIncrement != 0) && (quantityIncrement > 1)) {
            $(this).siblings('input').val(parseInt(newQuantity) + quantityIncrement);
          } else {
            $(this).siblings('input').val(parseInt(newQuantity) + 1);
          }
          
          $(this).parents('.cart-item').find('.item-total-price-value').hide();
          $('.cart-drawer-subtotal div.text-end').hide();
          $(this).parents('.cart-item').find('.item-total-price .loader').show();
          $('.cart-drawer-subtotal div.loader').show();

          $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
          $('.cart-quantity-container button').click();
        } else {
          $(this).parents('.item-description').find('.custom-moq-error span').text('Item "' + $(this).parents('.cart-item').data('product-name') + '" allows a maximum order of ' + maxoq);
          $(this).parents('.item-description').find('.custom-moq-error').show();
          $('.small-quantity-container').find('button[type="submit"]').attr('disabled', 'disabled');
        }
      }

      if ($(this).hasClass('minus')) {
        if (minoq == "") {
          if (newQuantity > 1) {
            if ((quantityIncrement != 0) && (quantityIncrement > 1)) {
              $(this).siblings('input').val(parseInt(newQuantity) - quantityIncrement);
            } else {
              $(this).siblings('input').val(parseInt(newQuantity) - 1);
            }
            
            $(this).parents('.cart-item').find('.item-total-price-value').hide();
            $('.cart-drawer-subtotal div.text-end').hide();
            $(this).parents('.cart-item').find('.item-total-price .loader').show();
            $('.cart-drawer-subtotal div.loader').show();

            $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
            $('.cart-quantity-container button').click();
          }
        } else if (newQuantity > minoq) {
          if ((quantityIncrement != 0) && (quantityIncrement > 1)) {
            $(this).siblings('input').val(parseInt(newQuantity) - quantityIncrement);
          } else {
            $(this).siblings('input').val(parseInt(newQuantity) - 1);
          }

          $(this).parents('.cart-item').find('.item-total-price-value').hide();
          $('.cart-drawer-subtotal div.text-end').hide();
          $(this).parents('.cart-item').find('.item-total-price .loader').show();
          $('.cart-drawer-subtotal div.loader').show();

          $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
          $('.cart-quantity-container button').click();
        } else {
          $(this).parents('.item-description').find('.custom-moq-error span').text('Item "' + $(this).parents('.cart-item').data('product-name') + '" allows a minimum order of ' + minoq);
          $(this).parents('.item-description').find('.custom-moq-error').show();
          $('.small-quantity-container').find('button[type="submit"]').attr('disabled', 'disabled');
        }
      }
    });
    
    $(document).on('click', '#shopping-cart .remove-cart-item', function(e){
      $('.cart-checkout-container').hide();
      $('#shopping-cart button.remove-cart-item').hide();
      $('#shopping-cart .loader').show();
      $('.cart-drawer-container').removeClass('update-cart');
      $('.cart-drawer-container').addClass('update-cart');
      $(this).parents('.cart-item').find('.cart-quantity-container').find('.cart-quantity-input').val(0);
      
      $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
      $('.cart-quantity-container button').click();
      location.reload();
    });
    
    $('.proceed-to-checkout-btn button').click( function() {
      $('.cart-drawer-container').removeClass('update-cart');
    });
</script>
<!-- End cart functions -->

