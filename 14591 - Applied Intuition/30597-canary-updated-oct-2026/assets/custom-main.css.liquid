/*-------------------
This theme uses Bootstrap v5.1.

It is highly recommended to check out Bootstrap's guiding principles,
strategies, and techniques at https://getbootstrap.com/docs/5.1/extend/approach/
before adding custom styling.

To learn more about Bootstrap v5.1, please check
out https://getbootstrap.com/docs/5.1/getting-started/introduction/.
/*-------------------*/

/*-------------------*/
/* GENERAL */
/*-------------------*/
* {
  font-family: 'Applied Sans Display', sans-serif !important;
}
.fa, .fas {
    Font-family: 'Font Awesome 5 Free' !important;
}
.btn.secondary, .btn.primary, .out-of-stock-notification button, .out-of-stock-notification button:hover {
  border-radius: 0;
  padding: 5px 40px; 
}
* {
  line-height: 1.3;
}
#page-showing table {
  max-width: 680px;
  margin: auto;
}
#page-showing table ul {
  margin-bottom: 17px;
}
#page-showing table ul li {
  line-height: 1 !important;
  margin-bottom: -1px;
}
#page-showing table td p {
  margin-bottom: -2px;
}
.content-container > .container-fluid {
  padding: 0 !important;
  border-left: 1px solid #BDC1CA;
  border-right: 1px solid #BDC1CA;
  margin: 0 30px;
  max-width: calc(100% - 60px);
  min-height: calc(100vh - 60px);
}
.content-container.no-content > .container-fluid {
  min-height: 0;
}
.modal.lightbox .modal-dialog {
  max-width: 90%;
}
.ratio-16x9 {
  --bs-aspect-ratio: 100%;
}
.border, .border-start, .border-end, .border-top, .border-bottom {
  border-color: #BDC1CA !important;
}
/* Home runs edge to edge, no side borders */
.content-container.home {
  margin: 0 !important;
  max-width: none;
  background-color: #F5F5F7;
}
.content-container.home > .container-fluid {
  min-height: 0 !important;
  margin: 0 !important;
  max-width: none;
  border: 0;
}
.notification-container {
  padding: 10px 16px !important;
}
.two-xl {
  display: list-item;
}
/*-------------------*/
/* TOP NAV */
/*-------------------*/
.navbar-container ul.nav > li > a {
  margin: 14px 0px 14px 40px;
}
/*-------------------*/
/* HEADER */
/*-------------------*/
.site-header {
  position: sticky;
  background-color: #E7E7E7;
  border-bottom: 1px solid #424242;
}
.site-header-bar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: stretch;
  height: 60px;
  /* Inner shadow from the mockup, darker on top than bottom */
  box-shadow: inset 0 26px 26px -22px rgba(0, 0, 0, .28), inset 0 -26px 26px -22px rgba(0, 0, 0, .18);
}
.site-header a, .site-header button {
  color: #000;
  font-size: 16px;
  text-decoration: none;
  background: none;
  border: 0;
  padding: 0;
}
.site-header a:hover, .site-header button:hover {
  opacity: .6;
}
.site-header-left, .site-header-right {
  display: flex;
  align-items: center;
}
.site-header-left > a {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 22px;
}
/* Divider between Shop and About goes full height */
.site-header-left > a:first-of-type {
  border-right: 1px solid #737373;
}
.site-header-menu-toggle, .header-menu {
  display: none;
}
.site-header-right {
  justify-content: flex-end;
  gap: 40px;
  padding: 0 22px;
}
.site-header-logo {
  display: flex;
  align-items: center;
}
.site-header-logo img {
  height: 25px;
}
.site-header .dropdown-toggle::after {
  display: none;
}
.header-search {
  display: none;
  padding: 0 22px;
}
.header-search.open {
  display: block;
  animation: header-search-fade .2s ease-out;
}
/* ID beats the old 250px .search-form cap in default-main */
#header-search form {
  max-width: none;
  display: flex;
  align-items: center;
  gap: 14px;
  height: 56px;
}
.header-search input {
  flex: 1;
  border: 0;
  outline: 0;
  font-size: 16px;
  background: transparent;
}
.header-search svg {
  width: 16px;
  height: 16px;
  fill: #000;
  stroke: #000;
}
@keyframes header-search-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* Phones: ≡ menu on the left, only Bag on the right */
@media screen and (max-width: 767px) {
  .site-header-bar {
    height: 52px;
    box-shadow: inset 0 -30px 30px -26px rgba(0, 0, 0, .25);
  }
  .site-header a, .site-header button {
    font-size: 14px;
  }
  .site-header-left {
    padding: 0 12px;
  }
  .site-header-left > a, .site-header-right > .site-header-account, .site-header-right > .site-header-search-toggle {
    display: none;
  }
  .site-header-menu-toggle {
    display: flex;
  }
  .site-header-right {
    padding: 0 12px;
  }
  .header-menu.open {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px 12px;
    border-top: 1px solid #737373;
    animation: header-search-fade .2s ease-out;
  }
  .header-menu > * {
    text-align: left;
  }
  .header-search {
    padding: 0 12px;
  }
}
.content-container .container-fluid > nav {
  padding: 40px 40px 0px 40px;
  display: none;
}
.content-container .container-fluid > nav ol {
  margin: 0;
}
/*-------------------*/
/* CART DRAWER */
/*-------------------*/
.cart-drawer-overlay {
  position: fixed;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, .2);
  backdrop-filter: blur(8px);
  z-index: 1000;
  top: 0;
  left: 0;
  display: none;
}
.cart-drawer-container {
  position: fixed;
  right: 0;
  top: 0;
  background-color: #fff;
  z-index: 1000;
  padding: 0;
  border-left: none;
  overflow-y: scroll;
  height: 100vh;
  width: 100%;
  transition: .3s;
  display: none;
  max-width: 650px;
}
.cart-drawer-container.hidden {
  right: -400px;
}
.cart-update-success, .product-add-success {
  display: none;
  background-color: {{ settings.notif_success_bg_color }};
  color: #fff;
  padding: 12px 41px 12px 14px;
  position: fixed;
  width: 375px;
  right: 0px;
  top: 12px;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
  height: 46px;
}
.close-success-notif {
  transform: rotate(45deg);
  font-size: 32px;
  line-height: 1;
  color: #fff;
  position: absolute;
  top: 6px;
  right: 20px;
  cursor: pointer;
  display: none;
}
.clear-continue-btns {
  display: flex;
  align-items: flex-start;
}
.cart-drawer-container #edit_website_order {
  min-height: 100%;
}
#shopping-cart {
  min-height: calc(100vh - 197px);
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #BDC1CA;
}
.empty_cart_container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: auto;
}
.cart-drawer-container .shopping-cart .table {
  justify-content: space-between;
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  min-height: calc(100vh - 197px);
  margin: 0;
}
.cart-drawer-container .shopping-cart .table > div {
  width: 100%;
}
.cart-drawer-container .shopping-cart .table > div:last-child {
  max-height: 210px;
}
#edit_website_order h3 {
  font-size: 36px;
  padding: 25px 25px;
  margin: 0 !important;
  border-bottom: 1px solid #BDC1CA;
  font-weight: 500 !important;
}
.close-cart-drawer {
  position: absolute;
  cursor: pointer;
  right: 30px;
  top: 30px;
}
.close-cart-drawer img {
  width: 21px;
  height: 21px;
}
.clear-continue-btns span {
  font-size: 15px;
  padding: 5px 10px !important;
}
.clear-continue-btns .btn.primary {
  width: calc(50% - 16px);
  padding: 6px 4px !important;
  border-width: 1px;
  font-size: 15px;
}
.cart-headings-container {
  padding: 10px 0 15px !important;
}
.cart-headings-container small {
  font-size: 11px;
}
.cart-drawer-container .cart-item, .cart-drawer-container .cart-item:last-of-type {
  padding: 0;
  box-shadow: none;
  border-bottom: 1px solid #BDC1CA !important;
}
.cart-item {
  padding: 0;
}
.shopping-cart tr th:nth-child(3) {
  width: 22%;
}
.cart-item .item-image {
  overflow: hidden;
  width: 100%;
  padding: 30px !important;
  margin: 0;
  min-width: 80px;
  border-right: 1px solid #BDC1CA !important;
}
.cart-item .item-image img {
  width: 100%;
  height: auto;
}
.cart-drawer-container .cart-item .item-description {
  max-width: 50%;
  padding: 40px 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cart-drawer-container .cart-item .item-description > * {
  width: 100%;
}
.cart-drawer-container .cart-item .item-description * {
  font-size: 24px;
  margin-bottom: 0 !important;
}
.cart-drawer-container .cart-item .item-description h4 {
  line-height: 1.4;
  margin-bottom: 12px !important;
  font-weight: 600 !important;
  font-size: 28px;
}
.cart-item .item-description .error {
  max-width: 70%;
  display: block;
  font-size: 15px;
}
.cart-inline-title-short {
  min-width: auto;
  display: inline-block;
  margin-right: 5px;
  font-weight: 600;
}
.item-total-price {
  font-size: 17px;
  color: #192555;
  text-align: right;
  justify-content: end;
  display: flex;
  width: 80px;
}
.total-price-container {
  margin-left: auto;
}
.cart-quantity-container {
  display: flex;
}
.cart-quantity {
  display: flex;
  border: 1px solid #727a98;
  align-items: center;
}
.cart-quantity-container a {
  height: 46px;
  width: 46px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  font-size: 22px;
  cursor: pointer;
  color: #4b5168;
  line-height: 1;
  padding-bottom: 1px;
}

.cart-quantity-container a img {
  width: 10px;
  height: 10px;
}
.small-quantity-container {
  display: flex;
  align-items: center;
}
.small-quantity-container button {
  padding: 10px;
  line-height: 1;
  height: fit-content;
}
.item-description button.remove-cart-item {
  padding: 10px;
}
.item-description button.remove-cart-item img {
  width: 15px;
  height: 15px;
  align-items: center;
}
.cart-drawer-subtotal {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #dee2e6;
}
.cart-drawer-subtotal div {
  padding: 15px 0;
  font-size: 18px;
}
.proceed-to-checkout-btn a, .proceed-to-checkout-btn button {
  width: 100%;
  padding: 10px;
}
.cart-quantity-discounts {
  padding: 0;
  list-style: none;
  margin: 20px 0 5px;
}
.cart-quantity-discounts h5 {
  font-size: 14px;
  font-weight: bold;
}
.cart-quantity-discounts li span {
  width: 100px;
  display: inline-block;
  border: 1px solid #eee;
  padding: 0px 6px;
}
/*-------------------*/
form .form-control.cart-quantity-input, form .form-control.cart-quantity-input:hover, form .form-control.cart-quantity-input:focus {
  border: none;
  margin: 0;
  background-color: transparent;
  padding: 11px 11px !important;
  width: 56px;
  text-align: center;
  font-size: 16px;
  border: none !important;
  box-shadow: none !important;
}
.custom-moq-error {
  display: none;
}
.cart-quantity-input::-webkit-outer-spin-button, .cart-quantity-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
}
.cart-quantity-input[type=number] {
  -moz-appearance: textfield;
  -webkit-appearance: textfield;
  appearance: textfield;
  cursor: default;
  pointer-events: none;
}
.cart-drawer-subtotal h4 {
  font-size: 17px;
}
.cart-more-info {
  font-size: 14px;
}
.loader {
  width: 26px;
  padding: 3px !important;
  aspect-ratio: 1;
  border-radius: 50%;
  margin: 0 9px;
  background: #192555 !important;
  --_m: 
    conic-gradient(#0000 0%,#000), linear-gradient(#000 0 0) content-box;
  -webkit-mask: var(--_m);
          mask: var(--_m);
  -webkit-mask-composite: source-out;
          mask-composite: subtract;
  animation: l3 1s infinite linear;
  box-shadow: none !important;
  border: none !important;
  height: 26px;
}
@keyframes l3 {to{transform: rotate(1turn)}}

.cart-checkout-container .btn.primary {
  border-radius: 0;
  padding: 24px 20px 27px;
  text-transform: uppercase;
  font-size: 24px;
  font-weight: normal !important;
}
#shopping-cart-page .item-description {
  padding: 0 30px;
}
#shopping-cart-page .cart-item .item-image {
  border: none !important;
  max-width: 300px;
}
#shopping-cart-page .item-description * {
  font-size: 20px;
}
#shopping-cart-page .item-description .fw-bold {
  margin-bottom: 10px !important;
}
/*-------------------*/
/* CATEGORY NAV */
/*-------------------*/

/*-------------------*/
/* CONTENT */
/*-------------------*/

#page-showing {
  padding: 40px;
}
.content-container.no-content {
  margin: 0 !important;
}
.banner-text-button {
  position: absolute;
  bottom: 3rem;
  max-height: 170px;
}
.banner-caption-wrapper {
  max-width: {{ settings.site_width }};
  margin: auto;
  padding: 0 3.5rem !important;
  position: relative;
  bottom: 12rem;
  width: 100%;
  max-height: 100vh;
}
@media screen and (max-width: 1400px) {
  .banner-caption-wrapper {
    position: absolute;
    left: 0;
    bottom: 0;
  }
}
.homepage-carousel-container .carousel-item > a {
  max-height: 100vh;
  display: flex !important;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}
.carousel-inner {
  overflow-x: hidden;
  overflow-y: visible;
}

.content-container {
  min-height: 0;
  margin: auto !important;
}
.content-container > .container-fluid > div.mt-5 {
  margin: 0 !important;
  padding: 40px 0;
  min-height: calc(100vh - 57px);
}
#content.content-page h1 {
  margin: 0;
  padding: 20px 0 0;
}
/*.homepage-carousel-container {
  margin-top: 20px;
}*/

.featured-products h2 {
  font-size: 28px;
  text-align: left !important;
  margin-bottom: 20px;
}
.featured-products .product-list {
  justify-content: flex-start;
}
.featured-products .product-thumbnail {
  width: calc((100% - 160px) / 4) !important;
}

.home-categories {
  display: flex;
  justify-content: space-between;
  padding: 24px 20px;
}
.home-categories a {
  color: #000;
  font-size: 16px;
  text-transform: uppercase;
  text-decoration: underline;
}
.home-heading {
  margin: 0;
  padding: 70px 20px 90px;
  font-size: 56px;
  font-weight: 500;
  line-height: 1.1;
  text-align: center;
}
@media screen and (max-width: 767px) {
  /* Phones skip the category row, per the mobile mockup */
  .home-categories {
    display: none;
  }
  .home-heading {
    padding: 60px 12px;
    font-size: 32px;
  }
}
.homepage-boxes-container {
  margin-top: 0;
}
.homepage-boxes-container h2 {
  margin-bottom: 20px;
}
.homepage-boxes {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
}
/* Home grid: banner + product pair per row, flipping sides every other row */
.grid-box {
  display: flex;
}
.grid-box:nth-child(even) {
  flex-direction: row-reverse;
}
.grid-box-banner, .grid-box-feature {
  position: relative;
  width: 50%;
  aspect-ratio: 960 / 875;
  overflow: hidden;
}
.grid-box-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: filter .3s;
}
.grid-box-banner-link {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 60px;
  font-weight: 500;
  text-decoration: none;
  opacity: 0;
  transition: opacity .3s;
}
.grid-box-banner:hover img, .grid-box-banner:focus-within img {
  filter: blur(24px);
}
.grid-box-banner:hover .grid-box-banner-link, .grid-box-banner:focus-within .grid-box-banner-link {
  opacity: 1;
}
.grid-box-banner-link:hover {
  color: #fff;
}
.grid-box-feature {
  background-color: #E3E5ED;
}
/* Label row floats over the product photos */
.grid-box-feature-head {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  padding: 26px 20px;
  font-size: 16px;
}
.grid-box-feature-head a {
  color: #000;
  text-decoration: underline;
}
/* Product images are exported as half-tile frames (480x875), so each one just fills its half */
.grid-box-products {
  display: flex;
  height: 100%;
}
.grid-box-product {
  position: relative;
  width: 50%;
}
.grid-box-product img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity .15s ease-out;
}
/* Back view sits on top and fades in on hover */
.grid-box-product-hover {
  position: absolute;
  inset: 0;
  opacity: 0;
}
.grid-box-product:hover .grid-box-product-hover {
  opacity: 1;
}
@media screen and (max-width: 767px) {
  .grid-box, .grid-box:nth-child(even) {
    flex-direction: column;
  }
  .grid-box-banner, .grid-box-feature {
    width: 100%;
  }
  /* No hover on phones, so the name always shows over a sharp photo */
  .grid-box-banner-link {
    opacity: 1;
    font-size: 32px;
  }
  .grid-box-banner:hover img {
    filter: none;
  }
  .grid-box-feature-head {
    padding: 16px 12px;
    font-size: 14px;
  }
}
.carousel-item, .carousel-item.active {
  /* display: flex; */
  align-items: center;
}
.carousel-caption {
  top: auto !important;
  text-align: left;
  justify-content: start !important;
  align-items: start !important;
  max-width: 100%;
  margin: auto;
  padding: 0 48px !important;
  position: absolute;
  bottom: 48px;
  width: 100%;
  max-height: 100vh;
  left: 0 !important;
  right: auto;
  transform: none !important;
}
.carousel-caption-header {
  font-size: 60px;
  font-weight: 500;
  letter-spacing: -1px;
  margin-bottom: 24px;
  line-height: 1;
}
.carousel-caption .btn.primary {
  background-color: #FFF;
  color: #000;
  font-size: 20px !important;
  border-radius: 30px;
  border-color: #fff;
  padding: 14px 22px !important;
  line-height: 1;
}
.sso-link {
  color: #0B5CFF;
}

.homepage-bottom-banners {
  margin-top: 3rem;
  margin-bottom: 3rem;
  position: relative;
  width: 100%;
}
.homepage-bottom-banners img {
  width: 100%;
  height: auto;
}
.homepage-bottom-banners p {
  font-size: 30px;
  font-weight: 500;
  color: #0F1B5D;
  margin-bottom: 5px;
}
.homepage-bottom-banners a.btn.secondary {
  padding: 8px 35px 6px;
  color: #FFF;
  margin-top: 8px;
  border: none;
  background-color: #00acd2;
}
/*.homepage-bottom-banners a {
  transition: 0.3s;
}
.homepage-bottom-banners a:hover {
  scale: 1.15;
}*/

/*-------------------*/
/* PRODUCT THUMBS */
/*-------------------*/
.product-list {
  gap: 30px;
}
.product-thumbnail {
  margin: 0 !important;
  padding: 0 0 1rem 0;
}
.product-thumbnail .thumbnail-img-container a {
  justify-content: center;
  overflow: hidden;
}
.featured-products .product-thumbnail .thumbnail-img-container, .featured-products .product-thumbnail .thumbnail-img-container a {
  min-height: 350px;
}
.thumbnail-img-container {
  border-radius: 20px !important;
}
.product-thumbnail .thumbnail-img-container img {
  height: 530px;
  width: auto;
  max-width: none;
  margin: auto;
}
.featured-products .product-thumbnail .thumbnail-img-container img {
  width: 100%;
  height: auto;
}
.product-thumbnail .thumbnail-description-container a h5 {
  font-size: 18px;
}
/*-------------------*/
/* PRODUCTS/CATEGORY */
/*-------------------*/
.products-page {
  padding-bottom: 40px;
}
.category-bar {
  display: flex;
  align-items: center;
  gap: 20px;
  height: 58px;
  padding: 0 20px;
  background-color: #BEC3CC;
  border-bottom: 1px solid #424242;
}
.category-link {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #000;
  font-size: 16px;
  text-decoration: none;
}
.category-link::before {
  content: '';
  width: 15px;
  height: 15px;
  border: 1px solid #000;
}
.category-link.active::before {
  background-color: #000;
}
.category-link:hover {
  color: #000;
  opacity: .6;
}
.search-row {
  padding: 20px;
  font-size: 16px;
}
.section-title {
  margin: 0;
  padding: 26px 20px;
  font-size: 36px;
  text-align: center;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px 10px;
  padding: 0 19px;
}
