{% assign search_keyword = '' %}
{% keyword_facets %}
  {% for keyword in keywords.collection %}
    {% assign search_keyword = keyword.text %}
  {% endfor %}
{% endkeyword_facets %}

<div id="content" class="products-page">
  {% paginate products_search by 200 %}
    {% if search_keyword != blank %}
      <div class="search-row{% if products_search.size == 0 %} border-bottom{% endif %}">
        {% if products_search.size == 0 %}
          No Results for &ldquo;{{ search_keyword | escape }}&rdquo;
        {% else %}
          Results for &ldquo;{{ search_keyword | escape }}&rdquo; ({{ products_search.total }} {% if products_search.total == 1 %}Item{% else %}Items{% endif %})
        {% endif %}
      </div>
    {% else %}
      <nav class="category-bar" aria-label="Categories">
        {% for category in categories %}
          {% if category.parent_id == blank %}
            <a class="category-link{% if category.selected? %} active{% endif %}"
              href="{% if category.selected? %}/products{% else %}/products?s%5Bf%5D%5Bc%5D%5B%5D={{ '/' | append: category.name | url_encode }}{% endif %}"
              {% if category.selected? %}aria-current="page"{% endif %}>{{ category.name }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    {% if products_search.size > 0 %}
      <div class="product-grid">
        {% for product in products_search %}
          {% render 'basic_product', product: product %}
        {% endfor %}
      </div>
      {% render 'paginator', paginate: paginate %}
    {% else %}
      <h2 class="section-title">Items that Might Interest You</h2>
      {% assign suggestions = featured_products %}
      {% if suggestions.size == 0 %}{% assign suggestions = products %}{% endif %}
      <div class="product-grid">
        {% for product in suggestions limit: 4 %}
          {% render 'basic_product', product: product %}
        {% endfor %}
      </div>
    {% endif %}
  {% endpaginate %}
</div>
