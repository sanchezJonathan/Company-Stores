<div class="cart-page mt-5">
  {% form 'cart' %}
    <div class="mb-3 mb-md-0">
      <h1 class="d-inline-block">
        YOUR CART
      </h1>
	  {% comment %}
      <div class="float-md-end page-clear-continue-btns">
        {% if order.line_items_count > 0 %}
          <a href="#" class="btn primary empty-cart py-2 px-3">Clear Cart</a>
          <span class="px-1">or</span>
        {% endif %}

        {% assign most_recently_viewed_product = recently_viewed_products.first %}

        {% if most_recently_viewed_product %}
          <a href="{{ most_recently_viewed_product | product_url }}" class="btn btn_2 continue-shopping custom-button primary py-2 px-3">Continue Shopping</a>
        {% else %}
          <a href="/products" class="btn primary py-2 px-3">Continue Shopping</a>
        {% endif %}
      </div>
	  {% endcomment %}
  	</div>

    <div class="shopping-cart" id="shopping-cart-page">
      {% if order.line_items_count > 0 %}
        <table class="table table-borderless">
	  	  {% comment %}
          <thead>
            <tr>
              <th scope="col" class="ps-0 h4 fw-bolder d-none d-lg-table-cell border-bottom ps-3">Item Details</th>
              <th scope="col" class="h4 fw-bolder d-none d-lg-table-cell border-bottom">Price</th>
              <th scope="col" class="h4 fw-bolder d-none d-lg-table-cell border-bottom">Quantity</th>
              <th scope="col" class="h4 fw text-end pe-0 d-none d-lg-table-cell border-bottom pe-3">Total</th>
            </tr>
          </thead>
	  	  {% endcomment %}
          <tbody>
            {% for line_item in order.line_items %}
              {% include 'line_item_fields', line_item: line_item %}
            {% endfor %}
          </tbody>
          <tfoot>
  			{% comment %}
            <tr class="d-none d-lg-table-row">
              <td></td>
              <td></td>
              <td class="cart-drawer-subtotal"><h4 class="fw-bold px-0 py-2 mb-0">Estimated Total ({{ order.cart_items_count | pluralize: 'item', 'items' }})</h4></td>
              <td class="cart-subtotal cart-page-subtotal fw-bolder text-end pe-0">
                <span>{{ order.cart_total | points_or_currency }}</span>
                <div class="loader" style="display: none;"></div>
              </td>
              
            </tr>
  			{% endcomment %}
            <tr class="d-none d-lg-table-row">
              <td colspan="4" class="text-end pt-3 px-0">
                <button type="submit" name="checkout" class="btn fw-bold secondary px-lg-5">CHECK OUT</button>
              </td>
            </tr>
          </tfoot>
        </table>
      
        <div class="zip-input">
          <!--
          <label>enter your zip code for updated shipping rates</label>
          <input type="text" class="custom-input-text clearHint with-hint" value="zip" rel="zip"/>
          -->
        </div>
      {% else %}
        <p class="empty_cart">
          Your cart is empty
        </p>
      {% endif %}
    </div>
  {% endform %}
</div>

<script>
  $("#qa-checkout-button").click(function() {
    $('.cart-page #shopping-cart-page button[name="checkout"]').click();
  });
  
  $(".cart-quantity-decoy").change(function() {
    var id = $(this).attr("id");
    
    /*if (+$(this).attr("data-max-quantity") < $(this).val()) {
      $(this).addClass("is-invalid")
      return;
    }*/
    
    $(this).removeClass("is-invalid")
  	$(this).closest('td').find('button[type="submit"]').removeAttr('disabled');
    $(this).closest('td').find('button[type="submit"]').removeClass('btn-dark');
    $(this).closest('td').find('button[type="submit"]').addClass('secondary');
    $('input[name="line_items['+ id +'][quantity]"]').val($(this).val());
  });
  
  $(".cart-quantity-input").change(function() {
    var id = $(this).attr("id");
    
    /*if (+$(this).attr("data-max-quantity") < $(this).val()) {
      $(this).addClass("is-invalid")
      return;
    } */
    
    $(this).removeClass("is-invalid")
    $(this).closest('td').find('button[type="submit"]').removeAttr('disabled');
    $(this).closest('td').find('button[type="submit"]').removeClass('btn-dark');
    $(this).closest('td').find('button[type="submit"]').addClass('secondary');
  })
</script>


<script>
  $(document).on('mouseover', '#shopping-cart-page .cart-quantity-container a.plus', function(e){
    var maxoq = $(this).parents('.cart-item').data('product-maxoq');
    var quantityVal = $(this).siblings('input').val();
    if (quantityVal == maxoq) {
      $(this).css('cursor', 'not-allowed');
    }
  });

  $(document).on('mouseover', '#shopping-cart-page .cart-quantity-container a.minus', function(e){
    var minoq = $(this).parents('.cart-item').data('product-minoq');
    var quantityVal = $(this).siblings('input').val();
    if (quantityVal == 1 || quantityVal == minoq) {
      $(this).css('cursor', 'not-allowed');
    }
  });
  
  $(document).on('click', '#shopping-cart-page .cart-quantity-container a.plus', function(e){
    $(this).siblings('.cart-quantity-input').val(parseInt($(this).siblings('.cart-quantity-input').val()) + 1);
    $(this).parents('.cart-quantity-container').find('button').removeAttr('disabled');
    $(this).parents('.cart-quantity-container').find('button').click();
  });
  
  $(document).on('click', '#shopping-cart-page .cart-quantity-container a.minus', function(e){
    $(this).siblings('.cart-quantity-input').val(parseInt($(this).siblings('.cart-quantity-input').val()) - 1);
    $(this).parents('.cart-quantity-container').find('button').removeAttr('disabled');
    $(this).parents('.cart-quantity-container').find('button').click();
  });
  
  
  
  $(document).on('click', '#shopping-cart-page .remove-cart-item', function(e){
    $('.cart-drawer-container').removeClass('update-cart');
    $('.cart-drawer-container').addClass('update-cart');
    $(this).parents('.cart-item').find('.cart-quantity-container').find('.cart-quantity-input').val(0);

    $(this).parents('.small-quantity-container').find('button[type="submit"]').removeAttr('disabled');
    $('.cart-quantity-container button').click();
  });
</script>