  "{{ wishlist_url }}" : function() { $("a.quick-nav-link:contains(Wishlist)").addClass("active") },
}
activeQuickNavMap[window.location.pathname] && activeQuickNavMap[window.location.pathname]();

$("form.search-form").addClass("mx-auto my-2 my-lg-0 {% if settings.nav_links_position != "top_bar" %}mx-auto{% endif %}");

$("#mobile-slider-button").click(function() {
  $(this).find("span").toggle();
  $(".mobile-slider").toggle();
  $(".mobile-slider-overlay").toggle();
});

$(".mobile-slider-overlay").click(function() {
  $("#mobile-slider-button").click();
});

$("#search-modal").on('shown.bs.modal', function() {
  $(".popup-search").focus();
});

{% if settings.nav_links_position == "bottom_bar" or settings.category_links_position == "bottom_bar" %}
if ($(".category-container ul.header-links li").length < 1) {
  $(".category-container").remove();
}

{% if settings.current_theme == "stylistic" %}
    var ccLinksOffset = [];
    $(".category-container ul.navbar-nav > li > a").each(function() {
      if (!ccLinksOffset.includes($(this).offset().top)) {
        ccLinksOffset.push($(this).offset().top);
      }
    });

    ccLinksOffset.pop();
    $(".category-container ul.navbar-nav > li > a").each(function() {
      var isNotInLastRow = ccLinksOffset.includes($(this).offset().top) || ccLinksOffset.includes($(this).offset().top - 1);
      if (isNotInLastRow) {
        $(this).css("border-bottom", "1px solid #dee2e6");
      }
    });
  {% endif %}
{% endif %}

var specialRequestsMenu = $('.category-container .categories .nav-item.dropdown').filter(function () {
    return $(this).children('a.nav-link').text().trim() === 'Special Requests (Ad-Hoc Projects)';
});

var dropdownMenu = specialRequestsMenu.children('ul.dropdown-menu');

// Remove the default "All Special Requests" link
dropdownMenu.find('a.all-link').parent().remove();

// Remove previously added custom links to prevent duplicates
dropdownMenu.children('li').has('a[href="/pages/83640"]').remove();
dropdownMenu.children('li').has('a[href="/pages/86659"]').remove();

// Add the custom links in the desired order
dropdownMenu.prepend('<li><a class="dropdown-item" href="/pages/86659">Gift Certificates</a></li>');
dropdownMenu.prepend('<li><a class="dropdown-item" href="/pages/83640">Special Requests</a></li>');

