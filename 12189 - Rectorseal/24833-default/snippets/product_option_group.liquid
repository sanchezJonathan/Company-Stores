<div class="product-option-group">
  <label class="group-title mb-2">{{ product_option_group.name }}</label>
  <div class="product-option-container {% if product_option_group.wrap_options? %}wrap-options{% endif %}">
    {% include 'product_option' with product_option_group.product_options %}
  </div>
</div>

{% if product_option.friendly_name contains "Size" %}
  <div class="product-options-wrapper-qd-sc" style="display: none;"></div>
{% endif %}