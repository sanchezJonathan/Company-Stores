<div class="mobile-header-actions d-lg-none">
  {% if shop.store_enabled? %}
    <a class="cart-link-wrapper" href="{{ cart_url }}" aria-label="Cart">
      {% include 'icons/cart' %}
      <span class="cart-badge-custom">{{ order.line_items_count }}</span>
    </a>
  {% endif %}
  
  {% if shop.catalog_enabled? %}
    <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#search-modal" aria-label="Search">
      {% include 'icons/search' %}
    </button>
  {% endif %}
</div>

<div class="collapse navbar-collapse headerLinks d-none d-lg-block">
  {% if current_user and shop.store_enabled? and shop.show_account_balance? %}
    <a class="merch-points-balance" href="{{ account_balance_url }}">{% include 'icons/dino-claw' %}{% include 'price', price_value: current_user.balance %} Merch Points</a>
  {% endif %}
  <div class="desktop-icons-container">
    {% if settings.nav_links_position == "top_bar" %}
      {% if shop.catalog_enabled? %}
        {% form 'search' %}
          <div class="input-group">
            <input class="form-control border border-right-0" type="search" name="s[keyword]" id="s_keyword" placeholder="Search" aria-label="Search">
            <div class="input-group-append">
              <button class="btn btn-outline border border-start-0 search-btn" type="submit"><i class="fa fa-search"></i></button>
            </div>
          </div>
        {% endform %}
      {% endif %}
    {% else %}
      <div class="header-icons d-flex align-items-center">
        {% if shop.catalog_enabled? %}
          <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#search-modal">{% include 'icons/search' %}</button>
        {% endif %}
        
        {% if shop.primary_phone != blank and settings.show_phone %}
          <a href="tel:{{ shop.primary_phone }}" class="px-2">{% include 'icons/phone' %}</a>
        {% endif %}

        {% if authentication_enabled %}
          {% if current_user or shop.show_login? or shop.show_registration? %}
            <div class="dropdown">
              <button class="btn dropdown-toggle" type="button" id="inline-link-profile" data-bs-toggle="dropdown" aria-expanded="false">
                {% include 'icons/profile' %}
              </button>
              <div class="dropdown-menu dropdown-menu-lg-end" aria-labelledby="inline-link-profile">
                {% if current_user %}
                  {% if shop.store_enabled? and shop.show_account_balance? %}
                    <a class="dropdown-item" href="{{ account_balance_url }}">Point Progress</a>
                  {% endif %}
                  {% comment %}<a class="dropdown-item" href="{{ account_dashboard_url }}">Dashboard</a>{% endcomment %}
                  {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ order_history_url }}">Merch Order History</a>{% endif %}
                  <a class="dropdown-item" href="{{ edit_account_url }}">Account Settings</a>
                  {% if shop.store_enabled? %}<a class="dropdown-item" href="{{ address_book_url }}">Address Book</a>{% endif %}
                  {% if shop.catalog_enabled? %}
                    {% if shop.custom_logos_upload_enabled? or current_user.logos.size != 0 %}<a class="dropdown-item" href="{{ logos_url }}">Logo</a>{% endif %}
                  {% endif %}
                  {% if shop.budget_enabled? and current_user.has_budgets? %}<a class="dropdown-item" href="{{ budget_info_url }}">Budget</a>{% endif %}
                  <a class="dropdown-item mt-2 border-top" href="{{ logout_url }}">Sign Out</a>
                {% else %}
                  {% if shop.show_login? %}<a class="dropdown-item" href="{{ login_url }}">Sign In</a>{% endif %}
                  {% if shop.show_registration? %}<a class="dropdown-item" href="{{ signup_url }}">Register</a>{% endif %}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endif %}

        {% if current_user and shop.wishlist_enabled? %}
          <a class="wishlist-link px-2" href="{{ wishlist_url }}">{% include 'icons/wishlist' %}<span>{{ wishlist.line_items_count }}</span></a>
        {% endif %}
        
        {% if shop.store_enabled? %}
          <a class="cart-link" href="{{ cart_url }}">{% include 'icons/cart' %}<span>{{ order.line_items_count }}</span></a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>