{% if product.size_charts.size > 0 %}
<div class="modal fade" id="modal-sizeChart" tabindex="-1" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Size Charts</h5>
        <button type="button" class="close btn-close" data-bs-dismiss="modal" aria-label="Close">
          <!-- <span aria-hidden="true">&times;</span> -->
        </button>
      </div>
      <div class="modal-body"> 
        <div class="product-tabs">
          <div class="tabs-body">
            <div class="product-size-charts visible">
              <ul>
                {% for chart in product.size_charts %}
                <li>
                  <a href="{{chart.url}}" target="_blank" rel="noopener noreferrer">{{chart.name}}</a>
                </li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
