{% if shop.active_multi_storefront? and session_passcode != blank %}
  <div class="modal fade" id="remove-group-passcode-modal" tabindex="-1" role="dialog" aria-labelledby="remove-group-passcode-modal" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          {% assign logoMargins = settings.logo_margin | split: ' ' %}
          {% assign logoMarginTop = logoMargins[0] %}
          {% if logoMargins[2] %}{% assign logoMarginBottom = logoMargins[2] %}{% else %}{% assign logoMarginBottom = logoMargins[0] %}{% endif %}
          <h5 class="modal-title"><img class="img-fluid" src="{{ "logo_custom_bg_image.jpg" | asset_url }}" style="max-height: calc({{ settings.header_height }} - {{ logoMarginTop }} - {{ logoMarginBottom }} - 14px);"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0">
            Are you sure that you want to clear group passcode?
          </p>
        </div>
        <div class="modal-footer">
          {% form 'clear_passcode' %}
            <button type="submit" class="btn secondary">Yes, clear group passcode</button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
{% endif %}
