{% form 'login' %}
  <div class="mb-3">
    <label class="mb-1" for="website_user[login]">Username</label>
    <input type="text" class="form-control" name="website_user[login]" id="website_user[login]" rel="login">
  </div>
  <div class="mb-3 password-div">
    <label class="mb-1" for="website_user_password">Password</label>
    <input type="password" name="website_user[password]" class="form-control" id="website_user_password" rel="password" autocomplete="off">
    <i class="fa fa-solid fa-eye"></i>
  </div>
  <input type="hidden" name="website_user[timezone]" id="website_user_timezone">
  <div class="login-btn-and-links">
    <input type="submit" value="Sign In" class="btn secondary custom_btn btn_sign custom-button {% if template_name == 'login' %}btn-heather{% else %}btn-tradewind{% endif %}"/>
      <p class="mb-0">
        <a href="{{ forgot_password_url }}" class="forgot-link">Forgot password?</a>
        <br>
        <a href="{{ resent_confirmation_url }}" class="resend-link">Resend confirmation E-Mail</a>  
      </p>
  </div>
{% endform %}

<script>
  (function() {
    var timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    $('#website_user_timezone').val(timezone);
  })();
</script>
