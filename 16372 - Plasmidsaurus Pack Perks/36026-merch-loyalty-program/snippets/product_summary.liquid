{% if form.variants.size > 1 %}
  <div class="product-summary">
    <div class="product-summary-body">
      <div class="summary-title">
        <h4>Item Summary</h4>
      </div>

      {% for variant in form.variants %}
        {% if variant.quantity > 0 %}
          <div class="summary-body">
            <div class="name" colspan="2">{{ variant.name }}</div>
            <div class="quantity">{{ variant.quantity }}</div>
            <div class="price">{% include 'price', price_value: variant.total_price, price_suffix: true %}</div>
          </div>
        {% endif %}
      {% endfor %}
      <div class="summary-body">
        <div class="name" colspan="2">Total Quantity:</div>
        <div class="quantity">{{ form.summary.total_quantity }}</div>
        <div></div>
      </div>
      {% include 'decoration_summary' %}
    </div>
    <div class="product-summary-footer">
      {% if form.decoration_medivod.price_modifier > 0 and form.selected_logos != empty %}
        <div class="summary-footer">
          <div class="name">{{ form.decoration_medivod.name }}:</div>
          <div>
            {% include 'price', price_value: form.decoration_medivod.price_modifier %}
          </div>
        </div>
      {% endif %}

      {% if form.summary.setup_charge > 0 %}
        <div class="summary-footer">
          <div class="name">Setup Charge:</div>
          <div>
            {% include 'price', price_value: form.summary.setup_charge, price_suffix: true %}
          </div>
        </div>
      {% endif %}

      <div class="summary-footer">
        <div class="name">Total:</div>
        <div>{% include 'price', price_value: form.summary.total_price, price_suffix: true %}</div>
      </div>
    </div>
  </div>
{% else %}
  <div class="product-summary">
    <div class="product-summary-body">
      {% if product.minimum_order_quantity > 0 or product.maximum_order_quantity > 0 %}
        <div class="summary-footer">
          <div class='minimum-order-quantity-help'>
            {% include 'quantity_limits_message', product: product %}
          </div>
        </div>
      {% endif %}

      {% include 'decoration_summary' %}
    </div>
    <div class="product-summary-footer">
      {% if form.decoration_method.price_modifier > 0 and form.selected_logos != empty %}
        <div class="summary-footer">
          <div class="name">{{ form.decoration_method.name }}:</div>
          <div>
            {% include 'price', price_value: form.decoration_method.price_modifier, price_suffix: true %}
          </div>
        </div>
      {% endif %}

      <div class="summary-footer">
        <div class="name">Item Price:</div>
        <div>
          {% include 'price', price_value: form.variants[0].unit_price, price_suffix: true %}
        </div>
      </div>

      {% if form.summary.setup_charge > 0 %}
        <div class="summary-footer">
          <div class="name">Setup Charge:</div>
          <div>{% include 'price', price_value: form.summary.setup_charge, price_suffix: true %}</div>
        </div>
      {% endif %}

      <div class="summary-footer">
        <div class="name">Total:</div>
        <div>{% include 'price', price_value: form.summary.total_price, price_suffix: true %}</div>
      </div>
    </div>
  </div>
{% endif %}
