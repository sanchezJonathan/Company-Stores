{% if line_item.personalizations != empty %}
  <div class="section product-personalizations">
    <h4>Product Personalizations</h4>
    {% include 'product_personalization_attributes' line_item: line_item %}
  </div>
{% endif %}

{% if line_item.decorations != empty %}
  <div class="section product-decorations">
    <h4>Decoration Details</h4>
    <p class="mb-0 pl-2"><span class="cart-inline-title-short">Decoration Method:</span> {% include 'modifier' title: line_item.decoration_method.name, amount: line_item.decoration_method.price_modifier %}</p>
    {% include 'decoration_attributes' line_item: line_item %}
  </div>
{% endif %}

{% if line_item.has_certificate_details %}
  <div class="section gift-certificate-details">
    <h4>Recipient Information</h4>
    {% include 'gift_certificate_details' line_item: line_item %}
  </div>
{% endif %}
