/*-------------------
Bootstrap Notes
-------------------*/
/*
This theme uses Bootstrap v5.1.

It is highly recommended to check out Bootstrap's guiding principles,
strategies, and techniques at:
https://getbootstrap.com/docs/5.1/extend/approach/

To learn more about Bootstrap v5.1:
https://getbootstrap.com/docs/5.1/getting-started/introduction/
*/
#splash-page, #site-content {
  display: none;
  overflow: hidden;
}
.content-container {
  min-height: auto;
}
#splash-page {
  {% comment %}
  background: url({{ 'splash-bg.png' | asset_url }});
  background-position: 50% 47%;
  background-size: 140%;
  background-repeat: no-repeat;
  {% endcomment %}
  width: 100%;
  height: 100%;
  min-height: 100vh;
  background-color: #F1E6D1;
  text-align: center;
  overflow: hidden;
  position: relative;
}
.splash-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 3rem 2rem 1.5rem;
  max-width: 1000px;
  margin: auto;
}
.splash-bg {
  position: absolute;
  width: 1920px;
  top: -10rem;
}
.splash-logo {
  width: 100%;
  max-width: 600px;
  margin-bottom: 2rem;
}
.splash-pack-perks {
  width: 100%;
  max-width: 600px;
}
.pack-perks-form {
  margin-top: 15.6rem;
  width: 100%;
  max-width: 400px;
  position: relative;
}
#splash-email {
  border-radius: 8px;
  padding: 12px 16px 11px;
  font-size: 18px;
  font-family: 'Rubik', sans-serif;
}
#splash-submit {
  background-color: #485C11;
  border-radius: 40px;
  padding: 11px 60px;
  border: none;
  box-shadow: none !important;
}
#splash-submit:hover, #splash-submit:focus {
  background-color: #8E9C78;
  transition: .3s;
}
#splash-error {
  background-color: #FFF3CD;
  border: 1px solid #FEBE10;
  text-align: center;
  padding: 1rem 1rem;
  font-size: 18px;
  font-family: 'Rubik', sans-serif !important;
  margin: 1rem auto;
  border-radius: 12px;
  position: relative;
  width: 90%;
  max-width: 556px;
  letter-spacing: -0.3px;
}
#splash-error a {
  text-decoration: underline;
}
#splash-submit {
  transition: opacity 0.2s ease, transform 0.2s ease;
}
#splash-submit.validating {
  opacity: 0.7;
  cursor: wait;
  transform: scale(0.98);
}
/*-------------------
BASE / RESET
-------------------*/
* {
  line-height: 1.5;
}
body,
div,
h3,
h4,
h5,
h6,
span {
  font-family: 'Inconsolata', sans-serif !important;
}
h2 {
  font-size: 32px;
}
body,
p,
h2 {
  font-family: 'Rubik', sans-serif !important;
  font-weight: 400;
}
ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
li {
  line-height: 1.2 !important;
}
.container-fluid {
  padding: 0 1rem !important;
}
.modal.lightbox .modal-dialog {
  max-width: 90%;
}
.ratio-16x9 {
  --bs-aspect-ratio: 100%;
}
.fa,
.fas {
  font-family: 'Font Awesome 5 Free' !important;
}
.toast .btn-close {
  opacity: 1;
}
a.nav-link:hover,
a.nav-link:focus {
  text-decoration: underline !important;
  text-underline-offset: 4px;
}
img {
  width: 100%;
  height: auto;
}
/*-------------------
SEARCH
-------------------*/
.no-results-message {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 300px; 
  width: 100%;
}
.no-results-message h3 {
  font-size: 24px;
  font-weight: 600;
  margin: 0;
}
/*-------------------
TYPOGRAPHY
-------------------*/
h1 {
  font-family: 'Rubik', sans-serif !important;
  font-weight: 600;
}
h2, h3 {
  font-family: 'Rubik', sans-serif !important;
  font-weight: normal !important;
}
label.mb-1,
a.forgot-link,
a.resend-link {
  font-weight: 600;
  font-family: 'Rubik', sans-serif !important;
}
.sso-link {
  color: #0B5CFF;
}
.card-title {
  font-family: 'Rubik', sans-serif !important;
  color: #103714 !important;
  font-size: 18px;
}
.card-text {
  font-family: 'Rubik', sans-serif !important;
  color: #555555 !important;
  font-size: 18px;
}
/*-------------------
BUTTONS
-------------------*/
.btn {
  font-weight: 600;
}
.btn.secondary,
.btn.primary,
.out-of-stock-notification button,
.out-of-stock-notification button:hover {
  border-radius: 35px;
  padding: 5px 40px;
}
.btn.secondary {
  border-radius: 50px;
}
.btn.secondary.btn-item-summary {
  padding: 4px 15px 3px;
}
/*-------------------
QUANTITY INPUT RESET
-------------------*/
/* Chrome, Safari, Edge, Opera */
.product-page-main .product-quantity #quantity input::-webkit-outer-spin-button,
.product-page-main .product-quantity #quantity input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
/* Firefox */
.product-page-main .product-quantity #quantity input[type=number] {
  -moz-appearance: textfield;
  background-color: #FFF;
  border: 1px solid #2c2c2c;
}
/*-------------------
TOP NAV
-------------------*/
.navbar-container ul.nav > li > a {
  margin: 14px 0 14px 40px;
}
.nav-link {
  /*font-weight: bold !important;*/
  font-family: 'Inconsolata', sans-serif !important;
}
/*-------------------
HEADER
-------------------*/
.header-container .header-navbar {
  padding: 20px 0;
}
.user-loggedin .navbar-brand.logo-container {
  width: 314px;
}
.logo-container img {
  max-height: {{ settings.logo_container_height }} !important;
  margin: 0 auto 0 0;
  width: auto;
}
.header-icons .user-link {
  background-image: url('data:image/svg+xml;utf8,<svg ... > ... </svg>');
  width: 50px;
  height: 50px;
  display: inline-block;
}
.header-icons > button,
.header-icons > .dropdown,
.header-icons > a {
  position: relative;
}
.header-container a.cart-link span,
.header-container a.wishlist-link span {
  position: absolute;
  font-size: 9px;
  background: {{ settings.cart_bubble_background_color }};
  color: {{ settings.cart_bubble_text_color }};
  border-radius: 50%;
  right: -9px;
  top: -6px;
  width: 15px;
  height: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: normal;
  padding: 1px 1px 0;
}
.header-icons > a svg, .header-icons button svg {
  height: 20px;
  stroke: none;
  fill: none;
}
.header-container .headerLinks .mt-2.border-top {
  padding-top: 11px;
  padding-bottom: 3px;
}
.header-container li > a,
.header-container li > a:hover,
.header-container li > a:focus {
  padding: 5px 15px !important;
}
.header-container .headerLinks {
  flex-grow: initial;
  max-width: 314px;
}
.header-container button:focus {
  box-shadow: none;
}
.merch-points-balance {
  background-color: #9EDA1D;
  padding: 5px 8px;
  border-radius: 8px;
  line-height: 1;
  font-weight: 600;
  margin-right: 10px;
  text-decoration: none !important;
}
.merch-points-balance svg {
  margin-top: -5px;
}
/* 1. Mobile Header Styling */
.mobile-header-actions {
  display: none; /* Hidden on desktop */
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
}
.mobile-header-actions .btn, 
.mobile-header-actions .cart-link-wrapper {
  background: transparent;
  border: none;
  padding: 8px 0;
  display: flex;
  align-items: center;
  text-decoration: none;
  color: inherit;
  position: relative;
}
/* 2. Cart Badge Styling */
.cart-badge-custom {
  position: absolute;
  top: 0px;
  right: -8px;
  background-color: #9EDA1A; /* Your specific Green */
  color: #103714;
  font-size: 10px;
  font-weight: bold;
  border-radius: 50%;
  min-width: 17px;
  height: 17px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
/* 3. Responsive Logic */
@media screen and (max-width: 991px) {
  .mobile-header-actions {
    display: flex !important; /* Force side-by-side on mobile */
    margin-left: auto; 
    padding-top: 8px;
  }

  /* Ensure the icons look consistent */
  .mobile-header-actions svg {
    width: 22px;
    height: 22px;
  }
}
button.btn.d-lg-none.d-xl-none.px-0 {
    display: none;
}
.mobile-merch-points {
  background-color: #9EDA1D;
  text-align: center;
  padding: 8px 10px;
  position: relative;
  z-index: 100;
  font-weight: 600;
}

.mobile-merch-points a {
  text-decoration: none !important;
}

.mobile-merch-points a:hover, .mobile-merch-points a:focus {
  background-color: transparent;
}
.mobile-merch-points svg {
  margin-top: -4px;
}
.header-container nav.navbar > button svg {
  max-width: 22px;
}
/*-------------------
CONTENT
-------------------*/

.join-the-pack-container > map > area {
	text-decoration: underline;
}
.homepage-container {
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}
.homepage-container h2 {
  font-weight: normal !important;
  color: #555 !important;
  text-align: center;
}
.custom-shop-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: #9EDA1A;
  color: #103714;
  font-size: 16px;
  text-decoration: none !important;
  font-weight: 600;
  border-radius: 50px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease;
  padding: 12px 33px 14px;
}
/* Hover state */
.custom-shop-all:hover {
    background-color: #485C11; /* Darker background */
    color: #FFFDF8; /* Text color on hover */
}
.custom-shop-all:hover, .custom-shop-all:focus {
  opacity: 0.9;
  text-decoration: none !important;
}
.we-love-our-custmers-container {
  background-color: #485C11;
  text-align: center;
  position: relative;
  z-index: -1;
  padding: 6rem 0rem 5rem;
  margin-top: 1rem;
}
.we-love-our-custmers-container .frame {
  margin-top: -13rem;
  width: 100%;
}
.we-love-our-custmers-container .desktop {
  max-width: 670px;
}
.we-love-our-custmers-container .mobile {
  display: none;
}
.how-it-works-container {
  background-color: #f9f6f0;
  padding: 2rem 0px 2.6rem;
  position: relative;
  margin-top: 3rem;
  overflow-x: clip;
  overflow-y: visible;
}
.how-it-works-container::before {
  content: "";
  position: absolute;
  z-index: -2;
  width: 100%;
  height: 100%;
  top: -3rem;
  background-color: #fff3cd;
}
.how-it-works-container > img {
  position: absolute;
  top: -40px;
  width: calc(100% + 100px) !important;
  left: -50px;
  z-index: -1;
}
.how-it-works-container svg {
  margin-top: -5rem;
  width: 110%;
  margin-left: -5%;
}
.how-it-works-container h2 {
  font-size: 60px;
  margin-bottom: 2rem;
}
.hiw-boxes-container.row.content-container {
  min-height: auto;
}
.hiw-boxes-container > div {
  padding: 1rem 1rem 0;
  position: relative;
}
.hiw-boxes-container > div::before {
  content: "";
  width: calc(100% - 2rem);
  height: 1px;
  position: absolute;
  background-color: #E2DCD0;
  top: 0;
}
.how-it-works-container img {
  max-height: 150px;
  width: auto;
  margin-top: 2px;
  margin-bottom: 22px;
}
.how-it-works-container h4 {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 18px;
}
.hiw-boxes-container p {
  font-size: 18px;
}
.hiw-box {
  color: #4D4639;
}

.why-the-wait-container {
  min-height: auto;
  background-color: #DFECC6;
  border-radius: 8px;
  display: flex;
  align-items: center;
  flex-direction: row;
  padding: 18px 25px !important;
  color: #4D4639;
  gap: 25px;
  margin-top: 4rem;
  max-width: 1200px;
}
.how-it-works-container .why-the-wait-container img {
  max-height: 75px;
  background-color: #8E9C78;
  border-radius: 75px;
  margin: 0;
}
.why-the-wait-container p {
  margin: 0;
  line-height: 1.4;
  font-size: 18px;
}
.join-the-pack-container {
  padding: 4rem 0 0;
  text-align: center;
  overflow: hidden;
}
.join-the-pack-container img {
  max-width: 1400px;
  margin: 1.5rem auto 0;
  right: -4rem;
}
.join-the-pack-container .join-the-pack-graphic-mobile {
  display: none;
}
.faq-container {
  overflow: hidden;
}
.faq-content-container {
  padding: 0 0 6rem;
  margin-bottom: -2.5rem;
  position: relative;
}
.faq-content-container::before {
  content: "";
  width: 100%;
  height: 100%;
  background-color: #f5edd6;
  position: absolute;
  top: 4rem;
  z-index: -1;
}
.faq-content-innner {
  margin-top: -4rem;
}
.faq-container > img {
  position: relative;
  z-index: -1;
  margin-bottom: -2.1rem;
}
#accordionFAQ .accordion-item {
  background-color: transparent;
  border-color: #CECECE;
}
#accordionFAQ .accordion-button {
  font-size: 18px;
  background-color: transparent;
  padding: 27px 0;
  border-color: transparent;
}
.accordion-button:focus {
  box-shadow: none;
}
#accordionFAQ .accordion-body {
  font-family: 'Rubik', sans-serif !important;
  padding: 0;
  border-radius: 6px;
  margin-bottom: 27px;
  color: #545454;
  font-size: 18px;
}
#accordionFAQ .accordion-body p {
  line-height: 1.5;
}
#accordionFAQ .accordion-body * {
  color: #545454;
}
#accordionFAQ .accordion-button::after {
  background-image: url({{ 'accordion-closed-icon.svg' | asset_url }});
  background-size: 16px 16px;
  background-position: center;
  transition: none;
}
#accordionFAQ .accordion-button:not(.collapsed)::after {
  background-image: url({{ 'accordion-opened-icon.svg' | asset_url }});
}

.home-contact-info-container {
  background-color: #8E9C78;
  padding: 1.6rem 1rem 3.6rem;
  color: #fff;
  margin-bottom: -3rem;
  text-align: center;
  font-size: 18px;
  letter-spacing: -0.5%;
}
.home-contact-info-container a {
  text-decoration: underline;
  color: #fff;
}

.featured-products.position-relative {
  position: relative;
  overflow: visible;
  text-align: center;
}
/* Force the list to behave as a slider */
#featuredSlider {
  display: flex !important;
  flex-wrap: nowrap !important;
  overflow-x: auto !important;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  gap: 15px;
  padding-bottom: 10px;
  margin: 25px 0 0 0;
  text-align: left;
}
.featured-products.position-relative .custom-shop-all {
  margin: 0 0 0 0;
}
/* Hide default scrollbars */
.hide-scrollbar {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
}
.hide-scrollbar::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}
/* Arrow Styling */
.scroll-arrow {
  position: absolute;
  top: 42%;
  transform: translateY(-50%);
  z-index: 100;
  background-color: #F9F6F0;
  border: 1px solid #F9F6F0;
  border-radius: 10px;
  width: 40px;
  height: 40px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  color: #103714;
  font-size: 20px;
  transition: all 0.2s ease;
  padding: 0;
  box-shadow: none;
}
.scroll-arrow:hover path {
  fill: #fffdf8;
}
/* Positioning for Mobile (Internal) */
.left-arrow { left: -12px; }
.right-arrow { right: -12px; }
/* Positioning for Desktop (External if screen is wide enough) */
@media (min-width: 1200px) {
  .left-arrow { left: -20px; }
  .right-arrow { right: -20px; }
}
.scroll-arrow:hover {
  background-color: #103714 !important;
  border-color: #103714;
}
/* Ensure thumbnails don't collapse */
.featured-products .product-thumbnail {
  flex: 0 0 auto !important;
  width: 280px; /* Mobile width */
}
@media (min-width: 992px) {
  .featured-products .product-thumbnail {
    width: calc((100% - 45px) / 4) !important;
  }
}


