.loading-indicator {
  height: 80px;
  width: 80px;
  background: url("{{ "loading.gif" | asset_url }}");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}

.loading-indicator-overlay {
  background-color: #FFFFFF;
  opacity: 0.6;
  filter: alpha(opacity=60);
}
