{% assign account_section_title = 'Account Dashboard' %}
{% capture account_page_content %}
  <div class="content-block">
    <h3>Account Info</h3>
    <a href="{{ edit_account_url }}" class="action-link btn secondary">Edit Account Info</a>
    
    <div class="mt-3">
      <div class="mb-3">
        <label for="dashboard[username]" class="form-label">Username:</label>
        <input type="text" readonly class="form-control" id="dashboard[username]" value="{{ current_user.username }}">
      </div>
      <div class="mb-3">
        <label for="dashboard[account_number]" class="form-label">Account number:</label>
        <input type="text" readonly class="form-control" id="dashboard[account_number]" value="{{ current_user.id }}">
      </div>
      {% if current_user.shipping_address %}
        {% assign address = current_user.shipping_address %}
        <div class="mb-3">
          <label for="dashboard[shipping_address]" class="form-label">Shipping address:</label>
          <textarea type="text" readonly class="form-control" id="dashboard[shipping_address]">{{ address.company }} {{ address.first_address }} {{ address.second_address }} {{ address.city }} {{ address.state }} {{ address.zip }}</textarea>
        </div>
      {% endif %}
      {% if current_user.billing_address %}
        {% assign address = current_user.billing_address %}
        <div class="mb-3">
          <label for="dashboard[billing_address]" class="form-label">Billing address:</label>
          <textarea type="text" readonly class="form-control" id="dashboard[billing_address]">{{ address.company }} {{ address.first_address }} {{ address.second_address }} {{ address.city }} {{ address.state }} {{ address.zip }}</textarea>
        </div>
      {% endif %}
    </div>
  </div>
  {% if shop.store_enabled? and current_user.recent_orders != empty %}
    <div class="content-block">
      <h3>Recent Orders</h3>
      <a href="{{ order_history_url }}" class="action-link btn secondary">View All Orders</a>
      <div class="recent-orders-wrapper">
        <table class="recent-orders">
          {% include 'order_history_item' with current_user.recent_orders %}
        </table>
      </div>
    </div>
  {% endif %}
{% endcapture %}
{% include 'account_page' with account_page_content, section_title: account_section_title %}
