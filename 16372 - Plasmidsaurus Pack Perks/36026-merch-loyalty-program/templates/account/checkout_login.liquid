<div class="container-fluid px-lg-0 mt-5">
  <div class="row px-0 border border-0 mx-0 login-register-page">
    {% if shop.show_login? %}
    <div class="col-lg-6 col-md-12 mx-auto py-5 px-4 ps-0 pt-0">
      <div class="content-block">
        <h3>Login To An Existing Account</h3>
        <p></p>
        {% include 'login' %}
      </div>
    </div>
    {% endif %}
    {% if shop.show_registration? %}
    <div class="col-lg-6 col-md-12 mx-auto py-5 px-4 pe-0 pt-0">
      <h3>Sign Up For An Account</h3>
      <p></p>
      <div class="content-block">
          <div class="sign-in-form regform">
            {% form 'registration' %}
              {% include "registration_form" %}
              <div> 
                <button type="submit" class="btn secondary" name="commit">Sign Up</button>
                <p>Your password must be at least 7 characters long. You must include at least one uppercase letter, lowercase letter, and number.</p>
              </div>
            {% endform %}
          </div>
      </div>
    </div>
    {% endif %}
  </div>

  <div class="row px-0 border border-0 mx-0 login-register-page">
    {% if shop.guest_checkout_allowed? %}
      <h3>Guest Checkout</h3>
      {% form 'guest_checkout' %}
        <div class="mb-3">
          <label class="string required control-label email" for="website_order_customer_email">Email address</label>
          <input type="text" class="form-control {% if form.errors contains 'email' %}is-invalid{% endif %}" id="website_order_customer_email" name="guest[email]"  rel="login">
          {% if form.errors contains 'email' %}
            <div class="invalid-feedback">
              {{ form.errors['email'] }}
            </div>
          {% endif %}
        </div>
        <input type="submit" value="Continue as Guest" class="btn secondary"/>
      {% endform %}
	{% endif %}
  </div>
</div>

{% comment %}
<script>
  function showLogin() {
  	$(".login-container").show();
    $(".register-container").hide();
    $(".guest-container").hide();
    
    $(".login-tab").addClass("active");
    $(".register-tab").removeClass("active");
    $(".guest-tab").removeClass("active");
    
    $(".login-tab").closest(".nav-item").addClass("active-tab");
    $(".register-tab").closest(".nav-item").removeClass("active-tab");
    $(".guest-tab").closest(".nav-item").removeClass("active-tab");
  }
  
  function showRegister() {
    $(".login-container").hide();
    $(".register-container").show();
    $(".guest-container").hide();
    
    $(".login-tab").removeClass("active");
    $(".register-tab").addClass("active");
    $(".guest-tab").removeClass("active");
    
    $(".login-tab").closest(".nav-item").removeClass("active-tab");
    $(".register-tab").closest(".nav-item").addClass("active-tab");
    $(".guest-tab").closest(".nav-item").removeClass("active-tab");
  }
  
  function showGuest() {
    $(".login-container").hide();
    $(".register-container").hide();
    $(".guest-container").show();
    
    $(".login-tab").removeClass("active");
    $(".register-tab").removeClass("active");
    $(".guest-tab").addClass("active");
    
    $(".login-tab").closest(".nav-item").removeClass("active-tab");
    $(".register-tab").closest(".nav-item").removeClass("active-tab");
    $(".guest-tab").closest(".nav-item").addClass("active-tab");
  }
  
  var activeTab = sessionStorage.getItem("checkout-tab") || {% if shop.show_login? %}"login"{% endif %}{% if shop.show_login? == false and shop.show_registration? %}"register"{% endif %}{% if shop.show_login? == false and shop.show_registration? == false %}"guest"{% endif %};
  var activeTabMap = {
    login: showLogin,
    register: showRegister,
    guest: showGuest,
  };
  
  activeTabMap[activeTab]();
  
  $(".login-tab").click(function() {
  	showLogin();
    sessionStorage.setItem("checkout-tab", "login");
  });
  
  $(".register-tab").click(function() {
  	showRegister();
    sessionStorage.setItem("checkout-tab", "register");
  });
  
  $(".guest-tab").click(function() {
  	showGuest();
    sessionStorage.setItem("checkout-tab", "guest");
  });
</script>
{% endcomment %}