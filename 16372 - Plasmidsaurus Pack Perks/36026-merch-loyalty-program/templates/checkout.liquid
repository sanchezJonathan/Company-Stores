{% capture checkout_page_content %}
{% form 'checkout' %}
  {% assign hasCA = 0 %}
  {% for line_item in order.line_items %}
    {% for cats in line_item.categories %}
      {% if cats.name == "Customer Appreciation" %}
        {% assign hasCA = 1 %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  <input type="hidden" id="hasCA" name="hasCA" value="{{ hasCA }}">

  {% assign hasPM = 0 %}
  {% for group in current_user.groups %}
    {% if group.title == "PM UCAN GUERRE" or group.title == "PM JAPAN IWASHITA" or group.title == "PM LIM APAC" or group.title == "PM US+ BOLOTIN" or group.title == "PM US TRUONG" or group.title == "PM US HOEHN" or group.title == "PM EMEA AANDESTEGGE" or group.title == "PM EMEA BENSIEN" or group.title == "PM EMEA LORENZEN" %}
      {% assign hasPM = 1 %}
    {% endif %}
  {% endfor %}
  <input type="hidden" id="hasPM" name="hasPM" value="{{ hasPM }}">



  {% for custom_collection in order.custom_data_collections %}
    {% if custom_collection.title == "Order Type" %}
      <input type="hidden" id="ordertype" value="{{ custom_collection.attributes[0].value | remove: '[' | remove: ']' }}">
    {% endif %}
  {% endfor %}

    {% if custom_data_collections != empty and checkout_flow.state == 'custom_data_collection' %}
      {% include 'checkout/cdc' %}
    {% endif %}



  {% if shop.show_shipping_address? and checkout_flow.state == 'address' %}
    {% include 'checkout/shipping_address' %}
  {% endif %}

  {% if shop.show_ship_method? and checkout_flow.state == 'delivery' %}
    {% include 'checkout/shipping_method' %}
  {% endif %}

  {% if checkout_flow.state == 'payment' %}
    {% if shop.show_billing_address? %}
      {% include 'checkout/billing_address' %}
    {% endif %}
    {% if shop.payment_required? %}
      {% include 'checkout/billing_method' %}
    {% endif %}
  {% endif %}

  {% if shop.budget_enabled? and current_user.has_budgets? and order.budget_order? and checkout_flow.state == 'budget' %}
    {% include 'checkout/budget' %}
  {% endif %}

  {% if checkout_flow.state == 'confirm' %}
    {% include 'checkout/summary' %}
  {% endif %}

{% endform %}
{% endcapture %}

{% include 'checkout_page' with checkout_page_content, order: order %}

<script>

$(function () {
  var user_balance = {{ current_user.balance | minus: order.grand_total }};
  var checkoutController = new CheckoutController('{{ checkout_flow.state }}');
  $('div.checkout-main').data('checkoutController', checkoutController);

  $('#switch').click(function () {
    var $this = $(this);
    if ($this.is(':checked')) {
      $('.shcompany').show();
      
      if (user_balance > 0) {
        $(".pm").hide();
        $(".napr").removeClass("d-none");
      }
    } else {
      $('.shcompany').hide();
      $(".pm").show();
      $(".napr:not(.d-none)").addClass("d-none");
    }
  });

  if ($('#switch').is(':checked')) {
    $('.shcompany').show();
  }
});
</script>

<style>
.shcompany {
  display: none
}
</style>
