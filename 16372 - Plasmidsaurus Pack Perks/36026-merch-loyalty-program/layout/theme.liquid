      async function hashEmail(email) {
        var data = new TextEncoder().encode(email.trim().toLowerCase());
        var hashBuffer = await crypto.subtle.digest('SHA-256', data);
        var hashArray = Array.from(new Uint8Array(hashBuffer));

        return hashArray.map(function (byte) {
          return byte.toString(16).padStart(2, '0');
        }).join('');
      }
      
      // Validate email
      $('#splash-submit').on('click', function () {
        var $button = $(this);
        var email = $.trim($('#splash-email').val()).toLowerCase();

        // Hide previous error
        $('#splash-error').hide();

        // Check if the input is blank
        if (email === '') {
          $('#splash-error').text('Please enter your email address.').show();
          return;
        }

        // Prevent multiple clicks while validating
        $button.prop('disabled', true);

        // Validation animation/state
        $button.addClass('validating');
        $button.data('original-text', $button.text());
        $button.text('Validating...');

        // Simulate validation for 500ms
        setTimeout(async function () {

          // Check if email is in the approved list
          var emailAdd = await hashEmail(email);
          var isValidEmail = validEmailHashes.indexOf(emailAdd) !== -1;

          // Allow any email from @plasmidsaurus.com
          var isPlasmidsaurusEmail = email.endsWith('@plasmidsaurus.com');

          if (isValidEmail || isPlasmidsaurusEmail) {
            // Save access cookie
