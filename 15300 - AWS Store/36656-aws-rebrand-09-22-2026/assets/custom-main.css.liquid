  }
  .product-thumbnail .thumbnail-img-container, .product-thumbnail .thumbnail-img-container a {
    min-height: 210px;
  }
}


#bg-image {
  position: fixed;   /* stays in place */
  top: 0;
  left: 0;
  width: 100%;
  height: auto;
  object-fit: cover; /* ensures full coverage */
  z-index: -1;       /* places it behind content */
}

/* ==========================================================================
   MEDIA QUERIES (RESPONSIVENESS)
   ========================================================================== */

/* Tablets & Small Laptops (Under 992px) */
@media screen and (max-width: 992px) {
  .homepage-boxes-container {
    margin-top: 60px;
  }

  .homepage-boxes {
    gap: 20px !important;
  }

  .homepage-box {
    width: calc(50% - 10px) !important;
  }

  .homepage-bottom-banners p {
    font-size: 22px;
  }
}

/* Mobile Devices (Under 768px) */
@media screen and (max-width: 768px) {
  .homepage-boxes-container {
    margin-top: 40px;
  }

  /* Switch grid from 2 columns to 1 full-width column */
  .homepage-box {
    width: 100% !important;
  }

  .homepage-box-content .category-title {
    font-size: 1.05rem !important;
  }

  .homepage-bottom-banners {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .homepage-bottom-banners p {
    font-size: 18px;
  }

  .homepage-bottom-banners a.btn.secondary {
    padding: 6px 24px 5px;
    font-size: 0.875rem;
  }
}