  }
  /* .carousel-item > a {
    display: none !important;
  } */
  .carousel-caption {
    background: #FFF;
    max-width: 100%;
    width: 100%;
    position: relative;
    top: 0 !important;
    left: 0 !important;
    padding: 2rem 2rem 2rem 2rem;
    transform: none !important;
    border-bottom: 1px solid #e7e7e7;
  }
  .carousel-caption-header {
    font-size: 32px;
    line-height: 42px;
  }
  .banner-caption h2 {
    font-size: 2rem;
  }
  .banner-caption {
    left: 30%;
    max-width: 300px;
  }
}
@media screen and (max-width: 660px) {
  .banner-caption {
    top: 50%;
    left: 35%;
    max-width: 300px;
  }
  .banner-caption h2 {
    font-size: 2rem;
  }
}
@media screen and (max-width: 600px) {
  .product-thumbnail .thumbnail-img-container, .product-thumbnail .thumbnail-img-container a {
    min-height: 300px;
  }
  .banner-caption h2 {
    font-size: 1.3rem;
    line-height: 1;
    margin-bottom: 10px;
  }
  .banner-caption a {
    font-size: 16px;
  }
}
@media screen and (max-width: 767px) {
  .homepage-box {
    width: 100%;
  }
  .product-page-main h2 {
    margin-top: 1.75rem;
  }
}

@media screen and (max-width: 520px) {
  .banner-caption {
    left: 36%;
  }
}
@media screen and (max-width: 480px) {
  .container-fluid {
    padding: 0 1.5rem !important;
  }
  ul.custom-footer-links {
    flex-direction: column !important;
  }
  .copyright-section {
