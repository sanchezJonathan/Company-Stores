/* Container & Base Styles */
.homepage-boxes-container {
  margin-top: 100px;
}

.homepage-boxes-container h2 {
  margin-bottom: 20px;
  color: #ffffff;
}

.homepage-boxes {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 30px !important;
  padding-bottom: 50px;
}

.homepage-box {
  width: calc(50% - 15px) !important;
  display: flex !important;
  flex-direction: column !important;
  position: static !important;
  background: transparent !important;
  margin: 0 !important;
  padding: 0 !important;
  height: auto !important;
  box-sizing: border-box !important;
}

.homepage-box-image-card {
  width: 100%; 
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background-color: #F8F3F0;
  border-radius: 0px;
}

.homepage-box-image-card img {
  max-width: 100% !important;
  max-height: 100% !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
  display: block !important;
  border-radius: 0px !important;
}

.homepage-box-content {
  position: static !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  padding-top: 12px !important;
}

.homepage-box-content p {
  font-family: 'EmberModernDisplay_Medium' !important;
  font-size: 20px !important;
  font-weight: 500 !important;
  margin: 0 0 4px 0 !important;
  line-height: 1.3 !important;
}

.shop-now-link {
  font-family: 'AmazonEmber' !important;
  font-size: 14px !important;
  color: #3A3936;
  text-decoration: underline !important;
  text-underline-offset: 4px !important;
  transition: opacity 0.2s ease, color 0.2s ease;
}

.shop-now-link:hover {
  opacity: 0.8;
  color: #FF6200 !important;
}

.homepage-bottom-banners {
  margin-top: 3rem;
  margin-bottom: 3rem;
  position: relative;
  width: 100%;
}

.homepage-bottom-banners img {
  width: 100%;
  height: auto;
  display: block;
}

.homepage-bottom-banners p {
  font-size: 30px;
  font-weight: 500;
  color: #0F1B5D;
  margin-bottom: 5px;
}

.homepage-bottom-banners a.btn.secondary {
  padding: 8px 35px 6px;
  margin-top: 8px;
  border: none;
}
.banner-caption {
  position: absolute;
  top: 48%;
  color: #FFF;
  transform: translate(-50%, -50%) !important;
  left: 26%;
  max-width: 500px;;
}
.banner-caption * {
  color: #FFF !important;
}
.banner-caption h2 {
  font-size: 4rem;
  line-height: 1;
}
.banner-caption a {
  font-size: 20px;
  text-decoration: underline;
  color: #d4d4d4 !important;
}
