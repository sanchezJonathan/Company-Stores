<style>
  #halloween-effect {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>

<canvas id="halloween-effect" aria-hidden="true"></canvas>

<script>
  (function() {
    var canvas = document.getElementById('halloween-effect');
    if (!canvas || !canvas.getContext) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      canvas.parentNode.removeChild(canvas);
      return;
    }

    var ctx = canvas.getContext('2d');
    var items = [];
    var bats = [];
    var width, height, frame;
    var sparkleColors = ['255, 140, 0', '155, 89, 182', '255, 193, 7'];

    function isMobile() {
      return window.innerWidth < 768;
    }

    function newItem(startAnywhere) {
      var roll = Math.random();
      var type = roll < 0.3 ? 'pumpkin' : roll < 0.5 ? 'candy' : 'sparkle';
      return {
        type: type,
        x: Math.random() * width,
        y: startAnywhere ? Math.random() * height : -20,
        size: type === 'sparkle' ? Math.random() * 2 + 1 : Math.random() * 6 + 8,
        speed: Math.random() * 0.7 + 0.4,
        drift: Math.random() * 0.6 - 0.3,
        sway: Math.random() * Math.PI * 2,
        angle: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 0.03,
        color: sparkleColors[Math.floor(Math.random() * sparkleColors.length)],
        opacity: Math.random() * 0.4 + 0.6
      };
    }

    function newBat(startAnywhere) {
      var leftToRight = Math.random() < 0.5;
      return {
        x: startAnywhere ? Math.random() * width : (leftToRight ? -40 : width + 40),
        baseY: Math.random() * height * 0.6 + 20,
        y: 0,
        dir: leftToRight ? 1 : -1,
        speed: Math.random() * 1.2 + 0.8,
        size: Math.random() * 0.6 + 0.9,
        flap: Math.random() * Math.PI * 2,
        bob: Math.random() * Math.PI * 2,
        wait: startAnywhere ? 0 : Math.random() * 400
      };
    }

    function drawPumpkin(s) {
      ctx.fillStyle = '#f57c00';
      ctx.strokeStyle = '#c75b00';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.ellipse(-s * 0.35, 0, s * 0.45, s * 0.8, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.ellipse(s * 0.35, 0, s * 0.45, s * 0.8, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.ellipse(0, 0, s * 0.5, s * 0.85, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = '#4e6b2c';
      ctx.fillRect(-s * 0.08, -s * 1.1, s * 0.16, s * 0.35);
    }

    function drawCandyCorn(s) {
      ctx.beginPath();
      ctx.moveTo(0, -s);
      ctx.lineTo(s * 0.6, s * 0.7);
      ctx.quadraticCurveTo(0, s * 0.95, -s * 0.6, s * 0.7);
      ctx.closePath();
      ctx.save();
      ctx.clip();
      ctx.fillStyle = '#ffd54f';
      ctx.fillRect(-s, s * 0.25, s * 2, s);
      ctx.fillStyle = '#ff8f00';
      ctx.fillRect(-s, -s * 0.35, s * 2, s * 0.6);
      ctx.fillStyle = '#fffaf0';
      ctx.fillRect(-s, -s, s * 2, s * 0.65);
      ctx.restore();
    }

    function drawSparkle(item) {
      var twinkle = 0.5 + Math.sin(item.sway * 3) * 0.5;
      ctx.beginPath();
      ctx.arc(0, 0, item.size, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + item.color + ', ' + (item.opacity * (0.4 + twinkle * 0.6)) + ')';
      ctx.fill();
    }

    function drawWing(f) {
      ctx.beginPath();
      ctx.moveTo(2, -1);
      ctx.quadraticCurveTo(8, -12 * f, 18, -6 * f);
      ctx.quadraticCurveTo(14, -1, 12, 3);
      ctx.quadraticCurveTo(9, 0, 7, 4);
      ctx.quadraticCurveTo(4, 1, 2, 3);
      ctx.closePath();
      ctx.fill();
    }

    function drawBat(bat) {
      var f = Math.sin(bat.flap);
      ctx.save();
      ctx.translate(bat.x, bat.y);
      ctx.scale(bat.size * bat.dir, bat.size);
      ctx.fillStyle = document.documentElement.classList.contains('dark-mode') ? 'rgba(200, 180, 230, 0.85)' : 'rgba(30, 16, 40, 0.85)';
      drawWing(f);
      ctx.scale(-1, 1);
      drawWing(f);
      ctx.beginPath();
      ctx.ellipse(0, 0, 3, 4.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(-2.5, -3);
      ctx.lineTo(-1.5, -7);
      ctx.lineTo(-0.5, -3.5);
      ctx.moveTo(2.5, -3);
      ctx.lineTo(1.5, -7);
      ctx.lineTo(0.5, -3.5);
      ctx.fill();
      ctx.restore();
    }

    function resize() {
      var ratio = window.devicePixelRatio || 1;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      var itemTarget = isMobile() ? 20 : 45;
      while (items.length < itemTarget) items.push(newItem(true));
      items.length = itemTarget;

      var batTarget = isMobile() ? 2 : 4;
      while (bats.length < batTarget) bats.push(newBat(true));
      bats.length = batTarget;
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      var ratio = window.devicePixelRatio || 1;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        item.sway += 0.01;
        item.y += item.speed;
        item.x += item.drift + Math.sin(item.sway) * 0.3;
        item.angle += item.spin;

        if (item.y > height + 20) items[i] = item = newItem(false);
        if (item.x > width + 20) item.x = -20;
        if (item.x < -20) item.x = width + 20;

        ctx.save();
        ctx.translate(item.x, item.y);
        ctx.rotate(item.type === 'sparkle' ? 0 : Math.sin(item.angle) * 0.6);
        ctx.globalAlpha = item.type === 'sparkle' ? 1 : item.opacity;
        if (item.type === 'pumpkin') drawPumpkin(item.size);
        else if (item.type === 'candy') drawCandyCorn(item.size);
        else drawSparkle(item);
        ctx.restore();
      }

      for (var j = 0; j < bats.length; j++) {
        var bat = bats[j];
        if (bat.wait > 0) {
          bat.wait--;
          continue;
        }
        bat.flap += 0.35;
        bat.bob += 0.03;
        bat.x += bat.speed * bat.dir;
        bat.y = bat.baseY + Math.sin(bat.bob) * 25;

        if (bat.x > width + 50 || bat.x < -50) {
          bats[j] = newBat(false);
          continue;
        }
        drawBat(bat);
      }

      frame = window.requestAnimationFrame(draw);
    }

    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        window.cancelAnimationFrame(frame);
      } else {
        frame = window.requestAnimationFrame(draw);
      }
    });
    window.addEventListener('resize', resize);

    resize();
    frame = window.requestAnimationFrame(draw);
  })();
</script>
