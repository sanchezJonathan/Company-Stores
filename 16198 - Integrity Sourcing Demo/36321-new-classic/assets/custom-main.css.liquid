/*-------------------*/
/* GENERAL */
/*-------------------*/

/*-------------------*/
/* TOP NAV */
/*-------------------*/
.top-navbar-notification-container {
  font-size: 15px;
  padding: 8px 16px 7px;
}
/*-------------------*/
/* HEADER */
/*-------------------*/
.header-container button:focus {
  box-shadow: none;
}
.header-icons > a svg, .header-icons button svg {
  stroke: none;
  width: 20px;
  height: 20px;
}
/*-------------------*/
/* CATEGORY NAV */
/*-------------------*/
.category-container .categories > li > ul.dropdown-menu {
  max-height: 400px;
  overflow-y: auto;
}
/*-------------------*/
/* CONTENT */
/*-------------------*/

/*-------------------*/
/* PRODUCT THUMBS */
/*-------------------*/
.product-thumbnail .thumbnail-description-container a h5 {
  font-size: 16px;
}
/*-------------------*/
/* PRODUCT */
/*-------------------*/

/*-------------------*/
/* CART/CHECKOUT */
/*-------------------*/
/* CDC searchable select (Chosen 0.9 sets a fixed px width, so force fluid + match .form-select) */
.website_order_custom_data_collections_custom_data_value .chzn-container {
  width: 100% !important;
  font-size: 1rem;
}
.website_order_custom_data_collections_custom_data_value .chzn-container .chzn-drop {
  width: 100% !important;
  top: 100% !important;
  box-sizing: border-box;
}
.website_order_custom_data_collections_custom_data_value .chzn-single {
  height: calc(1.5em + .75rem + 2px);
  line-height: 1.5;
  padding: .375rem 2rem .375rem .75rem;
  color: #212529;
  /* Bootstrap 5.1 .form-select chevron */
  background: #fff url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") no-repeat right .75rem center / 16px 12px;
  border: 1px solid #ced4da;
  border-radius: .25rem;
  box-shadow: none;
}
.website_order_custom_data_collections_custom_data_value .chzn-container-active .chzn-single {
  border-color: #86b7fe;
  box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .25);
}
.website_order_custom_data_collections_custom_data_value .chzn-single div {
  display: none;
}
.website_order_custom_data_collections_custom_data_value .chzn-search input {
  width: 100% !important;
  box-sizing: border-box;
  font-family: inherit;
  padding-right: 2rem;
  /* Outline magnifier styled like the .form-select chevron */
  background: #fff url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cg fill='none' stroke='%23343a40' stroke-linecap='round' stroke-width='1.75'%3e%3ccircle cx='6.75' cy='6.75' r='4.75'/%3e%3cpath d='M10.25 10.25L14 14'/%3e%3c/g%3e%3c/svg%3e") no-repeat right .6rem center / 14px 14px;
}
.website_order_custom_data_collections_custom_data_value.is-invalid .chzn-single {
  border-color: #dc3545;
}

