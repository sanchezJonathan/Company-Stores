/*-------------------*/
/* GENERAL */
/*-------------------*/
#page-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #fff;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
}

.page-loading-spinner {
    width: 30px;
    height: 30px;
    border: 3px solid #ddd;
    border-top-color: #000;
    border-radius: 50%;
    animation: page-loading-spin 0.7s linear infinite;
}

@keyframes page-loading-spin {
    to {
        transform: rotate(360deg);
    }
}
/*-------------------*/
/* TOP NAV */
/*-------------------*/
.top-navbar-notification-container {
  background-color: #44D62C;
  color: #000;
}
/*-------------------*/
/* HEADER */
/*-------------------*/

.header-container.border-bottom {
  background-color: #000;
  border-color: #1d5015 !important;
}
.header-container li > a, .header-container li > a:hover, .header-container li > a:focus, .header-container li > a:active {
  color: #d1d1d1;
}
.header-icons > a svg, .header-icons button svg {
  fill: #d1d1d1;
}

/*-------------------*/
/* CATEGORY NAV */
/*-------------------*/
.category-container {
  background-color: #000;
}
.category-container .categories > li > a {
  color: #d1d1d1;
}
/*-------------------*/
/* CONTENT */
/*-------------------*/
ol.breadcrumb li a {
  color: #44D62C;
}
ol.breadcrumb li a:hover {
  color: #000000;
}
.breadcrumb-item.active {
  color: #000000;
}
/*-------------------*/
/* PRODUCT THUMBS */
/*-------------------*/
.product-thumbnail .thumbnail-description-container a h5 {
  color: #000;
}
.product-thumbnail .thumbnail-description-container a h5:hover, .product-thumbnail .thumbnail-description-container a h5:focus {
  color: #44D62C;
}
