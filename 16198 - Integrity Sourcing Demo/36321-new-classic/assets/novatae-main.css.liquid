/* FOOTER */
/*-------------------*/
.footer-container {
  background-color: #000;
}
.footer-container * {
  fill: #d1d1d1;
  color: #d1d1d1 !important;
}
.copyright-section {
  border-top: 1px solid #1d5015;
}
