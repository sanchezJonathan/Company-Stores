/*-------------------*/
/* PRODUCT */
/*-------------------*/
.product-overview * {
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: 12pt !important;
  line-height: normal !important;
  color: #000 !important;
  background: #ffffff !important;
}
.product-overview img {
  display: none !important;
}

/*-------------------*/
/* CATEGORY FLYOUT */
/*-------------------*/
@media screen and (min-width: 992px) {
  .header-links .dropdown-submenu {
    position: relative;
  }
  .header-links .dropdown-submenu > .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-links .dropdown-submenu > .dropdown-item::after {
    content: "\203A";
    margin-left: 1rem;
  }
  .header-links .dropdown-submenu > .dropdown-menu {
    top: calc(-0.3rem - 3px);
    left: 100%;
    margin-top: 0 !important;
    /* 400px tops, or less when the window is shorter */
    max-height: min(400px, var(--flyout-room, 400px));
    overflow-y: auto;
  }
  .header-links .dropdown-submenu.open > .dropdown-menu {
    display: block;
  }
  .header-links .dropdown-submenu.flyout-left > .dropdown-menu {
    left: auto;
    right: 100%;
  }
}
/* hover only on real mouse devices, touch uses the tap toggle above */
@media screen and (min-width: 992px) and (hover: hover) {
  .header-links .dropdown-submenu:hover > .dropdown-menu,
  .header-links .dropdown-submenu:focus-within > .dropdown-menu {
    display: block;
  }
}

