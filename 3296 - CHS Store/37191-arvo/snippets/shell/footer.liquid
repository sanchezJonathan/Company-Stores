{%- comment -%}
  shell/footer — 4 layouts (columns, columns_contact, brand_row, minimal).
  Settings: Store Design → Footer (docs/guidelines/13 §3, §4.5). One markup; CSS
  grid places the columns per data-layout (styles/components/_footer.scss).
{%- endcomment -%}
{%- assign f_layout = settings.footer_layout | default: 'columns' -%}
{%- assign f_style = settings.footer_style | default: 'inverse' -%}
{%- assign scheme = settings.brand_color_scheme | default: 'light' -%}
{%- assign on_dark = false -%}
{%- if f_style == 'brand' -%}{%- assign on_dark = true -%}
{%- elsif f_style == 'inverse' and scheme == 'light' -%}{%- assign on_dark = true -%}
{%- elsif f_style == 'light' and scheme == 'dark' -%}{%- assign on_dark = true -%}
{%- endif -%}

{%- capture contact -%}
  {%- if settings.footer_contact_company and site.company_name != blank -%}<li>{{ site.company_name }}</li>{%- endif -%}
  {%- if settings.footer_contact_address and site.address.full_address_line != blank -%}<li>{% render 'icons/icon_location' %}<span>{{ site.address.full_address_line }}</span></li>{%- endif -%}
  {%- if settings.footer_contact_email and site.primary_email != blank -%}<li>{% render 'icons/icon_email' %}<a href="mailto:{{ site.primary_email }}">{{ site.primary_email }}</a></li>{%- endif -%}
  {%- if settings.footer_contact_phone and site.primary_phone != blank -%}<li>{% render 'icons/icon_phone' %}<a href="tel:{{ site.primary_phone | remove: ' ' }}">{{ site.primary_phone }}</a></li>{%- endif -%}
{%- endcapture -%}

{%- capture social -%}
  {%- for i in (1..6) -%}
    {%- assign s_url = 'footer_social_' | append: i | append: '_url' -%}
    {%- assign s_net = 'footer_social_' | append: i | append: '_network' -%}
    {%- if settings[s_url] != blank -%}
      {%- assign net = settings[s_net] -%}
      <li><a href="{{ settings[s_url] | escape }}" target="_blank" rel="noopener" aria-label="{{ net | replace: '_social', '' | capitalize }}">
        {%- case net -%}
          {%- when 'facebook' -%}{% render 'icons/icon_facebook' %}
          {%- when 'instagram' -%}{% render 'icons/icon_instagram' %}
          {%- when 'linkedin' -%}{% render 'icons/icon_linkedin' %}
          {%- when 'youtube' -%}{% render 'icons/icon_youtube' %}
          {%- when 'tiktok' -%}{% render 'icons/icon_tiktok' %}
          {%- else -%}{% render 'icons/icon_x_social' %}
        {%- endcase -%}
      </a></li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<footer class="cs-footer" data-layout="{{ f_layout }}" data-style="{{ f_style }}"
  data-bottom="{{ settings.footer_bottom_style | default: 'same' }}" data-social="{{ settings.footer_social_shape | default: 'circle' }}"
  {%- if f_style == 'custom' %} style="--cs-footer-bg: {{ settings.footer_bg_color }}; --cs-footer-fg: {{ settings.footer_text_color }}; --cs-footer-link: {{ settings.footer_link_color }};"{% endif %}>
  <div class="cs-container cs-footer__main">
    <div class="cs-footer__about">
      {%- if settings.footer_show_logo -%}{% render 'shell/logo', light: on_dark, class: 'cs-footer__logo' %}{%- endif -%}
      {%- if settings.footer_about != blank -%}<p>{{ settings.footer_about | escape | newline_to_br }}</p>{%- endif -%}
      {%- if f_layout != 'columns_contact' and f_layout != 'minimal' and contact != blank -%}<ul class="cs-footer__contact">{{ contact }}</ul>{%- endif -%}
      {%- if social != blank -%}<ul class="cs-footer__social">{{ social }}</ul>{%- endif -%}
    </div>

    {%- for n in (1..3) -%}
      {%- if f_layout == 'minimal' and n > 1 -%}{%- break -%}{%- endif -%}
      {%- if f_layout == 'columns_contact' and n == 3 -%}{%- break -%}{%- endif -%}
      {%- assign g = 'footer_g' | append: n -%}
      {%- assign g_source = g | append: '_source' -%}
      {%- assign g_heading = g | append: '_heading' -%}
      {%- assign g_tab = g | append: '_new_tab' -%}
      {%- assign src = settings[g_source] | default: 'custom' -%}
      {%- capture links -%}
        {%- if src == 'pages' -%}
          {%- for page in pages limit: 8 -%}
            {%- unless page.parent_id or page.is_home_page? -%}
              <li><a href="{{ page.url }}"{% if page.target != blank %} target="{{ page.target }}"{% endif %}>{{ page.title }}</a></li>
            {%- endunless -%}
          {%- endfor -%}
        {%- elsif src == 'custom' -%}
          {%- for i in (1..5) -%}
            {%- assign l_label = g | append: '_link_' | append: i | append: '_label' -%}
            {%- assign l_url = g | append: '_link_' | append: i | append: '_url' -%}
            {%- if settings[l_label] != blank and settings[l_url] != blank -%}
              <li><a href="{{ settings[l_url] | escape }}"{% if settings[g_tab] %} target="_blank" rel="noopener"{% endif %}>{{ settings[l_label] | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if links != blank -%}
        <nav class="cs-footer__group" aria-label="{{ settings[g_heading] | default: 'Footer links' | escape }}">
          {%- if settings[g_heading] != blank -%}<h2 class="cs-footer__heading">{{ settings[g_heading] | escape }}</h2>{%- endif -%}
          <ul class="cs-footer__links">{{ links }}</ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- if f_layout == 'columns_contact' and contact != blank -%}
      <div class="cs-footer__group">
        {%- if settings.footer_contact_heading != blank -%}<h2 class="cs-footer__heading">{{ settings.footer_contact_heading | escape }}</h2>{%- endif -%}
        <ul class="cs-footer__contact">{{ contact }}</ul>
      </div>
    {%- endif -%}
  </div>

  <div class="cs-footer__bottom">
    <div class="cs-container cs-footer__bottom-inner">
      <p>{% if settings.footer_copyright != blank %}{{ settings.footer_copyright | escape }}{% else %}&copy; {{ 'now' | date: '%Y' }} {{ site.name }}{% endif %}</p>
      {%- if settings.footer_powered_by -%}<p>Powered by BrightStores</p>{%- endif -%}
      {%- if settings.footer_back_to_top -%}<a class="cs-footer__top" href="#">Back to top {% render 'icons/icon_chevron_up', class: 'cs-icon--sm' %}</a>{%- endif -%}
    </div>
  </div>
</footer>
