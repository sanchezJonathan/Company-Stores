{% form 'apply_gift_certificate' %}
  <div class="input string optional mb-3">
    <label class="mb-2">Activate Gift Certificate</label>
    <input class="form-control" name="gift_certificate" placeholder="Enter Certificate ID" size="50" type="text"/>
  </div>

  <div class="form-buttons">
    <input class="btn secondary custom_btn indent_btn custom-button small" name="commit" type="submit" value="Apply">
  </div>
{% endform %}
