<h2>Shipping Address</h2>
{% include 'shipping_addresses_drop_down', form: form %}
{% include 'shipping_address_fields', form: form %}

{% comment %}
{% if current_user %}
  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" value="true" id="checkout[save_to_address]" name="checkout[save_to_address]" {% if form.save_to_address %}checked{% endif %}>
    <label class="form-check-label" for="checkout[save_to_address]">
      Save my Address Information
    </label>
  </div>
{% endif %}
{% endcomment %}

<input type="submit" value="Continue" class="btn secondary mt-3"/>

<script>
  $('#website_order_shipping_address_attributes_company').prop('readonly', true);
  $('#website_order_shipping_address_attributes_first_address').prop('readonly', true);
  $('#website_order_shipping_address_attributes_second_address').prop('readonly', true);
  $('#website_order_shipping_address_attributes_city').prop('readonly', true);
  $('#website_order_shipping_address_attributes_zip').prop('readonly', true);
  setTimeout(function() {
    $('#website_order_shipping_address_attributes_country').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').css('background', '#e9ecef');
    $('#website_order_shipping_address_attributes_state').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').css('background', '#e9ecef');
  }, 800);
  $('.address-dropdown').on('change', function() {
    setTimeout(function() {
      $('#website_order_shipping_address_attributes_state').siblings('.select2').css('pointer-events','none').find('.select2-selection--single').css('background', '#e9ecef');
    }, 800);
  });
</script>