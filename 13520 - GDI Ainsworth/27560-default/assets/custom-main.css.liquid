/*-------------------*/
/* FLIPBOX */
/*-------------------*/

.country-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 80px;
    flex-wrap: wrap;
}

.country-section {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.flag-container {
    margin-bottom: 20px;
}

.flag-container img {
    max-width: auto;
    height: 100px;
    display: block;
}

.static-grid-container {
    display: grid !important;
    grid-template-columns: repeat(3, 230px) !important;
    gap: 15px !important;
    justify-content: center !important;
    justify-items: center !important;
}

.static-block {
    width: 230px !important;
    height: 220px !important;
    background-color: #00467f !important;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 1.2em !important;
    font-weight: bold !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    border-radius: 5px !important;
    transition: background-color 0.3s ease;
    padding: 10px;
    box-sizing: border-box;
}

.static-block:hover {
    background-color: #003865 !important;
    cursor: pointer;
}

.grid-background {
    background-image: url('{{ "carousel-item-01.jpg" | asset_url }}');
    background-size: cover;
    background-position: center;
    padding: 60px 0;
}

.grid-footer-btn {
    /* Layout */
    display: flex !important;
    width: 720px !important;   /* Matches (3 * 230px) + (2 * 15px) */
    height: 80px !important;    /* Adjust height to your preference */
    margin: 0 auto !important;  /* Centers the button */
    
    /* Alignment */
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;

    /* Styling */
    background-color: #00467f !important;
    color: white !important;
    text-decoration: none !important;
    font-size: 1.2em !important;
    font-weight: bold !important;
    border-radius: 5px !important;
    
    /* Animation */
    transition: background-color 0.3s ease !important;
}

.grid-footer-btn:hover {
    background-color: #003865 !important;
    color: white !important;
    cursor: pointer !important;
}

/* Mobile layout */
@media (max-width: 740px) { 
    .static-grid-container {
        grid-template-columns: 1fr !important;
        max-width: 90% !important; 
        gap: 10px !important;
        margin: 10px auto !important; 
    }

    .static-block {
        width: 100% !important; 
        height: 150px !important; 
        padding: 0 !important;
        font-size: 1.1em !important; 
    }

    .grid-footer-btn {
        width: 90% !important;      
        height: 60px !important;     
        font-size: 1.1em !important; 
        margin: 10px auto !important; 
    }
}

