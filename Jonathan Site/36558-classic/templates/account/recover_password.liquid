<div class="container-fluid border px-lg-0 my-5">
  <div class="row px-2 mx-0">
    <div class="col-lg-6 col-md-12 mx-auto py-5 px-4">
      <h1>Forgot Password</h1>
  
      <div class="notice mb-3">
        Everyone forgets. Just enter the email address you used to create your account and
        we'll reset your password and send a link to your email address so you can create a
        new password. Simple! Please
        {% if shop.primary_email != blank %}
          <a href="mailto:{{ shop.primary_email }}">Contact Us</a>
        {% else %}
          Contact Us
        {% endif %}
        with any other account issues.
      </div>

      <div class="sign-in-form input_frgt mb-3">
        {% form 'recover_password' %}
          <div class="mb-3">
            <label class="mb-2" for="website_user_email">Email address</label>
            <input class="form-control" id="website_user_email" name="website_user[email]" placeholder="" size="50" type="text">
          </div>

          <input type="submit" class="btn secondary frgt_btn" value="Reset password"/>
        {% endform %}
      </div>
      <a href="{{ login_url }}" class="">Back to Login Page</a>
    </div>
  </div>
</div>
