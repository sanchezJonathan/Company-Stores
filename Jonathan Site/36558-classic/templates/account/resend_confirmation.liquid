<div class="container-fluid border px-lg-0 my-5">
  <div class="row px-2 mx-0">
    <div class="col-lg-6 col-md-12 mx-auto py-5 px-4">
      <h1>Resend Account Confirmation</h1>

      <div class="sign-in-form input_frgt mb-3">
        {% form 'resend_confirmation' %}
          <div class="mb-3">
            <label class="" for="website_user_email">Email address <span class="required-label">(required)</span></label>
            <input class="form-control mt-2" id="website_user_email" name="website_user[email]" placeholder="" size="50" type="text">
          </div>

          <input type="submit" class="btn secondary custom_btn custom-button btn-green" value="Submit"/>
        {% endform %}
      </div>

      <a href="{{ login_url }}" class="">Back to Login Page</a>
    </div>
  </div>
</div>
