<div class="container-fluid px-lg-0 mt-5">
  <div class="row mx-0">
    <div class="col-12 px-0">
      <ul class="nav nav-tabs">
        {% if shop.show_login? %}
        <li class="nav-item">
          <a class="nav-link font-weight-bold border" href="{{ login_url }}"><h5 class="mb-0"><b>Log In</b></h5></a>
        </li>
        {% endif %}
        <li class="nav-item">
          <a class="nav-link active font-weight-bold" href="{{ signup_url }}"><h5 class="mb-0"><b>Register</b></h5></a>
        </li>
      </ul>
    </div>
  </div>
  <div class="row px-2 border border-top-0 mx-0">
    <div class="col-lg-6 col-md-12 mx-auto py-5 px-4">
      <div class="sign-in">
        <!--<div class="content-block title">
          <h1 class="text-center">Register</h1>
        </div>-->
        <div class="content-block">
          {% if shop.show_registration? %}
            <div class="sign-in-form regform">
              {% form 'registration' %}
                {% include "registration_form" %}
                <button type="submit" class="btn secondary" name="commit">Create account</button>
              {% endform %}
            </div>
          {% else %}
            <p class="text-center">Registration is disabled</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

