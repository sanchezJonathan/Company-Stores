<h4 class="mt-5">Billing Address</h4>
<div class="mb-3">
  <label class="form-label" for="website_order_billing_address_attributes_first_address">Address<span class="required-label">(required)</span></label>
  <input type="text"
    value="{{ form.first_address.value }}"
    name="checkout[address][first_address]"
    id="website_order_billing_address_attributes_first_address"
    class="form-control first-address needs-validation {% if form.first_address.errors != empty %}is-invalid{% endif %}"
    placeholder="Address line 1"
    maxlength="{{ form.first_address_maxlength }}"/>

  {% for error in form.first_address.errors %}
    <div class="invalid-feedback">{{ error }}</div>
  {% endfor %}

  <input type="text"
    value="{{ form.second_address.value }}"
    name="checkout[address][second_address]"
    id="website_order_billing_address_attributes_second_address"
    class="form-control mt-2 second-address {% if form.second_address.errors != empty %}is-invalid{% endif %}"
    placeholder="Address line 2"
    maxlength="{{ form.second_address_maxlength }}"/>

  {% for error in form.second_address.errors %}
    <div class="invalid-feedback">{{ error }}</div>
  {% endfor %}
</div>

<div class="mb-3">
  <label class="form-label" for="website_order_billing_address_attributes_city">City<span class="required-label">(required)</span></label>
  <input type="text"
    value="{{ form.city.value }}"
    name="checkout[address][city]"
    id="website_order_billing_address_attributes_city"
    class="form-control city needs-validation {% if form.city.errors != empty %}is-invalid{% endif %}"
    placeholder="City"
    maxlength="{{ form.city_maxlength }}"/>

  {% for error in form.city.errors %}
    <div class="invalid-feedback">{{ error }}</div>
  {% endfor %}
</div>

<div class="mb-3">
  <label class="form-label" for="website_order_billing_address_attributes_country">Country<span class="required-label">(required)</span></label>
  <div>
    <select name="checkout[address][country]" class="form-select country needs-validation" id="website_order_billing_address_attributes_country">
      {% country_select_options selected: form.country.value %}
    </select>  
  </div>
  
  {% for error in form.country.errors %}
  	<div class="invalid-feedback d-block">{{ error }}</div>
  {% endfor %}
</div>

<div class="mb-3 state-container">
  <label class="form-label" for="website_order_billing_address_attributes_state">State<span class="required-label">(required)</span></label>
  <div>
    <select name="checkout[address][state]" class="form-select state needs-validation" id="website_order_billing_address_attributes_state">
      {% state_select_options country: form.country.value, selected: form.state.value %}
    </select>
  </div>

  {% for error in form.state.errors %}
  	<div class="invalid-feedback d-block">{{ error }}</div>
  {% endfor %}
</div>


<div class="mb-3">
  <label class="form-label" for="website_order_billing_address_attributes_zip">Zip code<span class="required-label">(required)</span></label>
  <input type="text"
    value="{{ form.zip.value }}"
    name="checkout[address][zip]"
    id="website_order_billing_address_attributes_zip"
    class="form-control needs-validation zip {% if form.zip.errors != empty %}is-invalid{% endif %}"
    placeholder="zip code"
    maxlength="{{ form.zip_maxlength }}"/>

  {% for error in form.zip.errors %}
    <div class="invalid-feedback">{{ error }}</div>
  {% endfor %}
</div>

 <input 
    type="hidden"
    value="{{ form.nickname.value }}"
    class="nickname"
    name="checkout[address][nickname]"
    id="website_order_billing_address_nickname"
/>