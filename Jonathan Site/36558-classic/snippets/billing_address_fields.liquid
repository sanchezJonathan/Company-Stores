<h4 class="mt-5">Personal Information</h4>
<div class="mb-3">
  <label class="form-label" for="website_order_billing_contact_attributes_first_name">First name<span class="required-label">(required)</span></label>
  <input type="text"
    value="{{ form.first_name.value }}"
    name="checkout[address][first_name]"
    id="website_order_billing_contact_attributes_first_name"
    class="form-control first-name needs-validation {% if form.first_name.errors != empty %}is-invalid{% endif %}"
    placeholder="First name"
    maxlength="{{ form.first_name_maxlength }}"/>

  {% for error in form.first_name.errors %}
  	<div class="invalid-feedback">{{ error }}</div>
  {% endfor %}
</div>

<div class="mb-3">
  <label class="form-label" for="website_order_billing_contact_attributes_last_name">Last name<span class="required-label">(required)</span></label>
