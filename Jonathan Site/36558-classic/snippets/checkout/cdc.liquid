<h2>{{ shop.custom_data_collections_name }}</h2>
{% for custom_collection in custom_data_collections %}
  <h4>{% include 'modifier' title: custom_collection.title, amount: custom_collection.amount %}</h4>

  {% for input in custom_collection.inputs %}
    {% assign errors = form.custom_data_collections[custom_collection.id][input.id].errors %}

    <div class='mb-3'>
      {% capture input_id %}website_order_custom_data_collections_attributes_{{ custom_collection.id }}_custom_data_attributes_attributes_{{ forloop.index0 }}_value{% endcapture %}
      <label for="{{ input_id }}" class="form-label">{{ input.label }}{% if input.required? %}<span class="required-label">(required)</span>{% endif %}</label>
      <div class="input text optional {% if errors.any? %}is-invalid{% endif %} website_order_custom_data_collections_custom_data_value">
        {% if input.text_input? %}
          <input type="text" value="{{ form.custom_data_collections[custom_collection.id][input.id].value }}"
                 name="checkout[custom_data_collections][{{ custom_collection.id }}][{{ input.id }}]"
                 id="{{ input_id }}" class="form-control {% if errors.any? %}is-invalid{% endif %}"/>
        {% elsif input.text_area? %}
          <textarea name="checkout[custom_data_collections][{{ custom_collection.id }}][{{ input.id }}]"
                    id="{{ input_id }}" class="form-control {% if errors.any? %}is-invalid{% endif %}">{{ form.custom_data_collections[custom_collection.id][input.id].value }}</textarea>
        {% elsif input.select? or input.multi_select? %}
          <select class="form-select {% if errors.any? %}is-invalid{% endif %}" id="{{ input_id }}" {% if input.multi_select? %}multiple="multiple"{% endif %} name="checkout[custom_data_collections][{{ custom_collection.id }}][{{ input.id }}]{% if input.multi_select? %}[]{% endif %}">
            {% unless input.required? %}
              <option value=''>Please Select</option>{% endunless %}
            {% for option in input.options %}
              <option
              {% if form.custom_data_collections[custom_collection.id][input.id].value == option.value %}
                selected="selected"
                  {% endif %}>
                {{ option.value }}
              </option>
            {% endfor %}
          </select>
        {% endif %}
      </div>
      {% if errors.any? %}
        <div class="invalid-feedback">{{ errors | default_errors }}</div>
      {% endif %}
    </div>
  {% endfor %}
{% endfor %}
<input type="submit" value="Continue" class="btn secondary"/>
