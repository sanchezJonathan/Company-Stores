{% assign first_img_link = "" %}

<div class="product-thumbnail" data-product-url="{{ product | product_url }}">
  <div class="thumbnail-img-container">
    <a href="{{ product | product_url }}">
      {% if product.images != empty %}
        {% for image in product.images %}
          {% if first_img_link == blank %}
            {% assign first_img_link = image.small_url %}
          {% endif %}
      
          {% if product.thumbnail_image.image_url != blank and image.image_url == product.thumbnail_image.image_url %}
             <img class="img-fluid" src="{{ image.small_url }}" alt="Image of {{ product.name }}" title="Image of {{ product.name }}" />
          {% endif %}
      	{% endfor %}
      
      	{% if product.thumbnail_image.image_url == blank and product.primary_image.small_url != blank %}
           <img class="img-fluid" src="{{ product.primary_image.small_url }}" alt="Image of {{ product.name }}" title="Image of {{ product.name }}" />
        {% endif %}
      
        {% if product.thumbnail_image.image_url == blank and product.primary_image.small_url == blank %}
           <img class="img-fluid" src="{{ first_img_link }}" alt="Image of {{ product.name }}" title="Image of {{ product.name }}" />
        {% endif %}
      {% else %}
        <img class="img-fluid" src="{{ 'no-image.jpg' | asset_url }}" alt="Displaying no image available for {{ product.name }}" title="Displaying no image available for {{ product.name }}" />
      {% endif %}
    </a>
    {% if product.new_product? and settings.show_new_products == true and settings.new_product_position == "thumbnail" %}
      <div class="new-item-label">{{ settings.new_product_label }}</div>
    {% endif %}
  </div>
  <div class="thumbnail-description-container pt-3">
    <a href="{{ product | product_url }}">
      {% assign truncated_text_length = settings.truncated_length %}
      <h5 class="card-title fw-bold lh-base">{% if product.new_product? and settings.show_new_products == true and settings.new_product_position == "productname" %}<span class="new-item-productname">{{ settings.new_product_label }}</span>{% endif %}{% if settings.truncate_product_thumbnail_text %}{{ product.name | truncate: truncated_text_length }}{% else %}{{ product.name }}{% endif %}</h5>
      {% if settings.show_vendors %}<h6 class="card-subtitle mb-2 text-muted">{{ product.vendor_names }}</h6>{% endif %}
      {% if product.discount > 0 %}
        <p class="card-text">
          <del class="text-muted">{{ product.retail_price | points_or_currency }}</del>
          <span class="font-weight-bold">{{ product.total_price | points_or_currency }}</span>
        </p>
        <div class="discount-container font-weight-bold">-{{ product.discount | round }}%</div>
      {% else %}
        <p class="card-text">{{ product.total_price | points_or_currency }}</p>
      {% endif %}
    </a>
  </div>
</div>
