<tr class="cart-item bundle-cart-item border-bottom">
  <td class="d-flex ps-0">
    <div class="item-image pe-3">
      <img alt="{{ bundle.name }} image" title="{{ bundle.name }} image" class="cart-product-img" src="{% if bundle.image %}{{ bundle.image.small_url }}{% else %}{{ 'no-image.jpg' | asset_url }}{% endif %}" />
    </div>
    <div class="item-description w-100">
      <p class="fw-bold mb-2">
        {{ bundle.name }}
        <span class="text-muted fw-normal">({{ bundle.products_count }} products)</span>
      </p>

      <!-- BUNDLE INCLUDES PANEL -->
      <div class="bundle-includes bg-light border rounded p-3 mb-2">
        <p class="cart-inline-title-short text-uppercase text-muted mb-2">Bundle includes</p>
        {% for line_item in bundle.line_items %}
          <div class="bundle-includes-item d-flex align-items-start {% unless forloop.last %}mb-2{% endunless %}">
            <div class="bundle-includes-image pe-2">
              <img class="bundle-includes-img" alt="{{ line_item.name }} image" src="{% if line_item.image %}{{ line_item.image.small_url }}{% else %}{{ 'no-image.jpg' | asset_url }}{% endif %}" />
            </div>
            <div>
              {% if line_item.vendors != empty and settings.show_vendors %}
                <p class="mb-0 small text-muted">by {{ line_item.vendor_names }}</p>
              {% endif %}
              {% capture bundle_item_name %}{{ line_item.quantity | divided_by: bundle.quantity }}&times; {{ line_item.name }}{% endcapture %}
              {% render 'line_item_info', line_item: line_item, name: bundle_item_name, settings: settings %}
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- BUNDLE ACTIONS -->
      <div class="bundle-actions">
        <a href="{{ bundle.replace_url }}" class="text-decoration-underline me-3">Edit Bundle</a>
        <a href="#" class="text-danger text-decoration-underline remove-bundle-item"
           onclick="$(this).closest('tr').find('input[name^=\'bundle_line_items\']').val(0); $(this).parents('form').submit(); return false;">
          Remove Bundle
        </a>
      </div>

      <!-- MOBILE PRICE / QUANTITY / TOTAL -->
      <div class="d-lg-none mt-3">
        <p class="mb-0">
          <span class="cart-inline-title-short">Bundle price:</span>
          {{ bundle.unit_price | points_or_currency }}
        </p>

        <div class="d-sm-none mt-3 small-quantity-container">
          <div class="d-inline-block mb-2 d-sm-block cart-quantity-container">
            <input
             type="number"
             class="cart-quantity-input form-control cart-quantity-decoy decoy-bundle-{{ bundle.id }}"
             value="{{ bundle.quantity }}"
             id="bundle-{{ bundle.id }}"
             min="0"
            >
          </div>
          <button type="submit" class="btn align-top btn-dark" disabled>Update</button>
          <span class="ms-2">{{ bundle.quantity | pluralize: 'Bundle', 'Bundles' }}</span>
        </div>

        <p class="mt-3 fw-bold">
          <span class="cart-inline-title">Total:</span>
          {{ bundle.total_price | points_or_currency }}
        </p>
      </div>

      {% if shop.store_enabled? and wishlist_item == true %}
        <a
         href="{{ bundle | move_bundle_item_to_cart_url }}"
         class="d-inline-block d-lg-none btn secondary mt-2"
         data-method="post"
        >
          Add to Cart
        </a>
      {% endif %}
    </div>
  </td>
  <td class="d-none d-lg-table-cell pricing-column">
    <p class="mb-0">
      <span class="cart-inline-title">Bundle price:</span>
      {{ bundle.unit_price | points_or_currency }}
    </p>
  </td>
  <td class="cart-quantity-container d-none d-sm-table-cell">
    <div class="d-inline-block float-end float-lg-none">
      <div class="mb-3 cart-quantity-container">
        <input
         type="number"
         class="cart-quantity-input form-control qty-input-bundle-{{ bundle.id }}"
         name="bundle_line_items[{{ bundle.id }}][quantity]"
         value="{{ bundle.quantity }}"
         id="bundle-qty-{{ bundle.id }}"
         min="0"
        >
        <span class="d-inline-block mt-1">{{ bundle.quantity | pluralize: 'Bundle', 'Bundles' }}</span>
      </div>

      <button type="submit" class="btn w-100 btn-dark" disabled>Update</button>
    </div>
  </td>
  <td class="fw-bold text-end pe-0 d-none d-lg-table-cell">
    {{ bundle.total_price | points_or_currency }}

    {% if shop.store_enabled? and wishlist_item == true %}
      <div>
        <a
         href="{{ bundle | move_bundle_item_to_cart_url }}"
         class="btn mt-2 d-inline-block secondary"
         data-method="post"
        >
          Cart >
        </a>
      </div>
    {% endif %}
  </td>
</tr>

<script>
  (function() {
    var bundleId = {{ bundle.id }};
    var $decoy = $(".decoy-bundle-" + bundleId);
    var $named = $("#bundle-qty-" + bundleId);

    function syncBundleQty(value) {
      $named.val(value);
    }

    $decoy.on("change keyup input", function() {
      syncBundleQty($(this).val());
    });

    $named.on("change keyup input", function() {
      $decoy.val($(this).val());
    });
  })();
</script>
