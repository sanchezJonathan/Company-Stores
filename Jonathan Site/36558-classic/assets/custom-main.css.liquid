@media screen and (max-width: 660px){
  .carousel-caption {
    padding: 1rem 1.25rem;
    max-width: 94%;
  }
  .carousel-caption-header {
    font-size: 1.5rem;
  }
  .carousel-control-prev-icon,
  .carousel-control-next-icon {
    opacity: 1;
    padding: 16px;
  }
  .product-thumbnail:hover {
    transform: none;
  }
}

