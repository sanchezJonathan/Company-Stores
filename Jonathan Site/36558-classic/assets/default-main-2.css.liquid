/* BUNDLE CONFIGURATOR */
/*-------------------*/
@media (min-width: 768px) {
  .bundle-page .product-left-section .product-info.position-sticky {
    top: 0;
  }
}

.bundle-member-list {
  gap: 16px;
}

.bundle-member-row {
  border-color: #DEE2E6 !important;
  transition: border-color 150ms ease;
}

.bundle-member-row:hover,
.bundle-member-row.bundle-member--expanded {
  border-color: #858585 !important;
}

.bundle-member-toggle {
  height: 80px;
  cursor: pointer;
  transition: border-color 150ms ease;
}

.bundle-member-toggle__inner {
  width: 100%;
  min-width: 0;
  height: 100%;
  padding: 0 16px 0 8px;
  gap: 12px;
}

.bundle-member-content {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

.bundle-member-state-icon {
  width: 16px;
  height: 16px;
}

.bundle-member-thumb {
  width: 48px;
  height: 48px;
  border-radius: 4px;
  overflow: hidden;
  background-color: {{ settings.product_image_background }};
}

.bundle-member-thumb__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
}

.bundle-member-name {
  font-size: 14pt;
  line-height: 1.2;
}

.bundle-member-details {
  font-size: 12pt;
  color: #858585;
}

.bundle-member-option-label {
  font-weight: 600;
}

.bundle-member-price {
  margin-left: 16px;
  font-size: 14pt;
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.bundle-member-qty-note {
  color: #858585;
}

.bundle-member-expanded .product-header .product-overview {
  margin-top: 10px;
}

.bundle-member-expanded__body {
  padding: 16px 16px 0;
