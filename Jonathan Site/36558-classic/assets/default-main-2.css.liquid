.navbar-container > .wrapper, .footer-container .wrapper {
  padding: 0 15px;
} */
#content h1 {
  margin-bottom: 25px;
}
body span.required-label {
  background-color: transparent;
  color: {{ settings.sitewide_text_color }};
  opacity: .6;
  font-size: .85rem;
  display: inline;
  line-height: 1.1rem;
  padding: 4px 6px;
  text-transform: lowercase;
}
{% if settings.sitewide_text_color contains "fff" or settings.sitewide_text_color contains "FFF" or settings.sitewide_text_color == "white" or settings.sitewide_text_color == "WHITE" %}
  .text-danger, .text-success, .stock, .invalid-feedback {
    color: #fff !important;
  }
{% endif %}
.invalid-feedback::first-letter {
  text-transform: uppercase;
}
/*.btn.primary {
  margin-top: 1rem;
  padding: 0.375rem 1.2rem 0.5rem;
}*/
.btn.primary:hover, .btn.primary:focus {
  background: {{ settings.sitewide_primary_hover_color }};
  color: {{ settings.sitewide_primary_hover_text_color }};
  border-color: {{ settings.sitewide_primary_hover_border_color }};
  -webkit-transition: all .3s ease-in-out;
  -moz-transition:    all .3s ease-in-out;
  -o-transition:      all .3s ease-in-out;
  -ms-transition:     all .3s ease-in-out;
  transition:         all .3s ease-in-out;
  text-decoration: none;
}
.btn.secondary:hover, .btn.secondary:focus {
  background: {{ settings.sitewide_secondary_hover_color }};
  color: {{ settings.sitewide_secondary_hover_text_color }};
  border-color: {{ settings.sitewide_secondary_hover_border_color }};
  -webkit-transition: all .3s ease-in-out;
  -moz-transition:    all .3s ease-in-out;
  -o-transition:      all .3s ease-in-out;
  -ms-transition:     all .3s ease-in-out;
  transition:         all .3s ease-in-out;
  text-decoration: none;
}
.form-check-input:checked {
  background-color: {{ settings.sitewide_secondary_bg_color }};
  border-color: #fff;
}
.modal-dialog {
  /*max-width: 500px;*/
  margin: 2rem auto;
}
{% assign products_per_row = settings.product_thumbnails_per_row %}

.action-link.btn.secondary {
  margin-top: 0;
}
.btn.secondary.outline {
  border: 1px solid {{ settings.sitewide_secondary_bg_color }};
  background: #FFFFFF;
  color: {{ settings.sitewide_secondary_bg_color }};
}
#accordion {
  background-color: transparent;
  color: {{ settings.sitewide_text_color }};
  border-color: #DEE2E6;
}
.accordion-body {
  padding: 2rem;
}
.accordion-button, .accordion-item {
  color: {{ settings.sitewide_text_color }};
  background-color: {{ settings.sitewide_bg_color }};
  border-color: #DEE2E6;
}
.accordion-button:not(.collapsed, .footer-container .accordion-button) {
  color: {{ settings.sitewide_text_color }};
  background-color: transparent;
  border-bottom: 1px solid #DEE2E6;
  box-shadow: none;
}
.accordion-item label {
  color: {{ settings.sitewide_text_color }};
}
.modal-header, .modal-body, .modal-footer {
  padding: 1.8rem;
}
.search-btn {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}
.nav-tabs .nav-link.active,
.nav-tabs .nav-item.show .nav-link,
.nav-tabs .nav-link.active:hover,
.nav-tabs .nav-item.show .nav-link:hover {
  background: transparent;
  border-bottom-color: {{ settings.sitewide_bg_color }};
  text-decoration: none;
}
ul.nav-tabs li a:not(.active), ul.nav-tabs li a:not(.active):hover {
  background: transparent;
  opacity: .6;
  text-decoration: none;
}
.content-container .category-page-content-section a, .content-container .category-page-content-section a:hover,
ol.breadcrumb li a, ol.breadcrumb li a:hover {
  text-decoration: none;
}
.table {
  color: {{ settings.sitewide_text_color }};
}
.modal-content {
  background-color: {{ settings.sitewide_bg_color }};
}
.text-muted {
  color: {{ settings.sitewide_text_color }} !important;
  opacity: .6;
}
.password-div {
  position: relative;
}
i.fa.fa-solid.fa-eye, i.fa.fa-solid.fa-eye-slash {
  position: absolute;
  bottom: 10px;
  right: 10px;
}
.input_frgt i.fa.fa-solid.fa-eye, .input_frgt i.fa.fa-solid.fa-eye-slash {
  bottom: unset;
  top: 38px;
}
.regform i.fa.fa-solid.fa-eye, .regform i.fa.fa-solid.fa-eye-slash {
  bottom: unset;
  top: 35px;
}
.accountsettings i.fa.fa-solid.fa-eye, .accountsettings i.fa.fa-solid.fa-eye-slash {
  bottom: unset;
  top: 45px;
}

