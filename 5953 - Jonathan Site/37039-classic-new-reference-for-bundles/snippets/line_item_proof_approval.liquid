{% unless field_prefix %}
  {% assign field_prefix = 'product' %}
{% endunless %}

{% capture proof_approval_dom_id %}proof-approval-{{ field_prefix | replace: '[', '-' | replace: ']', '' }}{% endcapture %}

{% if shop.virtual_samples_enabled? and product.virtual_samples_enabled? and product.require_proof_approval? %}
  <div class="prod_option_block proof-approval-wrapper">
    <h4>Proof Approval</h4>

    <div class="proof-approval form-item clrfix">
      <label for="{{ proof_approval_dom_id }}">
        <input
          class="form-check-input proof-approval-checkbox"
          type="checkbox"
          id="{{ proof_approval_dom_id }}"
          name="{{ field_prefix }}[proof_approval]"
          value="1"
          {% if form.proof_approval %}
            checked
          {% endif %}
        >
        I approve this proof
      </label>
      <div
        class="proof-approval-message text-danger small d-none"
        hidden
        aria-live="polite"
      >
        Please approve this proof before continuing.
      </div>
    </div>
  </div>
{% endif %}
